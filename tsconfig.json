{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "packages/*/src",
    "packages/bendo/shared/*.ts",
    "packages/bendo/gen",
    "packages/vite-plugin-bendo/fixtures/app/vite.config.ts",
    "tests",
    "scripts/*.ts"
  ]
}
