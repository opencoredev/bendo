def measure(label: String, input: List<&2, U32>) -> IO(Unit):
  do IO<Unit>:
    start : Nat <- IO.now()
    checksum : U32 = repeat(20000n, input, 0)
    stop : Nat <- IO.now()
    IO.print(label ++ " iterations=20000 ms=" ++ Nat.show(Nat.sub(stop, start)) ++ " checksum=" ++ U32.show(checksum))

def main() -> IO(Unit):
  do IO<Unit>:
    measure("utf8", utf8())
    measure("binary", binary())
