def segments_walk(+c: Bool, +a: List<&2, P.Segment>, +b: List<&2, P.Segment>, +xs: List<&2, String>, +taken: List<&2, String>) ->
    {S.segments_at(c, List.append(&2, P.Segment, a, b), xs, taken) == S.walk(a, xs, c, b, taken) : Maybe<&2, P.Params>}:
  match c:
    case True{}:
      walk_sensitive(a, b, xs, taken)
    case False{}:
      walk_folded(a, b, xs, taken)

def with_at(+c: Bool, +segs: List<&2, P.Segment>, +xs: List<&2, String>) -> {S.segments_with(c, segs, xs) == S.segments_at(c, segs, xs, Nil{}) : Maybe<&2, P.Params>}:
  match c:
    case True{}:
      {==}
    case False{}:
      {==}

# The assembled root rule stays with the assembled pattern.
def finish(+a: List<&2, P.Segment>, +mb: List<&2, P.Segment>, +xs: List<&2, String>, +c: Bool) ->
    {S.matched(c, List.append(&2, P.Segment, a, mb), xs) == S.rooted(c, a, xs, mb) : Maybe<&2, P.Params>}:
  +e = Equal.trans(Maybe<&2, P.Params>, S.segments_with(c, List.append(&2, P.Segment, a, mb), xs), S.segments_at(c, List.append(&2, P.Segment, a, mb), xs, Nil{}), S.walk(a, xs, c, mb, Nil{}), with_at(c, List.append(&2, P.Segment, a, mb), xs), segments_walk(c, a, mb, xs, Nil{}))
  %e : {S.matched(c, List.append(&2, P.Segment, a, mb), xs) == MS.or_else(_, u => S.root_hit(xs, List.append(&2, P.Segment, a, mb))) : Maybe<&2, P.Params>}
  {==}

def decomp_at(+m: Maybe<&2, String>, +a: List<&2, P.Segment>, +b: List<&2, P.Segment>, +opts: M.Options, kept: {S.ends_solid(a, False{}) == True{} : Bool}) ->
    {S.options_at(m, P.Pattern{List.append(&2, P.Segment, a, b)}, opts) == S.walk_at(m, a, b, opts) : Maybe<&2, P.Params>}:
  match m:
    case None{}:
      {==}
    case Some{+t}:
      match opts:
        case M.Options{+s, +c}:
          %Equal.sym(List<&2, P.Segment>, S.normal_pattern(s, List.append(&2, P.Segment, a, b)), List.append(&2, P.Segment, a, S.member_segments(s, b)), norm_append(s, a, b, kept)) : {S.matched(c, _, S.normal_path(s, String.split(t, '/'))) == S.rooted(c, a, S.normal_path(s, String.split(t, '/')), S.member_segments(s, b)) : Maybe<&2, P.Params>}
          finish(a, S.member_segments(s, b), S.normal_path(s, String.split(t, '/')), c)

def decompose_pieces(pp: Maybe<&2, List<&2, P.Segment>>, mp: Maybe<&2, List<&2, P.Segment>>, +p: P.Pattern, +path: String, +opts: M.Options,
    e: {S.joined(pp, mp) == Some{p} : Maybe<&2, P.Pattern>}, adm: {S.kept_and(pp, S.compiles(S.joined(pp, mp))) == True{} : Bool}) ->
    {S.match_options(p, path, opts) == S.walk_pieces(pp, mp, path, opts) : Maybe<&2, P.Params>}:
  match pp mp:
    case None{} y:
      Core.absurd({S.match_options(p, path, opts) == S.walk_pieces(None{}, y, path, opts) : Maybe<&2, P.Params>}, none_some(p, e))
    case Some{a} None{}:
      Core.absurd({S.match_options(p, path, opts) == S.walk_pieces(Some{a}, None{}, path, opts) : Maybe<&2, P.Params>}, none_some(p, e))
    case Some{+a} Some{+b}:
      +same = accept_some(CS.rules(List.append(&2, P.Segment, a, b), Nil{}) && CS.spans(List.append(&2, P.Segment, a, b)), List.append(&2, P.Segment, a, b), p, e)
      +kept = Core.and_left(S.ends_solid(a, False{}), S.compiles(CS.checked(Some{List.append(&2, P.Segment, a, b)})), adm)
      %Equal.sym(P.Pattern, p, P.Pattern{List.append(&2, P.Segment, a, b)}, same) : {S.match_options(_, path, opts) == S.walk_pieces(Some{a}, Some{b}, path, opts) : Maybe<&2, P.Params>}
      decomp_at(S.slash_tail(path), a, b, opts, kept)

# The decomposition, for every placement of the prefix.
def decompose_at(at: S.Place, +member: String, +p: P.Pattern, +path: String, +opts: M.Options,
    e: {S.assembled_at(at, member) == Some{p} : Maybe<&2, P.Pattern>}, adm: {S.admissible_at(at, member) == True{} : Bool}) ->
    {S.match_options(p, path, opts) == S.mounted_at(at, member, path, opts) : Maybe<&2, P.Params>}:
  match at:
    case S.AtRoot{}:
      %Equal.sym(Maybe<&2, P.Pattern>, CS.compile(member), Some{p}, e) : {S.match_options(p, path, opts) == S.member_alone(_, path, opts) : Maybe<&2, P.Params>}
      {==}
    case S.Under{+raws}:
      decompose_pieces(S.prefix_pieces(raws), S.member_pieces(S.member_text(member)), p, path, opts, e, adm)
    case S.Unplaced{}:
      Core.absurd({S.match_options(p, path, opts) == S.mounted_at(S.Unplaced{}, member, path, opts) : Maybe<&2, P.Params>}, Core.false_true(adm))
