      %walk_sensitive(t, b, u, Nil{}) : {MS.or_else(MS.matches(P.Span{n} <> List.append(&2, P.Segment, t, b), u, h <> taken), x => MS.span_here(n, h <> taken, MS.matches(List.append(&2, P.Segment, t, b), u, Nil{}))) == MS.or_else(MS.matches(P.Span{n} <> List.append(&2, P.Segment, t, b), u, h <> taken), x => MS.span_here(n, h <> taken, _)) : Maybe<&2, P.Params>}
      {==}

def walk_folded_wildcard(+n: String, after: List<&2, P.Segment>, +ys: List<&2, String>, +taken: List<&2, String>) ->
    {S.folded(P.Wildcard{n} <> after, ys, taken) == S.wildcard_end(n, after, ys) : Maybe<&2, P.Params>}:
  match after:
    case Nil{}:
      {==}
    case x <> y:
      {==}

def walk_folded_prefix(+p: String, after: List<&2, P.Segment>, ys: List<&2, String>, +taken: List<&2, String>) ->
    {S.folded(P.PrefixWildcard{p} <> after, ys, taken) == S.prefix_end(False{}, p, after, ys) : Maybe<&2, P.Params>}:
  match after ys:
    case Nil{} h <> u:
      {==}
    case Nil{} Nil{}:
      {==}
    case x <> y zs:
      {==}

def walk_folded(+a: List<&2, P.Segment>, +b: List<&2, P.Segment>, +xs: List<&2, String>, +taken: List<&2, String>) ->
    {S.folded(List.append(&2, P.Segment, a, b), xs, taken) == S.walk(a, xs, False{}, b, taken) : Maybe<&2, P.Params>}:
  match a xs:
    case Nil{} ys:
      {==}
    case P.Static{raw} <> t Nil{}:
      {==}
    case P.Static{+raw} <> +t +h <> +u:
      Equal.cong(Maybe<&2, P.Params>, Maybe<&2, P.Params>, r => MS.same_text(S.folded_text(raw, h), r), S.folded(List.append(&2, P.Segment, t, b), u, Nil{}), S.walk(t, u, False{}, b, Nil{}), walk_folded(t, b, u, Nil{}))
    case P.Capture{n, k, True{}} <> +t Nil{}:
      walk_folded(t, b, Nil{}, Nil{})
