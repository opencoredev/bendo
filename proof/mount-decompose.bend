      Equal.cong(Maybe<&2, P.Params>, Maybe<&2, P.Params>, r => MS.same_text(String.eq(raw, h), r), MS.matches(List.append(&2, P.Segment, t, b), u, Nil{}), S.walk(t, u, True{}, b, Nil{}), walk_sensitive(t, b, u, Nil{}))
    case P.Capture{n, k, True{}} <> +t Nil{}:
      walk_sensitive(t, b, Nil{}, Nil{})
    case P.Capture{n, k, False{}} <> t Nil{}:
      {==}
    case P.Capture{+n, +k, True{}} <> +t +h <> +u:
      Equal.cong(Maybe<&2, P.Params>, Maybe<&2, P.Params>, r => MS.capture(n, k, E.decode(h), r), MS.matches(List.append(&2, P.Segment, t, b), u, Nil{}), S.walk(t, u, True{}, b, Nil{}), walk_sensitive(t, b, u, Nil{}))
    case P.Capture{+n, +k, False{}} <> +t +h <> +u:
      Equal.cong(Maybe<&2, P.Params>, Maybe<&2, P.Params>, r => MS.capture(n, k, E.decode(h), r), MS.matches(List.append(&2, P.Segment, t, b), u, Nil{}), S.walk(t, u, True{}, b, Nil{}), walk_sensitive(t, b, u, Nil{}))
    case P.Wildcard{+n} <> +t ys:
      walk_sensitive_wildcard(n, List.append(&2, P.Segment, t, b), ys, taken)
    case P.InteriorWildcard{} <> +t Nil{}:
      walk_sensitive(t, b, Nil{}, Nil{})
    case P.InteriorWildcard{} <> +t +h <> +u:
      %walk_sensitive(t, b, h <> u, Nil{}) : {MS.or_else(MS.matches(List.append(&2, P.Segment, t, b), h <> u, Nil{}), x => MS.matches(P.InteriorWildcard{} <> List.append(&2, P.Segment, t, b), u, Nil{})) == MS.or_else(_, x => S.walk(P.InteriorWildcard{} <> t, u, True{}, b, Nil{})) : Maybe<&2, P.Params>}
