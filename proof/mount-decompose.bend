      %walk_folded(t, b, u, Nil{}) : {MS.or_else(S.folded(P.Span{n} <> List.append(&2, P.Segment, t, b), u, h <> taken), x => MS.span_here(n, h <> taken, S.folded(List.append(&2, P.Segment, t, b), u, Nil{}))) == MS.or_else(S.folded(P.Span{n} <> List.append(&2, P.Segment, t, b), u, h <> taken), x => MS.span_here(n, h <> taken, _)) : Maybe<&2, P.Params>}
