# BND-86: under an admissible prefix, matching the assembled pattern with any
# options is the prefix walk followed by the member, as the specification
# states it. Every lemma here relates specification functions only.
import Base
import ../src/router/pattern.bend as P
import ../src/router/encoding.bend as E
import ../src/router/constraint.bend as C
import ../src/router/methods.bend as M
import ../src/router/proofs.bend as Core
import ../src/router/match-spec-proofs.bend as MSP
import ./router-compile-spec.bend as CS
import ./router-match-spec.bend as MS
import ./mount-spec.bend as S

def get_pattern(m: Maybe<&2, P.Pattern>, d: P.Pattern) -> P.Pattern:
  match m:
    case Some{p}:
      p
    case None{}:
      d

def is_none_type(m: Maybe<&2, P.Pattern>) -> Type:
  match m:
    case None{}:
      Unit
    case Some{p}:
      Empty

def none_some(+p: P.Pattern, e: {None{} == Some{p} : Maybe<&2, P.Pattern>}) -> Empty:
  %e : is_none_type(_)
  Unit{}

def accept_some(ok: Bool, +segs: List<&2, P.Segment>, +p: P.Pattern, e: {CS.accept(ok, segs) == Some{p} : Maybe<&2, P.Pattern>}) ->
    {p == P.Pattern{segs} : P.Pattern}:
  match ok:
    case False{}:
      Core.absurd({p == P.Pattern{segs} : P.Pattern}, none_some(p, e))
    case True{}:
      Equal.sym(P.Pattern, P.Pattern{segs}, p, Equal.cong(Maybe<&2, P.Pattern>, P.Pattern, m => get_pattern(m, P.Pattern{segs}), Some{P.Pattern{segs}}, Some{p}, e))

# ---- Lenient mode keeps a prefix whose last segment is solid ----

def keep_solid(+rest: List<&2, P.Segment>, +s: P.Segment, ok: {S.solid(s) == True{} : Bool}) ->
    {S.keep_segment(rest, s) == s <> rest : List<&2, P.Segment>}:
  match rest:
    case r <> t:
      {==}
    case Nil{}:
      match s:
        case P.Static{SNil{}}:
          Core.absurd({S.keep_segment(Nil{}, P.Static{SNil{}}) == [P.Static{SNil{}}] : List<&2, P.Segment>}, Core.false_true(ok))
        case P.Static{SCon{x, y}}:
          {==}
        case P.Capture{n, k, o}:
          {==}
        case P.Wildcard{n}:
          {==}
        case P.InteriorWildcard{}:
          {==}
        case P.PrefixWildcard{x}:
          {==}
        case P.Span{n}:
          {==}

def drop_step(+s: P.Segment, +t: List<&2, P.Segment>, +b: List<&2, P.Segment>,
    ih: {S.drop_static(List.append(&2, P.Segment, t, b)) == List.append(&2, P.Segment, t, S.drop_static(b)) : List<&2, P.Segment>},
    e: {S.ends_solid(t, S.solid(s)) == True{} : Bool}) ->
    {S.keep_segment(S.drop_static(List.append(&2, P.Segment, t, b)), s) == s <> List.append(&2, P.Segment, t, S.drop_static(b)) : List<&2, P.Segment>}:
  match t:
    case Nil{}:
      keep_solid(S.drop_static(b), s, e)
    case +th <> +tt:
      %Equal.sym(List<&2, P.Segment>, S.drop_static(List.append(&2, P.Segment, th <> tt, b)), List.append(&2, P.Segment, th <> tt, S.drop_static(b)), ih) : {S.keep_segment(_, s) == s <> List.append(&2, P.Segment, th <> tt, S.drop_static(b)) : List<&2, P.Segment>}
      {==}

# Lenient mode drops only the member's terminal empty statics.
def drop_solid(+a: List<&2, P.Segment>, +b: List<&2, P.Segment>, ok: Bool, e: {S.ends_solid(a, ok) == True{} : Bool}) ->
    {S.drop_static(List.append(&2, P.Segment, a, b)) == List.append(&2, P.Segment, a, S.drop_static(b)) : List<&2, P.Segment>}:
  match a:
    case Nil{}:
      {==}
    case +s <> +t:
      +e2 = e
      drop_step(s, t, b, drop_solid(t, b, S.solid(s), e2), e2)

# The prefix keeps every segment, so no root segment comes back.
def norm_append(+s: Bool, +a: List<&2, P.Segment>, +b: List<&2, P.Segment>, kept: {S.ends_solid(a, False{}) == True{} : Bool}) ->
    {S.normal_pattern(s, List.append(&2, P.Segment, a, b)) == List.append(&2, P.Segment, a, S.member_segments(s, b)) : List<&2, P.Segment>}:
  match s:
    case True{}:
      {==}
    case False{}:
      match a:
        case Nil{}:
          Core.absurd({S.normal_pattern(False{}, List.append(&2, P.Segment, Nil{}, b)) == List.append(&2, P.Segment, Nil{}, S.member_segments(False{}, b)) : List<&2, P.Segment>}, Core.false_true(kept))
        case +h <> +t:
          %Equal.sym(List<&2, P.Segment>, S.drop_static(List.append(&2, P.Segment, h <> t, b)), List.append(&2, P.Segment, h <> t, S.drop_static(b)), drop_solid(h <> t, b, False{}, kept)) : {S.root_segment(_) == List.append(&2, P.Segment, h <> t, S.drop_static(b)) : List<&2, P.Segment>}
          {==}

# ---- Matching the prefix then the member is the prefix walk ----

