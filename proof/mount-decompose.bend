      {==}
    case P.Capture{+n, +k, True{}} <> +t +h <> +u:
      Equal.cong(Maybe<&2, P.Params>, Maybe<&2, P.Params>, r => MS.capture(n, k, E.decode(h), r), S.folded(List.append(&2, P.Segment, t, b), u, Nil{}), S.walk(t, u, False{}, b, Nil{}), walk_folded(t, b, u, Nil{}))
    case P.Capture{+n, +k, False{}} <> +t +h <> +u:
      Equal.cong(Maybe<&2, P.Params>, Maybe<&2, P.Params>, r => MS.capture(n, k, E.decode(h), r), S.folded(List.append(&2, P.Segment, t, b), u, Nil{}), S.walk(t, u, False{}, b, Nil{}), walk_folded(t, b, u, Nil{}))
    case P.Wildcard{+n} <> +t ys:
      walk_folded_wildcard(n, List.append(&2, P.Segment, t, b), ys, taken)
    case P.InteriorWildcard{} <> +t Nil{}:
      walk_folded(t, b, Nil{}, Nil{})
    case P.InteriorWildcard{} <> +t +h <> +u:
      %walk_folded(t, b, h <> u, Nil{}) : {MS.or_else(S.folded(List.append(&2, P.Segment, t, b), h <> u, Nil{}), x => S.folded(P.InteriorWildcard{} <> List.append(&2, P.Segment, t, b), u, Nil{})) == MS.or_else(_, x => S.walk(P.InteriorWildcard{} <> t, u, False{}, b, Nil{})) : Maybe<&2, P.Params>}
      %walk_folded(P.InteriorWildcard{} <> t, b, u, Nil{}) : {MS.or_else(S.folded(List.append(&2, P.Segment, t, b), h <> u, Nil{}), x => S.folded(P.InteriorWildcard{} <> List.append(&2, P.Segment, t, b), u, Nil{})) == MS.or_else(S.folded(List.append(&2, P.Segment, t, b), h <> u, Nil{}), x => _) : Maybe<&2, P.Params>}
