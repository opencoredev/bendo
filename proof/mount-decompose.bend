def walk_sensitive_wildcard(+n: String, after: List<&2, P.Segment>, +ys: List<&2, String>, +taken: List<&2, String>) ->
    {MS.matches(P.Wildcard{n} <> after, ys, taken) == S.wildcard_end(n, after, ys) : Maybe<&2, P.Params>}:
  match after:
    case Nil{}:
      {==}
    case x <> y:
      {==}

def walk_sensitive_prefix(+p: String, after: List<&2, P.Segment>, ys: List<&2, String>, +taken: List<&2, String>) ->
    {MS.matches(P.PrefixWildcard{p} <> after, ys, taken) == S.prefix_end(True{}, p, after, ys) : Maybe<&2, P.Params>}:
  match after ys:
    case Nil{} h <> u:
      {==}
    case Nil{} Nil{}:
      {==}
    case x <> y zs:
      {==}

def walk_sensitive(+a: List<&2, P.Segment>, +b: List<&2, P.Segment>, +xs: List<&2, String>, +taken: List<&2, String>) ->
    {MS.matches(List.append(&2, P.Segment, a, b), xs, taken) == S.walk(a, xs, True{}, b, taken) : Maybe<&2, P.Params>}:
