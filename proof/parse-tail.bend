# The name read so far, reversed, prefixed onto a spec answer.
def onto(rev: String, f: P.Field) -> P.Field:
  match f:
    case P.MissingColon{}: P.MissingColon{}
    case P.Field{n, v}: P.Field{String.reverse.go(rev, n), v}

def onto_push(+rev: String, c: U32, f: P.Field) -> {onto(SCon{Chr{c}, rev}, f) == onto(rev, P.field_push(c, f)) : P.Field}:
  match f:
    case P.MissingColon{}:
      {==}
    case P.Field{n, v}:
      {==}

def onto_empty(f: P.Field) -> {onto("", f) == f : P.Field}:
  match f:
    case P.MissingColon{}:
      {==}
    case P.Field{n, v}:
      {==}

def field_plain(+c: U32, +t: List<&2, U32>, +rev: String, ih: {P.field_go(t, SCon{Chr{c}, rev}) == onto(SCon{Chr{c}, rev}, P.field_spec(t)) : P.Field}) -> {P.field_go(t, SCon{Chr{c}, rev}) == onto(rev, P.field_push(c, P.field_spec(t))) : P.Field}:
