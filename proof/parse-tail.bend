    case U32{WCon{False{}, WCon{True{}, WCon{True{}, bits}}}} <> t:
      field_plain(U32{WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}, t, rev, field_go_equiv(t, SCon{Chr{U32{WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}, rev}))
    case U32{WCon{True{}, bits}} <> t:
      field_plain(U32{WCon{True{}, bits}}, t, rev, field_go_equiv(t, SCon{Chr{U32{WCon{True{}, bits}}}, rev}))

def field_equiv(+xs: List<&2, U32>) -> {P.field(xs) == P.field_spec(xs) : P.Field}:
  Equal.trans(P.Field, P.field(xs), onto("", P.field_spec(xs)), P.field_spec(xs), field_go_equiv(xs, ""), onto_empty(P.field_spec(xs)))

# ---- lookup ----

# The spec's right fold over hs, onto the answer acc for the headers after it.
def lookup_onto(hs: List<&2, R.Header>, +name: String, acc: List<&2, List<&2, U32>>) -> List<&2, List<&2, U32>>:
  match hs:
    case Nil{}:
      acc
    case R.Header{n, v} <> t:
      R.lookup_step(v, lookup_onto(t, name, acc), String.eq(n, name))

def lookup_onto_nil(+hs: List<&2, R.Header>, +name: String) -> {lookup_onto(hs, name, []) == R.lookup_folded_spec(hs, name) : List<&2, List<&2, U32>>}:
  match hs:
    case Nil{}:
      {==}
    case R.Header{n, v} <> t:
      Equal.cong(List<&2, List<&2, U32>>, List<&2, List<&2, U32>>, x => R.lookup_step(v, x, String.eq(n, name)), lookup_onto(t, name, []), R.lookup_folded_spec(t, name), lookup_onto_nil(t, name))

def lookup_reverse(+hs: List<&2, R.Header>, +r: List<&2, R.Header>, +name: String, +acc: List<&2, List<&2, U32>>) -> {R.lookup_folded_go(List.reverse.go(&2, R.Header, hs, r), name, acc) == R.lookup_folded_go(r, name, lookup_onto(hs, name, acc)) : List<&2, List<&2, U32>>}:
  match hs:
    case Nil{}:
      {==}
    case R.Header{n, v} <> t:
      lookup_reverse(t, R.Header{n, v} <> r, name, acc)


def lookup_equiv(+hs: List<&2, R.Header>, +name: String) -> {R.lookup_folded(hs, name) == R.lookup_folded_spec(hs, name) : List<&2, List<&2, U32>>}:
  Equal.trans(List<&2, List<&2, U32>>, R.lookup_folded(hs, name), lookup_onto(hs, name, []), R.lookup_folded_spec(hs, name), lookup_reverse(hs, [], name, []), lookup_onto_nil(hs, name))
