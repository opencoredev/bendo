# Inductions relate the two-pass implementation to the independent fused map.
def declarations(-Tag: Data, +xs: List<&2, T.Entry<Tag>>) -> {A.declared(Tag, xs) == S.declarations(Tag, xs) : List<&2, T.HookSpec<Tag>>}:
  match xs:
    case Nil{}: {==}
    case T.Hook{stage, tag} <> tail:
      Equal.cong(List<&2, T.HookSpec<Tag>>, List<&2, T.HookSpec<Tag>>, rest => T.HookSpec{stage, tag} <> rest, A.declared(Tag, tail), S.declarations(Tag, tail), declarations(Tag, tail))
    case T.Route{r} <> tail: declarations(Tag, tail)
    case T.ScopedRoute{r, hooks} <> tail: declarations(Tag, tail)
    case T.Use{source, tag} <> tail: declarations(Tag, tail)

def located(-Tag: Data, +hooks: List<&2, T.HookSpec<Tag>>, +scope: T.Scope) -> {A.placements(Tag, hooks, scope) == S.located(Tag, hooks, scope) : List<&2, T.Placement<Tag>>}:
  match hooks:
    case Nil{}: {==}
    case hook <> tail:
      Equal.cong(List<&2, T.Placement<Tag>>, List<&2, T.Placement<Tag>>, rest => T.Placement{scope, hook} <> rest, A.placements(Tag, tail, scope), S.located(Tag, tail, scope), located(Tag, tail, scope))

def trim(+prefix: String, slash: Bool) -> {A.normalized_prefix(prefix, slash) == S.trim_terminal(prefix, slash) : String}:
  match slash:
    case True{}: {==}
    case False{}: {==}

def path(+prefix: String, +source: String) -> {A.prefix_path(prefix, source) == S.path(prefix, source) : String}:
  match prefix:
    case SNil{}: {==}
    case SCon{Chr{U32{bits}}, tail}:
      match bits:
        case WCon{False{}, rest}: Equal.cong(String, String, p => p ++ source, A.normalized_prefix(prefix, String.ends_with(prefix, "/")), S.trim_terminal(prefix, String.ends_with(prefix, "/")), trim(prefix, String.ends_with(prefix, "/")))
        case WCon{True{}, WCon{False{}, rest}}: Equal.cong(String, String, p => p ++ source, A.normalized_prefix(prefix, String.ends_with(prefix, "/")), S.trim_terminal(prefix, String.ends_with(prefix, "/")), trim(prefix, String.ends_with(prefix, "/")))
        case WCon{True{}, WCon{True{}, WCon{False{}, rest}}}: Equal.cong(String, String, p => p ++ source, A.normalized_prefix(prefix, String.ends_with(prefix, "/")), S.trim_terminal(prefix, String.ends_with(prefix, "/")), trim(prefix, String.ends_with(prefix, "/")))
        case WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, rest}}}}: Equal.cong(String, String, p => p ++ source, A.normalized_prefix(prefix, String.ends_with(prefix, "/")), S.trim_terminal(prefix, String.ends_with(prefix, "/")), trim(prefix, String.ends_with(prefix, "/")))
        case WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, rest}}}}}: Equal.cong(String, String, p => p ++ source, A.normalized_prefix(prefix, String.ends_with(prefix, "/")), S.trim_terminal(prefix, String.ends_with(prefix, "/")), trim(prefix, String.ends_with(prefix, "/")))
        case WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, rest}}}}}}: Equal.cong(String, String, p => p ++ source, A.normalized_prefix(prefix, String.ends_with(prefix, "/")), S.trim_terminal(prefix, String.ends_with(prefix, "/")), trim(prefix, String.ends_with(prefix, "/")))
        case WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{True{}, rest}}}}}}}: Equal.cong(String, String, p => p ++ source, A.normalized_prefix(prefix, String.ends_with(prefix, "/")), S.trim_terminal(prefix, String.ends_with(prefix, "/")), trim(prefix, String.ends_with(prefix, "/")))
