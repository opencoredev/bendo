# Transport the independent selection theorem along assembly equality, so the
# public build is related to raw declarations rather than decorated inputs.
def selection(-Tag: Data, +xs: List<&2, T.Entry<Tag>>, +ys: List<&2, T.Entry<Tag>>, +routes: List<&2, M.Registration(Tag)>, +compiled: M.Index<Tag>, +layers: List<&2, T.Middleware<Tag>>, +count: Nat, +route: Maybe<&2, Nat>, +stage: T.Stage, built: {T.build(Tag, xs) == Done{T.Table{routes, compiled, layers, count}} : Result<&2, &2, M.BuildError, T.Table<Tag>>}, equal: {xs == ys : List<&2, T.Entry<Tag>>}) -> {T.scoped_stage_ids(Tag, layers, route, stage) == SelectionSpec.stage_ids(Tag, ys, route, stage) : List<&2, Tag>}:
