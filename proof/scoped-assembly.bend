# Equality in a list context leaves both neighbouring lists literally intact.
def context(-Tag: Data, +before: List<&2, T.Entry<Tag>>, +left: List<&2, T.Entry<Tag>>, +right: List<&2, T.Entry<Tag>>, +after: List<&2, T.Entry<Tag>>, equal: {left == right : List<&2, T.Entry<Tag>>}) -> {List.append(&2, T.Entry<Tag>, before, List.append(&2, T.Entry<Tag>, left, after)) == List.append(&2, T.Entry<Tag>, before, List.append(&2, T.Entry<Tag>, right, after)) : List<&2, T.Entry<Tag>>}:
