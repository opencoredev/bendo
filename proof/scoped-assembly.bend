def registration(-Tag: Data, +prefix: String, +route: M.Registration(Tag)) -> {A.prefixed(Tag, prefix, route) == S.registration(Tag, prefix, route) : M.Registration(Tag)}:
  match route:
    case R.Registration{source, tag}:
      Equal.cong(String, M.Registration(Tag), p => R.Registration{p, tag}, A.prefix_path(prefix, source), S.path(prefix, source), path(prefix, source))

def identity(-Tag: Data, +route: M.Registration(Tag)) -> {S.registration(Tag, "", route) == route : M.Registration(Tag)}:
  match route:
    case R.Registration{source, tag}: {==}

def attached(-Tag: Data, +xs: List<&2, T.Entry<Tag>>, +inherited: List<&2, T.Placement<Tag>>) -> {A.attach(Tag, xs, inherited) == S.assemble(Tag, xs, "", inherited) : List<&2, T.Entry<Tag>>}:
  match xs:
    case Nil{}: {==}
    case T.Route{r} <> tail:
      %Equal.sym(M.Registration(Tag), r, S.registration(Tag, "", r), Equal.sym(M.Registration(Tag), S.registration(Tag, "", r), r, identity(Tag, r))) : {T.ScopedRoute{_, inherited} <> A.attach(Tag, tail, inherited) == S.assemble(Tag, T.Route{r} <> tail, "", inherited) : List<&2, T.Entry<Tag>>}
      Equal.cong(List<&2, T.Entry<Tag>>, List<&2, T.Entry<Tag>>, rest => T.ScopedRoute{S.registration(Tag, "", r), inherited} <> rest, A.attach(Tag, tail, inherited), S.assemble(Tag, tail, "", inherited), attached(Tag, tail, inherited))
    case T.ScopedRoute{r, local} <> tail:
      %Equal.sym(M.Registration(Tag), r, S.registration(Tag, "", r), Equal.sym(M.Registration(Tag), S.registration(Tag, "", r), r, identity(Tag, r))) : {T.ScopedRoute{_, List.append(&2, T.Placement<Tag>, inherited, local)} <> A.attach(Tag, tail, inherited) == S.assemble(Tag, T.ScopedRoute{r, local} <> tail, "", inherited) : List<&2, T.Entry<Tag>>}
      Equal.cong(List<&2, T.Entry<Tag>>, List<&2, T.Entry<Tag>>, rest => T.ScopedRoute{S.registration(Tag, "", r), List.append(&2, T.Placement<Tag>, inherited, local)} <> rest, A.attach(Tag, tail, inherited), S.assemble(Tag, tail, "", inherited), attached(Tag, tail, inherited))
    case T.Hook{stage, tag} <> tail: attached(Tag, tail, inherited)
    case T.Use{source, tag} <> tail:
      Equal.cong(List<&2, T.Entry<Tag>>, List<&2, T.Entry<Tag>>, rest => T.Use{source, tag} <> rest, A.attach(Tag, tail, inherited), S.assemble(Tag, tail, "", inherited), attached(Tag, tail, inherited))

def assembled(-Tag: Data, +xs: List<&2, T.Entry<Tag>>, +prefix: String, +inherited: List<&2, T.Placement<Tag>>) -> {A.attach(Tag, A.prefix_entries(Tag, xs, prefix), inherited) == S.assemble(Tag, xs, prefix, inherited) : List<&2, T.Entry<Tag>>}:
  match xs:
    case Nil{}: {==}
    case T.Route{r} <> tail:
      %Equal.sym(M.Registration(Tag), A.prefixed(Tag, prefix, r), S.registration(Tag, prefix, r), registration(Tag, prefix, r)) : {T.ScopedRoute{_, inherited} <> A.attach(Tag, A.prefix_entries(Tag, tail, prefix), inherited) == S.assemble(Tag, T.Route{r} <> tail, prefix, inherited) : List<&2, T.Entry<Tag>>}
      Equal.cong(List<&2, T.Entry<Tag>>, List<&2, T.Entry<Tag>>, rest => T.ScopedRoute{S.registration(Tag, prefix, r), inherited} <> rest, A.attach(Tag, A.prefix_entries(Tag, tail, prefix), inherited), S.assemble(Tag, tail, prefix, inherited), assembled(Tag, tail, prefix, inherited))
    case T.ScopedRoute{r, local} <> tail:
      %Equal.sym(M.Registration(Tag), A.prefixed(Tag, prefix, r), S.registration(Tag, prefix, r), registration(Tag, prefix, r)) : {T.ScopedRoute{_, List.append(&2, T.Placement<Tag>, inherited, local)} <> A.attach(Tag, A.prefix_entries(Tag, tail, prefix), inherited) == S.assemble(Tag, T.ScopedRoute{r, local} <> tail, prefix, inherited) : List<&2, T.Entry<Tag>>}
      Equal.cong(List<&2, T.Entry<Tag>>, List<&2, T.Entry<Tag>>, rest => T.ScopedRoute{S.registration(Tag, prefix, r), List.append(&2, T.Placement<Tag>, inherited, local)} <> rest, A.attach(Tag, A.prefix_entries(Tag, tail, prefix), inherited), S.assemble(Tag, tail, prefix, inherited), assembled(Tag, tail, prefix, inherited))
    case T.Hook{stage, tag} <> tail: assembled(Tag, tail, prefix, inherited)
    case T.Use{source, tag} <> tail:
      Equal.cong(List<&2, T.Entry<Tag>>, List<&2, T.Entry<Tag>>, rest => T.Use{source, tag} <> rest, A.attach(Tag, A.prefix_entries(Tag, tail, prefix), inherited), S.assemble(Tag, tail, prefix, inherited), assembled(Tag, tail, prefix, inherited))

def guard(-Tag: Data, +options: T.GuardOptions<Tag>, +xs: List<&2, T.Entry<Tag>>) -> {A.guard(Tag, options, xs) == S.guard(Tag, options, xs) : List<&2, T.Entry<Tag>>}:
  match options:
    case T.GuardOptions{explicit, schemas}:
      %Equal.sym(List<&2, T.HookSpec<Tag>>, A.declared(Tag, xs), S.declarations(Tag, xs), declarations(Tag, xs)) : {A.attach(Tag, xs, A.placements(Tag, List.append(&2, T.HookSpec<Tag>, explicit, _), T.GuardScope{})) == S.guard(Tag, T.GuardOptions{explicit, schemas}, xs) : List<&2, T.Entry<Tag>>}
      %Equal.sym(List<&2, T.Placement<Tag>>, A.placements(Tag, List.append(&2, T.HookSpec<Tag>, explicit, S.declarations(Tag, xs)), T.GuardScope{}), S.located(Tag, List.append(&2, T.HookSpec<Tag>, explicit, S.declarations(Tag, xs)), T.GuardScope{}), located(Tag, List.append(&2, T.HookSpec<Tag>, explicit, S.declarations(Tag, xs)), T.GuardScope{})) : {A.attach(Tag, xs, _) == S.guard(Tag, T.GuardOptions{explicit, schemas}, xs) : List<&2, T.Entry<Tag>>}
      attached(Tag, xs, S.located(Tag, List.append(&2, T.HookSpec<Tag>, explicit, S.declarations(Tag, xs)), T.GuardScope{}))

def group(-Tag: Data, +prefix: String, +explicit: List<&2, T.HookSpec<Tag>>, +xs: List<&2, T.Entry<Tag>>) -> {A.group(Tag, prefix, explicit, xs) == S.group(Tag, prefix, explicit, xs) : List<&2, T.Entry<Tag>>}:
