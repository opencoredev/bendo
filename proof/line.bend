      E.absurd({Support.free(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, t} ++ R.query_text(q)) == True{} : Bool} & ({B.split_target(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, t} ++ R.query_text(q)) == (SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, t}, q) : String & Maybe<&2, String>} & {P.target_form(m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, t} ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, t}, q, v, []}, [], False{}} : P.State}), E.false_true(valid))

def asterisk(+v: R.Version) -> {Support.free("*") == True{} : Bool} & ({B.split_target("*") == ("*", None{}) : String & Maybe<&2, String>} & {P.target_form(R.Options{}, "*", R.version_text(v)) == P.Headers{R.Req{R.Options{}, "*", None{}, v, []}, [], False{}} : P.State}):
  match v:
    case R.Http10{}:
      ({==}, ({==}, {==}))
    case R.Http11{}:
      ({==}, ({==}, {==}))

# OPTIONS without a query may use the asterisk-form target.
def options_none(+p: String, +v: R.Version, +ok: {R.options_valid(p, None{}) == True{} : Bool}, same: Bool, eq: {String.eq(p, "*") == same : Bool}) -> {Support.free(p ++ R.query_text(None{})) == True{} : Bool} & ({B.split_target(p ++ R.query_text(None{})) == (p, None{}) : String & Maybe<&2, String>} & {P.target_form(R.Options{}, p ++ R.query_text(None{}), R.version_text(v)) == P.Headers{R.Req{R.Options{}, p, None{}, v, []}, [], False{}} : P.State}):
  match same:
    case True{}:
      pe = Laws.string_eq_sound(p, "*", eq)
      %Equal.sym(String, p, "*", pe) : {Support.free(_ ++ R.query_text(None{})) == True{} : Bool} & ({B.split_target(_ ++ R.query_text(None{})) == (_, None{}) : String & Maybe<&2, String>} & {P.target_form(R.Options{}, _ ++ R.query_text(None{}), R.version_text(v)) == P.Headers{R.Req{R.Options{}, _, None{}, v, []}, [], False{}} : P.State})
      asterisk(v)
    case False{}:
      origin = Equal.trans(Bool, R.origin_valid(p, None{}), String.eq(p, "*") || R.origin_valid(p, None{}), True{}, Equal.sym(Bool, String.eq(p, "*") || R.origin_valid(p, None{}), R.origin_valid(p, None{}), Equal.cong(Bool, Bool, b => b || R.origin_valid(p, None{}), String.eq(p, "*"), False{}, eq)), ok)
      origin_all(R.Options{}, p, None{}, v, origin, ok)

# Every supported target has no spaces and reconstructs without normalization.
def Laws.target_recover(m, p, q, v, ok):
  match m:
    case R.Get{}:
      origin_all(R.Get{}, p, q, v, ok, ok)
    case R.Head{}:
      origin_all(R.Head{}, p, q, v, ok, ok)
    case R.Post{}:
      origin_all(R.Post{}, p, q, v, ok, ok)
    case R.Put{}:
      origin_all(R.Put{}, p, q, v, ok, ok)
    case R.Delete{}:
      origin_all(R.Delete{}, p, q, v, ok, ok)
    case R.Connect{}:
      E.absurd({Support.free(p ++ R.query_text(q)) == True{} : Bool} & ({B.split_target(p ++ R.query_text(q)) == (p, q) : String & Maybe<&2, String>} & {P.target_form(R.Connect{}, p ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{R.Connect{}, p, q, v, []}, [], False{}} : P.State}), E.false_true(ok))
    case R.Options{}:
      match q:
        case None{}:
          options_none(p, v, ok, String.eq(p, "*"), {==})
        case Some{query}:
          origin_all(R.Options{}, p, Some{query}, v, ok, ok)
    case R.Trace{}:
      origin_all(R.Trace{}, p, q, v, ok, ok)
    case R.Patch{}:
      origin_all(R.Patch{}, p, q, v, ok, ok)
    case R.Extension{token}:
      origin_all(R.Extension{token}, p, q, v, ok, ok)

# Supported HTTP version text has no spaces.
def split_version(v: R.Version) -> {String.split(R.version_text(v), ' ') == [R.version_text(v)] : List<&2, String>}:
  match v:
    case R.Http10{}:
      {==}
    case R.Http11{}:
      {==}

def ascii_encode_spec(+s: String) -> {B.ascii_spec(B.encode_spec(s)) == s : String}:
  match s:
    case SNil{}:
      {==}
    case SCon{Chr{c}, t}:
      Equal.cong(String, String, s => SCon{Chr{c}, s}, B.ascii_spec(B.encode_spec(t)), t, ascii_encode_spec(t))

def ascii_encode(+s: String) -> {B.ascii(B.encode(s)) == s : String}:
  Equal.trans(String, B.ascii(B.encode(s)), B.ascii_spec(B.encode_spec(s)), s, Equal.trans(String, B.ascii(B.encode(s)), B.ascii_spec(B.encode(s)), B.ascii_spec(B.encode_spec(s)), BT.ascii_equiv(B.encode(s)), Equal.cong(List<&2, U32>, String, l => B.ascii_spec(l), B.encode(s), B.encode_spec(s), BT.encode_equiv(s))), ascii_encode_spec(s))

# Canonical request-line serialization reconstructs every original field.
def string_assoc(+a: String, +b: String, +c: String) -> {(a ++ b) ++ c == a ++ (b ++ c) : String}:
  match a:
    case SNil{}:
      {==}
    case SCon{h, t}:
      Equal.cong(String, String, x => SCon{h, x}, (t ++ b) ++ c, t ++ (b ++ c), string_assoc(t, b, c))

def line_finish(+m: R.Method, +p: String, +q: Maybe<&2, String>, +v: R.Version, +mv: {R.method_valid(m) == True{} : Bool}, facts: {Support.free(p ++ R.query_text(q)) == True{} : Bool} & ({B.split_target(p ++ R.query_text(q)) == (p, q) : String & Maybe<&2, String>} & {P.target_form(m, p ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, p, q, v, []}, [], False{}} : P.State})) -> {P.request_line(W.line_content(m, p, q, v)) == P.Headers{R.Req{m, p, q, v, []}, [], False{}} : P.State}:
  (freeproof, more) = facts
  (split, target) = more
  +content = R.method_text(m) ++ " " ++ p ++ R.query_text(q) ++ " " ++ R.version_text(v)
  %Equal.sym(String, B.ascii(B.encode(content)), content, ascii_encode(content)) : {P.request_line_parts(Text.split(_, ' ')) == P.Headers{R.Req{m, p, q, v, []}, [], False{}} : P.State}
  %Equal.sym(List<&2, String>, Text.split(content, ' '), String.split(content, ' '), TP.split_equiv(content, ' ')) : {P.request_line_parts(_) == P.Headers{R.Req{m, p, q, v, []}, [], False{}} : P.State}
  %Equal.sym(List<&2, String>, String.split(content, ' '), R.method_text(m) <> String.split(p ++ R.query_text(q) ++ " " ++ R.version_text(v), ' '), Laws.split_method(m, p ++ R.query_text(q) ++ " " ++ R.version_text(v), mv)) : {P.request_line_parts(_) == P.Headers{R.Req{m, p, q, v, []}, [], False{}} : P.State}
  %string_assoc(p, R.query_text(q), " " ++ R.version_text(v)) : {P.request_line_parts(R.method_text(m) <> String.split(_, ' ')) == P.Headers{R.Req{m, p, q, v, []}, [], False{}} : P.State}
  %Equal.sym(List<&2, String>, String.split((p ++ R.query_text(q)) ++ " " ++ R.version_text(v), ' '), (p ++ R.query_text(q)) <> String.split(R.version_text(v), ' '), Laws.split_free(p ++ R.query_text(q), R.version_text(v), freeproof)) : {P.request_line_parts(R.method_text(m) <> _) == P.Headers{R.Req{m, p, q, v, []}, [], False{}} : P.State}
  %Equal.sym(List<&2, String>, String.split(R.version_text(v), ' '), [R.version_text(v)], split_version(v)) : {P.request_line_parts(R.method_text(m) <> (p ++ R.query_text(q)) <> _) == P.Headers{R.Req{m, p, q, v, []}, [], False{}} : P.State}
  %Equal.sym(Bool, B.token(R.method_text(m)), True{}, Laws.method_text_token(m, mv)) : {P.valid_method(R.method_text(m), p ++ R.query_text(q), R.version_text(v), _) == P.Headers{R.Req{m, p, q, v, []}, [], False{}} : P.State}
  %Equal.sym(R.Method, R.method(R.method_text(m)), m, Laws.method_recover(m, mv)) : {P.target_form(_, p ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, p, q, v, []}, [], False{}} : P.State}
  target

def Laws.line_recover(m, p, q, v, mv, tv):
  line_finish(m, p, q, v, mv, Laws.target_recover(m, p, q, v, tv))

# The first query delimiter follows the whole validated raw path.
def prefix_from_facts(+p: String, +q: Maybe<&2, String>, split: {B.split_target(p ++ R.query_text(q)) == (p, q) : String & Maybe<&2, String>}) -> {B.prefix(p ++ R.query_text(q)) == p : String}:
  Equal.cong(String & Maybe<&2, String>, String, parts => B.prefix_pair(parts), B.split_target(p ++ R.query_text(q)), (p, q), split)

def prefix_extract(+p: String, +q: Maybe<&2, String>, +m: R.Method, +v: R.Version, facts: {Support.free(p ++ R.query_text(q)) == True{} : Bool} & ({B.split_target(p ++ R.query_text(q)) == (p, q) : String & Maybe<&2, String>} & {P.target_form(m, p ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, p, q, v, []}, [], False{}} : P.State})) -> {B.prefix(p ++ R.query_text(q)) == p : String}:
  (freeproof, more) = facts
  (split, target) = more
  prefix_from_facts(p, q, split)

def Laws.target_prefix(m, p, q, v, tv):
  prefix_extract(p, q, m, v, Laws.target_recover(m, p, q, v, tv))
