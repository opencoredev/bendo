# Reconstruction of validated request targets and request lines.
import Base
import ../LAWS.bend as Laws
import ./support.bend as Support
import ./equality.bend as E
import ./tokens.bend as T
import ./uri.bend as U
import ../src/http/bytes.bend as B
import ../src/http/request.bend as R
import ../src/http/parse.bend as P
import ../src/http/write.bend as W
import ../src/http/text.bend as Text
import ./bytes-tail.bend as BT
import ./text.bend as TP

# Appending valid query text introduces no spaces.
def query_free(+q: Maybe<&2, String>, ok: {R.query_valid(q) == True{} : Bool}) -> {Support.free(R.query_text(q)) == True{} : Bool}:
  match q:
    case None{}:
      {==}
    case Some{s}:
      Laws.uri_free(s, True{}, ok)

# Concatenation preserves the absence of spaces.
def free_append(+s: String, +t: String, +a: {Support.free(s) == True{} : Bool}, +b: {Support.free(t) == True{} : Bool}) -> {Support.free(s ++ t) == True{} : Bool}:
  match s:
    case SNil{}:
      b
    case SCon{Chr{c}, rest}:
      U.and_true(Bool.not(U32.is_eq(c, 32)), Support.free(rest ++ t), Laws.and_left(Bool.not(U32.is_eq(c, 32)), Support.free(rest), a), free_append(rest, t, Laws.and_right(Bool.not(U32.is_eq(c, 32)), Support.free(rest), a), b))

# A valid origin-form suffix reconstructs its path and query exactly.
def origin_split(+t: String, +q: Maybe<&2, String>, +ok: {B.uri(t, False{}) && R.query_valid(q) == True{} : Bool}) -> {B.split_target(("/" ++ t) ++ R.query_text(q)) == ("/" ++ t, q) : String & Maybe<&2, String>}:
  Laws.split_path("/" ++ t, q, Laws.uri_path_clear(t, Laws.and_left(B.uri(t, False{}), R.query_valid(q), ok)))

def origin_free(+t: String, +q: Maybe<&2, String>, +ok: {B.uri(t, False{}) && R.query_valid(q) == True{} : Bool}) -> {Support.free(("/" ++ t) ++ R.query_text(q)) == True{} : Bool}:
  free_append(t, R.query_text(q), Laws.uri_free(t, False{}, Laws.and_left(B.uri(t, False{}), R.query_valid(q), ok)), query_free(q, Laws.and_right(B.uri(t, False{}), R.query_valid(q), ok)))

# Supported versions reconstruct without changing any target component.
def version_recover(+m: R.Method, +p: String, +q: Maybe<&2, String>, +v: R.Version, split: {B.split_target(p ++ R.query_text(q)) == (p, q) : String & Maybe<&2, String>}) -> {P.version(m, p ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, p, q, v, []}, [], False{}} : P.State}:
  match v:
    case R.Http10{}:
      Equal.cong(String & Maybe<&2, String>, P.State, parts => P.start_headers(m, parts, R.Http10{}), B.split_target(p ++ R.query_text(q)), (p, q), split)
    case R.Http11{}:
      Equal.cong(String & Maybe<&2, String>, P.State, parts => P.start_headers(m, parts, R.Http11{}), B.split_target(p ++ R.query_text(q)), (p, q), split)

# A validated target pair survives the parser's independent validation.
def supported_recover(+m: R.Method, +p: String, +q: Maybe<&2, String>, +v: R.Version, +split: {B.split_target(p ++ R.query_text(q)) == (p, q) : String & Maybe<&2, String>}, ok: {R.target_valid(m, p, q) == True{} : Bool}) -> {P.supported_target(m, p ++ R.query_text(q), R.version_text(v), B.split_target(p ++ R.query_text(q))) == P.Headers{R.Req{m, p, q, v, []}, [], False{}} : P.State}:
  %Equal.sym(String & Maybe<&2, String>, B.split_target(p ++ R.query_text(q)), (p, q), split) : {P.supported_target(m, p ++ R.query_text(q), R.version_text(v), _) == P.Headers{R.Req{m, p, q, v, []}, [], False{}} : P.State}
  %Equal.sym(Bool, R.target_valid(m, p, q), True{}, ok) : {P.validated_target(m, p ++ R.query_text(q), R.version_text(v), _) == P.Headers{R.Req{m, p, q, v, []}, [], False{}} : P.State}
  version_recover(m, p, q, v, split)

# Origin-form parsing retains validated path, query, method and version.
def origin_form(+m: R.Method, +t: String, +q: Maybe<&2, String>, +v: R.Version, +valid: {B.uri(t, False{}) && R.query_valid(q) == True{} : Bool}, +ok: {R.target_valid(m, "/" ++ t, q) == True{} : Bool}) -> {P.target_form(m, ("/" ++ t) ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, "/" ++ t, q, v, []}, [], False{}} : P.State}:
  match m:
    case R.Get{}:
      supported_recover(R.Get{}, "/" ++ t, q, v, origin_split(t, q, valid), ok)
    case R.Head{}:
      supported_recover(R.Head{}, "/" ++ t, q, v, origin_split(t, q, valid), ok)
    case R.Post{}:
      supported_recover(R.Post{}, "/" ++ t, q, v, origin_split(t, q, valid), ok)
    case R.Put{}:
      supported_recover(R.Put{}, "/" ++ t, q, v, origin_split(t, q, valid), ok)
    case R.Delete{}:
      supported_recover(R.Delete{}, "/" ++ t, q, v, origin_split(t, q, valid), ok)
    case R.Connect{}:
      E.absurd({P.target_form(R.Connect{}, ("/" ++ t) ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{R.Connect{}, "/" ++ t, q, v, []}, [], False{}} : P.State}, E.false_true(ok))
    case R.Options{}:
      supported_recover(R.Options{}, "/" ++ t, q, v, origin_split(t, q, valid), ok)
    case R.Trace{}:
      supported_recover(R.Trace{}, "/" ++ t, q, v, origin_split(t, q, valid), ok)
    case R.Patch{}:
      supported_recover(R.Patch{}, "/" ++ t, q, v, origin_split(t, q, valid), ok)
    case R.Extension{token}:
      supported_recover(R.Extension{token}, "/" ++ t, q, v, origin_split(t, q, valid), ok)

# An origin target satisfies all three reconstruction obligations.
def origin_all(+m: R.Method, +p: String, +q: Maybe<&2, String>, +v: R.Version, +valid: {R.origin_valid(p, q) == True{} : Bool}, +ok: {R.target_valid(m, p, q) == True{} : Bool}) -> {Support.free(p ++ R.query_text(q)) == True{} : Bool} & ({B.split_target(p ++ R.query_text(q)) == (p, q) : String & Maybe<&2, String>} & {P.target_form(m, p ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, p, q, v, []}, [], False{}} : P.State}):
  match p:
    case SNil{}:
      E.absurd({Support.free(R.query_text(q)) == True{} : Bool} & ({B.split_target(R.query_text(q)) == (SNil{}, q) : String & Maybe<&2, String>} & {P.target_form(m, R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, SNil{}, q, v, []}, [], False{}} : P.State}), E.false_true(valid))
    case SCon{Chr{47}, t}:
      (origin_free(t, q, valid), (origin_split(t, q, valid), origin_form(m, t, q, v, valid, ok)))
    case SCon{Chr{U32{WCon{False{}, bits}}}, t}:
      E.absurd({Support.free(SCon{Chr{U32{WCon{False{}, bits}}}, t} ++ R.query_text(q)) == True{} : Bool} & ({B.split_target(SCon{Chr{U32{WCon{False{}, bits}}}, t} ++ R.query_text(q)) == (SCon{Chr{U32{WCon{False{}, bits}}}, t}, q) : String & Maybe<&2, String>} & {P.target_form(m, SCon{Chr{U32{WCon{False{}, bits}}}, t} ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, SCon{Chr{U32{WCon{False{}, bits}}}, t}, q, v, []}, [], False{}} : P.State}), E.false_true(valid))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, bits}}}}, t}:
      E.absurd({Support.free(SCon{Chr{U32{WCon{True{}, WCon{False{}, bits}}}}, t} ++ R.query_text(q)) == True{} : Bool} & ({B.split_target(SCon{Chr{U32{WCon{True{}, WCon{False{}, bits}}}}, t} ++ R.query_text(q)) == (SCon{Chr{U32{WCon{True{}, WCon{False{}, bits}}}}, t}, q) : String & Maybe<&2, String>} & {P.target_form(m, SCon{Chr{U32{WCon{True{}, WCon{False{}, bits}}}}, t} ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, SCon{Chr{U32{WCon{True{}, WCon{False{}, bits}}}}, t}, q, v, []}, [], False{}} : P.State}), E.false_true(valid))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{False{}, bits}}}}}, t}:
      E.absurd({Support.free(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{False{}, bits}}}}}, t} ++ R.query_text(q)) == True{} : Bool} & ({B.split_target(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{False{}, bits}}}}}, t} ++ R.query_text(q)) == (SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{False{}, bits}}}}}, t}, q) : String & Maybe<&2, String>} & {P.target_form(m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{False{}, bits}}}}}, t} ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{False{}, bits}}}}}, t}, q, v, []}, [], False{}} : P.State}), E.false_true(valid))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, bits}}}}}}, t}:
      E.absurd({Support.free(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, bits}}}}}}, t} ++ R.query_text(q)) == True{} : Bool} & ({B.split_target(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, bits}}}}}}, t} ++ R.query_text(q)) == (SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, bits}}}}}}, t}, q) : String & Maybe<&2, String>} & {P.target_form(m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, bits}}}}}}, t} ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, bits}}}}}}, t}, q, v, []}, [], False{}} : P.State}), E.false_true(valid))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, bits}}}}}}}, t}:
      E.absurd({Support.free(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, bits}}}}}}}, t} ++ R.query_text(q)) == True{} : Bool} & ({B.split_target(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, bits}}}}}}}, t} ++ R.query_text(q)) == (SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, bits}}}}}}}, t}, q) : String & Maybe<&2, String>} & {P.target_form(m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, bits}}}}}}}, t} ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, bits}}}}}}}, t}, q, v, []}, [], False{}} : P.State}), E.false_true(valid))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, bits}}}}}}}}, t}:
      E.absurd({Support.free(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, bits}}}}}}}}, t} ++ R.query_text(q)) == True{} : Bool} & ({B.split_target(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, bits}}}}}}}}, t} ++ R.query_text(q)) == (SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, bits}}}}}}}}, t}, q) : String & Maybe<&2, String>} & {P.target_form(m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, bits}}}}}}}}, t} ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, bits}}}}}}}}, t}, q, v, []}, [], False{}} : P.State}), E.false_true(valid))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}}}}}, t}:
      E.absurd({Support.free(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}}}}}, t} ++ R.query_text(q)) == True{} : Bool} & ({B.split_target(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}}}}}, t} ++ R.query_text(q)) == (SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}}}}}, t}, q) : String & Maybe<&2, String>} & {P.target_form(m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}}}}}, t} ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}}}}}, t}, q, v, []}, [], False{}} : P.State}), E.false_true(valid))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}, t}:
      E.absurd({Support.free(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}, t} ++ R.query_text(q)) == True{} : Bool} & ({B.split_target(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}, t} ++ R.query_text(q)) == (SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}, t}, q) : String & Maybe<&2, String>} & {P.target_form(m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}, t} ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}, t}, q, v, []}, [], False{}} : P.State}), E.false_true(valid))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}, t}:
      E.absurd({Support.free(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}, t} ++ R.query_text(q)) == True{} : Bool} & ({B.split_target(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}, t} ++ R.query_text(q)) == (SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}, t}, q) : String & Maybe<&2, String>} & {P.target_form(m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}, t} ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}, t}, q, v, []}, [], False{}} : P.State}), E.false_true(valid))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}, t}:
      E.absurd({Support.free(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}, t} ++ R.query_text(q)) == True{} : Bool} & ({B.split_target(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}, t} ++ R.query_text(q)) == (SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}, t}, q) : String & Maybe<&2, String>} & {P.target_form(m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}, t} ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}, t}, q, v, []}, [], False{}} : P.State}), E.false_true(valid))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}}, t}:
      E.absurd({Support.free(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}}, t} ++ R.query_text(q)) == True{} : Bool} & ({B.split_target(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}}, t} ++ R.query_text(q)) == (SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}}, t}, q) : String & Maybe<&2, String>} & {P.target_form(m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}}, t} ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}}, t}, q, v, []}, [], False{}} : P.State}), E.false_true(valid))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}}}, t}:
      E.absurd({Support.free(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}}}, t} ++ R.query_text(q)) == True{} : Bool} & ({B.split_target(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}}}, t} ++ R.query_text(q)) == (SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}}}, t}, q) : String & Maybe<&2, String>} & {P.target_form(m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}}}, t} ++ R.query_text(q), R.version_text(v)) == P.Headers{R.Req{m, SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}}}, t}, q, v, []}, [], False{}} : P.State}), E.false_true(valid))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}}}}}}, t}:
