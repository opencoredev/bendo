def options_printable(+p: String, +ok: {R.options_valid(p, None{}) == True{} : Bool}, same: Bool, eq: {String.eq(p, "*") == same : Bool}) -> {Support.printable(B.encode(p ++ R.query_text(None{}))) == True{} : Bool}:
  match same:
    case True{}:
      pe = Laws.string_eq_sound(p, "*", eq)
      %Equal.sym(String, p, "*", pe) : {Support.printable(B.encode(_ ++ R.query_text(None{}))) == True{} : Bool}
      {==}
    case False{}:
      origin = Equal.trans(Bool, R.origin_valid(p, None{}), String.eq(p, "*") || R.origin_valid(p, None{}), True{}, Equal.sym(Bool, String.eq(p, "*") || R.origin_valid(p, None{}), R.origin_valid(p, None{}), Equal.cong(Bool, Bool, b => b || R.origin_valid(p, None{}), String.eq(p, "*"), False{}, eq)), ok)
      origin_printable(p, None{}, origin)

# Every well-formed target serializes to Support.printable request-line bytes.
def Laws.target_printable(m, p, q, ok):
  match m:
    case R.Get{}:
      origin_printable(p, q, ok)
    case R.Head{}:
      origin_printable(p, q, ok)
    case R.Post{}:
      origin_printable(p, q, ok)
    case R.Put{}:
      origin_printable(p, q, ok)
    case R.Delete{}:
      origin_printable(p, q, ok)
    case R.Connect{}:
      E.absurd({Support.printable(B.encode(p ++ R.query_text(q))) == True{} : Bool}, E.false_true(ok))
    case R.Options{}:
      match q:
        case None{}:
          options_printable(p, ok, String.eq(p, "*"), {==})
        case Some{query}:
          origin_printable(p, Some{query}, ok)
    case R.Trace{}:
      origin_printable(p, q, ok)
    case R.Patch{}:
      origin_printable(p, q, ok)
    case R.Extension{token}:
      origin_printable(p, q, ok)

def version_printable(v: R.Version) -> {Support.printable(B.encode(R.version_text(v))) == True{} : Bool}:
  match v:
    case R.Http10{}:
      {==}
    case R.Http11{}:
      {==}

def target_version_printable(+m: R.Method, +p: String, +q: Maybe<&2, String>, +v: R.Version, tv: {R.target_valid(m, p, q) == True{} : Bool}) -> {Support.printable(B.encode(p ++ R.query_text(q) ++ " " ++ R.version_text(v))) == True{} : Bool}:
  %L.string_assoc(p, R.query_text(q), " " ++ R.version_text(v)) : {Support.printable(B.encode(_)) == True{} : Bool}
  string_printable_append(p ++ R.query_text(q), " " ++ R.version_text(v), Laws.target_printable(m, p, q, tv), version_printable(v))

# Method, target, separators and version form a Support.printable request line.
def Laws.line_printable(m, p, q, v, mv, tv):
  string_printable_append(R.method_text(m), " " ++ p ++ R.query_text(q) ++ " " ++ R.version_text(v), Laws.token_printable(R.method_text(m), Laws.method_text_token(m, mv)), target_version_printable(m, p, q, v, tv))
