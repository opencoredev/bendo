# Printable string concatenation is Support.printable on the wire.
def string_printable_append(+a: String, +b: String, +left: {Support.printable(B.encode(a)) == True{} : Bool}, +right: {Support.printable(B.encode(b)) == True{} : Bool}) -> {Support.printable(B.encode(a ++ b)) == True{} : Bool}:
  match a:
    case SNil{}:
      right
    case SCon{Chr{c}, t}:
      U.and_true(Support.printable_octet(c), Support.printable(B.encode(t ++ b)), Laws.and_left(Support.printable_octet(c), Support.printable(B.encode(t)), left), string_printable_append(t, b, Laws.and_right(Support.printable_octet(c), Support.printable(B.encode(t)), left), right))

# A valid query contains Support.printable bytes after its separator.
def query_printable(+q: Maybe<&2, String>, ok: {R.query_valid(q) == True{} : Bool}) -> {Support.printable(B.encode(R.query_text(q))) == True{} : Bool}:
  match q:
    case None{}:
      {==}
    case Some{s}:
      Laws.uri_printable(s, True{}, ok)

# An origin target is Support.printable independently of the method.
def origin_printable(+p: String, +q: Maybe<&2, String>, +ok: {R.origin_valid(p, q) == True{} : Bool}) -> {Support.printable(B.encode(p ++ R.query_text(q))) == True{} : Bool}:
  match p:
    case SNil{}:
      E.absurd({Support.printable(B.encode(R.query_text(q))) == True{} : Bool}, E.false_true(ok))
    case SCon{Chr{47}, t}:
      string_printable_append(t, R.query_text(q), Laws.uri_printable(t, False{}, Laws.and_left(B.uri(t, False{}), R.query_valid(q), ok)), query_printable(q, Laws.and_right(B.uri(t, False{}), R.query_valid(q), ok)))
    case SCon{Chr{U32{WCon{False{}, bits}}}, t}:
      E.absurd({Support.printable(B.encode(SCon{Chr{U32{WCon{False{}, bits}}}, t} ++ R.query_text(q))) == True{} : Bool}, E.false_true(ok))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, bits}}}}, t}:
      E.absurd({Support.printable(B.encode(SCon{Chr{U32{WCon{True{}, WCon{False{}, bits}}}}, t} ++ R.query_text(q))) == True{} : Bool}, E.false_true(ok))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{False{}, bits}}}}}, t}:
