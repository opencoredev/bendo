# Appending a disjunct preserves truth.
def or_true(+a: Bool, +b: Bool, e: {a == True{} : Bool}) -> {a || b == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, e) : {_ || b == True{} : Bool}
  {==}

def or_false_identity(a: Bool, e: {a || False{} == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case False{}:
      e
    case True{}:
      {==}

# Turning query mode on cannot invalidate an accepted URI character.
def query_char(+c: U32, q: Bool, ok: {B.uri_char(c, q) == True{} : Bool}) -> {B.uri_char(c, True{}) == True{} : Bool}:
  match q:
    case True{}:
      ok
    case False{}:
      or_true(((c >= 48 : U32) && (c <= 57 : U32)) || ((c >= 65 : U32) && (c <= 90 : U32)) || ((c >= 97 : U32) && (c <= 122 : U32)) || String.contains("-._~!$&'()*+,;=:@/", Char.show(Chr{c})), U32.is_eq(c, 63), or_false_identity(((c >= 48 : U32) && (c <= 57 : U32)) || ((c >= 65 : U32) && (c <= 90 : U32)) || ((c >= 97 : U32) && (c <= 122 : U32)) || String.contains("-._~!$&'()*+,;=:@/", Char.show(Chr{c})), ok))

def uri_printable_step(+c: U32, +t: String, +q: Bool, ok: {B.uri_char(c, q) && B.uri(t, q) == True{} : Bool}, tail: {Support.printable(B.encode(t)) == True{} : Bool}) -> {Support.printable(B.encode(SCon{Chr{c}, t})) == True{} : Bool}:
  U.and_true(Support.printable_octet(c), Support.printable(B.encode(t)), uri_char_printable(c, query_char(c, q, Laws.and_left(B.uri_char(c, q), B.uri(t, q), ok))), tail)

# Valid URI text serializes to Support.printable bytes, including percent escapes.
def Laws.uri_printable(s, q, ok):
  match s:
    case SNil{}:
      {==}
    case SCon{Chr{37}, SCon{Chr{a}, SCon{Chr{b}, t}}}:
      +ab = Laws.and_left(B.hex(a) && B.hex(b), B.uri(t, q), ok)
      at = hex_printable(a, Laws.and_left(B.hex(a), B.hex(b), ab))
      bt = hex_printable(b, Laws.and_right(B.hex(a), B.hex(b), ab))
      tt = Laws.uri_printable(t, q, Laws.and_right(B.hex(a) && B.hex(b), B.uri(t, q), ok))
      U.and_true(Support.printable_octet(a), Support.printable_octet(b) && Support.printable(B.encode(t)), at, U.and_true(Support.printable_octet(b), Support.printable(B.encode(t)), bt, tt))
    case SCon{Chr{37}, SNil{}}:
      {==}
    case SCon{Chr{37}, SCon{h, SNil{}}}:
      match q:
        case False{}:
          E.absurd({Support.printable(B.encode(SCon{Chr{37}, SCon{h, SNil{}}})) == True{} : Bool}, E.false_true(ok))
        case True{}:
          E.absurd({Support.printable(B.encode(SCon{Chr{37}, SCon{h, SNil{}}})) == True{} : Bool}, E.false_true(ok))
    case SCon{Chr{U32{WCon{False{}, bits}}}, t}:
      uri_printable_step(U32{WCon{False{}, bits}}, t, q, ok, Laws.uri_printable(t, q, Laws.and_right(B.uri_char(U32{WCon{False{}, bits}}, q), B.uri(t, q), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, bits}}}}, t}:
      uri_printable_step(U32{WCon{True{}, WCon{True{}, bits}}}, t, q, ok, Laws.uri_printable(t, q, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{True{}, bits}}}, q), B.uri(t, q), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, WCon{False{}, bits}}}}}, t}:
      uri_printable_step(U32{WCon{True{}, WCon{False{}, WCon{False{}, bits}}}}, t, q, ok, Laws.uri_printable(t, q, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{False{}, WCon{False{}, bits}}}}, q), B.uri(t, q), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}}, t}:
      uri_printable_step(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}, t, q, ok, Laws.uri_printable(t, q, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}, q), B.uri(t, q), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}}, t}:
      uri_printable_step(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}, t, q, ok, Laws.uri_printable(t, q, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}, q), B.uri(t, q), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, bits}}}}}}}}, t}:
      uri_printable_step(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, bits}}}}}}}, t, q, ok, Laws.uri_printable(t, q, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, bits}}}}}}}, q), B.uri(t, q), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}}}}}, t}:
      uri_printable_step(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}}}}, t, q, ok, Laws.uri_printable(t, q, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}}}}, q), B.uri(t, q), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}, t}:
