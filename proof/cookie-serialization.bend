def weekday_equiv_finish(+s: String, evidence: {C.weekday(s) == Spec.weekday(s) : Bool} & ({Spec.weekday(s) == True{} : Bool} -> Spec.no_delimiters(s))) -> {C.weekday(s) == Spec.weekday(s) : Bool}:
  (same, safe) = evidence
  same

def weekday_equiv(+s: String) -> {C.weekday(s) == Spec.weekday(s) : Bool}:
  weekday_equiv_finish(s, weekday_analysis(s))

def weekday_safe_finish(+s: String, ok: {Spec.weekday(s) == True{} : Bool}, evidence: {C.weekday(s) == Spec.weekday(s) : Bool} & ({Spec.weekday(s) == True{} : Bool} -> Spec.no_delimiters(s))) -> Spec.no_delimiters(s):
  (same, safe) = evidence
  safe(ok)

def weekday_safe(+s: String, ok: {Spec.weekday(s) == True{} : Bool}) -> Spec.no_delimiters(s):
  weekday_safe_finish(s, ok, weekday_analysis(s))

def month_equiv_finish(+s: String, +year: U32, evidence: {C.month_days(s, year) == Spec.month_days(s, year) : U32} & (Spec.no_delimiters(s) | {Spec.month_days(s, year) == 0 : U32})) -> {C.month_days(s, year) == Spec.month_days(s, year) : U32}:
  (same, safe) = evidence
  same

def month_equiv(+s: String, +year: U32) -> {C.month_days(s, year) == Spec.month_days(s, year) : U32}:
  month_equiv_finish(s, year, month_analysis(s, year))

def month_safety_finish(+s: String, +year: U32, evidence: {C.month_days(s, year) == Spec.month_days(s, year) : U32} & (Spec.no_delimiters(s) | {Spec.month_days(s, year) == 0 : U32})) -> Spec.no_delimiters(s) | {Spec.month_days(s, year) == 0 : U32}:
  (same, safe) = evidence
  safe

def month_safety(+s: String, +year: U32) -> Spec.no_delimiters(s) | {Spec.month_days(s, year) == 0 : U32}:
  month_safety_finish(s, year, month_analysis(s, year))

def date_numbers_equiv(+day: Maybe<&2, U32>, +year: Maybe<&2, U32>, +hour: Maybe<&2, U32>, +minute: Maybe<&2, U32>, +second: Maybe<&2, U32>, +month: String) -> {C.date_numbers(day, year, hour, minute, second, month) == Spec.date_numbers(day, year, hour, minute, second, month) : Bool}:
  match day year hour minute second:
    case None{} _ _ _ _: {==}
    case Some{d} None{} _ _ _: {==}
    case Some{d} Some{y} None{} _ _: {==}
    case Some{d} Some{y} Some{h} None{} _: {==}
    case Some{d} Some{y} Some{h} Some{m} None{}: {==}
    case Some{+d} Some{+y} Some{+h} Some{+m} Some{+sec}:
      Equal.cong(U32, Bool, x => (y >= 1601 : U32) && (d >= 1 : U32) && (d <= x : U32) && (h <= 23 : U32) && (m <= 59 : U32) && (sec <= 59 : U32), C.month_days(month, y), Spec.month_days(month, y), month_equiv(month, y))

