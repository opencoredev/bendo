    case SNil{}: ({==}, Inr{{==}})
    case SCon{Chr{U32{WCon{False{}, wild}}}, t}: ({==}, Inr{{==}})
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, wild}}}}, t}: ({==}, Inr{{==}})
