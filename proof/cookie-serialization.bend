def path_body_equiv(+s: String) -> {C.path_body(s) == Spec.path_body(s) : Bool}:
  match s:
    case SNil{}: {==}
    case SCon{Chr{c}, +t}: path_char_equiv(c, t)

def path_equiv(+s: String) -> {C.path_valid(s) == Spec.path_valid(s) : Bool}:
  Equal.cong(Bool, Bool, x => x && Bool.not(String.ends_with(s, " ")), C.path_body(s), Spec.path_body(s), path_body_equiv(s))

def domain_chars_equiv(+s: String) -> {C.domain_chars(s) == Spec.domain_chars(s) : Bool}:
  match s:
    case SNil{}: {==}
    case SCon{Chr{+c}, +t}:
      Equal.cong(Bool, Bool, x => (((c >= 48 : U32) && (c <= 57 : U32)) || ((c >= 65 : U32) && (c <= 90 : U32)) || ((c >= 97 : U32) && (c <= 122 : U32)) || U32.is_eq(c, 45)) && x, C.domain_chars(t), Spec.domain_chars(t), domain_chars_equiv(t))

def label_equiv(+s: String) -> {C.label_valid(s) == Spec.label_valid(s) : Bool}:
  Equal.cong(Bool, Bool, x => Bool.not(String.is_empty(s)) && Bool.not(String.starts_with(s, "-")) && Bool.not(String.ends_with(s, "-")) && (String.length(s) <= 63n : Nat) && x, C.domain_chars(s), Spec.domain_chars(s), domain_chars_equiv(s))

def labels_equiv(+xs: List<&2, String>) -> {C.labels_valid(xs) == Spec.labels_valid(xs) : Bool}:
  match xs:
    case Nil{}: {==}
    case +h <> +t:
      both_equal(C.label_valid(h), Spec.label_valid(h), C.labels_valid(t), Spec.labels_valid(t), label_equiv(h), labels_equiv(t))

