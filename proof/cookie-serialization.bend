def domain_equiv(+s: String) -> {C.domain_valid(s) == Spec.domain_valid(s) : Bool}:
  Equal.cong(Bool, Bool, x => (String.length(s) <= 254n : Nat) && x, C.labels_valid(String.split(C.domain_body(s), '.')), Spec.labels_valid(String.split(Spec.domain_body(s), '.')), Equal.trans(Bool, C.labels_valid(String.split(C.domain_body(s), '.')), C.labels_valid(String.split(Spec.domain_body(s), '.')), Spec.labels_valid(String.split(Spec.domain_body(s), '.')), Equal.cong(String, Bool, x => C.labels_valid(String.split(x, '.')), C.domain_body(s), Spec.domain_body(s), domain_body_equiv(s)), labels_equiv(String.split(Spec.domain_body(s), '.'))))

def february_equiv(+b: Bool) -> {C.february(b) == Spec.february(b) : U32}:
  match b:
    case True{}: {==}
    case False{}: {==}


def exclude(~valid: U32 -> Bool, +c: U32, +k: U32, ok: {valid(c) == True{} : Bool}, bad: {valid(k) == False{} : Bool}, same: {c == k : U32}) -> Empty:
  U.false_true(Equal.trans(Bool, False{}, valid(k), True{}, Equal.sym(Bool, valid(k), False{}, bad), Equal.trans(Bool, valid(k), valid(c), True{}, Equal.sym(Bool, valid(c), valid(k), Equal.cong(U32, Bool, x => valid(x), c, k, same)), ok)))


def cons_safe(+c: U32, +t: String, head: Spec.no_delimiters(SCon{Chr{c}, ""}), tail: Spec.no_delimiters(t)) -> Spec.no_delimiters(SCon{Chr{c}, t}):
  (semi, rest) = head
  (cr, rest) = rest
  (lf, empty) = rest
  (semi, (cr, (lf, tail)))


def printable_safe(+c: U32, lower: {(c >= 32 : U32) == True{} : Bool}, semi: {U32.is_ne(c, 59) == True{} : Bool}) -> Spec.no_delimiters(SCon{Chr{c}, ""}):
  +lower = lower
  (same => exclude(~(x => U32.is_ne(x, 59)), c, 59, semi, {==}, same), (same => exclude(~(x => (x >= 32 : U32)), c, 13, lower, {==}, same), (same => exclude(~(x => (x >= 32 : U32)), c, 10, lower, {==}, same), Unit{})))


# Finite recognizer equivalence and safety share each exhaustive character
# partition. Prefix helpers keep the proof terms and failed cases compact.
def weekday_analysis_Fri(+s: String) -> {C.weekday("Fri" ++ s) == Spec.weekday("Fri" ++ s) : Bool} & ({Spec.weekday("Fri" ++ s) == True{} : Bool} -> Spec.no_delimiters("Fri" ++ s)):
  match s:
    case SNil{}: ({==}, ok => cons_safe(70, "ri", printable_safe(70, {==}, {==}), cons_safe(114, "i", printable_safe(114, {==}, {==}), cons_safe(105, "", printable_safe(105, {==}, {==}), Unit{}))))
    case SCon{h, t}: ({==}, ok => U.absurd(Spec.no_delimiters("Fri" ++ s), U.false_true(ok)))

