def weekday_analysis_Sat(+s: String) -> {C.weekday("Sat" ++ s) == Spec.weekday("Sat" ++ s) : Bool} & ({Spec.weekday("Sat" ++ s) == True{} : Bool} -> Spec.no_delimiters("Sat" ++ s)):
  match s:
    case SNil{}: ({==}, ok => cons_safe(83, "at", printable_safe(83, {==}, {==}), cons_safe(97, "t", printable_safe(97, {==}, {==}), cons_safe(116, "", printable_safe(116, {==}, {==}), Unit{}))))
    case SCon{h, t}: ({==}, ok => U.absurd(Spec.no_delimiters("Sat" ++ s), U.false_true(ok)))

