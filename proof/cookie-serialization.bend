def weekday_analysis_Wed(+s: String) -> {C.weekday("Wed" ++ s) == Spec.weekday("Wed" ++ s) : Bool} & ({Spec.weekday("Wed" ++ s) == True{} : Bool} -> Spec.no_delimiters("Wed" ++ s)):
  match s:
    case SNil{}: ({==}, ok => cons_safe(87, "ed", printable_safe(87, {==}, {==}), cons_safe(101, "d", printable_safe(101, {==}, {==}), cons_safe(100, "", printable_safe(100, {==}, {==}), Unit{}))))
    case SCon{h, t}: ({==}, ok => U.absurd(Spec.no_delimiters("Wed" ++ s), U.false_true(ok)))

