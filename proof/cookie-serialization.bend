def month_analysis_Dec(+s: String, +year: U32) -> {C.month_days("Dec" ++ s, year) == Spec.month_days("Dec" ++ s, year) : U32} & (Spec.no_delimiters("Dec" ++ s) | {Spec.month_days("Dec" ++ s, year) == 0 : U32}):
  match s:
    case SNil{}: ({==}, Inl{cons_safe(68, "ec", printable_safe(68, {==}, {==}), cons_safe(101, "c", printable_safe(101, {==}, {==}), cons_safe(99, "", printable_safe(99, {==}, {==}), Unit{})))})
    case SCon{h, t}: ({==}, Inr{{==}})

