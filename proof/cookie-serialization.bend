  match s:
    case SNil{}: ({==}, Inl{cons_safe(74, "an", printable_safe(74, {==}, {==}), cons_safe(97, "n", printable_safe(97, {==}, {==}), cons_safe(110, "", printable_safe(110, {==}, {==}), Unit{})))})
    case SCon{h, t}: ({==}, Inr{{==}})

