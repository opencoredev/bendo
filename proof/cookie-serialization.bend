def month_analysis_Jul(+s: String, +year: U32) -> {C.month_days("Jul" ++ s, year) == Spec.month_days("Jul" ++ s, year) : U32} & (Spec.no_delimiters("Jul" ++ s) | {Spec.month_days("Jul" ++ s, year) == 0 : U32}):
  match s:
    case SNil{}: ({==}, Inl{cons_safe(74, "ul", printable_safe(74, {==}, {==}), cons_safe(117, "l", printable_safe(117, {==}, {==}), cons_safe(108, "", printable_safe(108, {==}, {==}), Unit{})))})
    case SCon{h, t}: ({==}, Inr{{==}})

def month_analysis_Jun(+s: String, +year: U32) -> {C.month_days("Jun" ++ s, year) == Spec.month_days("Jun" ++ s, year) : U32} & (Spec.no_delimiters("Jun" ++ s) | {Spec.month_days("Jun" ++ s, year) == 0 : U32}):
