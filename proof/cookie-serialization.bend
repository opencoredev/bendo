def month_analysis_Feb(+s: String, +year: U32) -> {C.month_days("Feb" ++ s, year) == Spec.month_days("Feb" ++ s, year) : U32} & (Spec.no_delimiters("Feb" ++ s) | {Spec.month_days("Feb" ++ s, year) == 0 : U32}):
  match s:
    case SNil{}: (february_equiv(U32.is_eq((year % 4 : U32), 0) && (U32.is_ne((year % 100 : U32), 0) || U32.is_eq((year % 400 : U32), 0))), Inl{cons_safe(70, "eb", printable_safe(70, {==}, {==}), cons_safe(101, "b", printable_safe(101, {==}, {==}), cons_safe(98, "", printable_safe(98, {==}, {==}), Unit{})))})
    case SCon{h, t}: ({==}, Inr{{==}})

