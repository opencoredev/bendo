    case SNil{}: U.absurd(Unit, U.false_true(ok))
    case SCon{Chr{+c}, +t}:
      path_char_safe(c, t, U.and_left(Spec.path_body(SCon{Chr{c}, t}), Bool.not(String.ends_with(SCon{Chr{c}, t}, " ")), ok))

