def weekday_analysis_Tue(+s: String) -> {C.weekday("Tue" ++ s) == Spec.weekday("Tue" ++ s) : Bool} & ({Spec.weekday("Tue" ++ s) == True{} : Bool} -> Spec.no_delimiters("Tue" ++ s)):
  match s:
    case SNil{}: ({==}, ok => cons_safe(84, "ue", printable_safe(84, {==}, {==}), cons_safe(117, "e", printable_safe(117, {==}, {==}), cons_safe(101, "", printable_safe(101, {==}, {==}), Unit{}))))
    case SCon{h, t}: ({==}, ok => U.absurd(Spec.no_delimiters("Tue" ++ s), U.false_true(ok)))

