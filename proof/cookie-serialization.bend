def domain_safe(+s: String, ok: {Spec.domain_valid(s) == True{} : Bool}) -> Spec.no_delimiters(s):
  domain_prefix_safe(s, split_safe(Spec.domain_body(s), labels_safe(String.split(Spec.domain_body(s), '.'), U.and_right((String.length(s) <= 254n : Nat), Spec.labels_valid(String.split(Spec.domain_body(s), '.')), ok))))

# Finite-token witnesses use the same exhaustive bit partitions as the
# equivalence proofs. Each rejected branch has a computed False premise.
def positive_not_zero(+d: U32, lower: {(d >= 1 : U32) == True{} : Bool}, upper: {(d <= 0 : U32) == True{} : Bool}) -> Empty:
  match d:
    case U32{+w}:
      exclude(~(x => (x >= 1 : U32)), U32{w}, 0, lower, {==}, Equal.cong(Word(32n), U32, x => U32{x}, w, Word.zero(32n), U.cmp_le_zero(32n, w, upper)))

def month_safe_finish(+month: String, +year: U32, +d: U32, lower: {(d >= 1 : U32) == True{} : Bool}, upper: {(d <= Spec.month_days(month, year) : U32) == True{} : Bool}, evidence: Spec.no_delimiters(month) | {Spec.month_days(month, year) == 0 : U32}) -> Spec.no_delimiters(month):
  match evidence:
    case Inl{safe}: safe
    case Inr{zero}:
      U.absurd(Spec.no_delimiters(month), positive_not_zero(d, lower, Equal.trans(Bool, (d <= 0 : U32), (d <= Spec.month_days(month, year) : U32), True{}, Equal.cong(U32, Bool, x => (d <= x : U32), 0, Spec.month_days(month, year), Equal.sym(U32, Spec.month_days(month, year), 0, zero)), upper)))

def date_month_safe(+day: Maybe<&2, U32>, +year: Maybe<&2, U32>, +hour: Maybe<&2, U32>, +minute: Maybe<&2, U32>, +second: Maybe<&2, U32>, +month: String, ok: {Spec.date_numbers(day, year, hour, minute, second, month) == True{} : Bool}) -> Spec.no_delimiters(month):
  match day year hour minute second:
    case None{} _ _ _ _: U.absurd(Spec.no_delimiters(month), U.false_true(ok))
    case Some{d} None{} _ _ _: U.absurd(Spec.no_delimiters(month), U.false_true(ok))
    case Some{d} Some{y} None{} _ _: U.absurd(Spec.no_delimiters(month), U.false_true(ok))
    case Some{d} Some{y} Some{h} None{} _: U.absurd(Spec.no_delimiters(month), U.false_true(ok))
    case Some{d} Some{y} Some{h} Some{m} None{}: U.absurd(Spec.no_delimiters(month), U.false_true(ok))
    case Some{+d} Some{+y} Some{+h} Some{+m} Some{+sec}:
      +e5 = ok
      +e4 = U.and_left((y >= 1601 : U32) && (d >= 1 : U32) && (d <= Spec.month_days(month, y) : U32) && (h <= 23 : U32) && (m <= 59 : U32), (sec <= 59 : U32), e5)
      +e3 = U.and_left((y >= 1601 : U32) && (d >= 1 : U32) && (d <= Spec.month_days(month, y) : U32) && (h <= 23 : U32), (m <= 59 : U32), e4)
      +e2 = U.and_left((y >= 1601 : U32) && (d >= 1 : U32) && (d <= Spec.month_days(month, y) : U32), (h <= 23 : U32), e3)
      lower = U.and_right((y >= 1601 : U32), (d >= 1 : U32), U.and_left((y >= 1601 : U32) && (d >= 1 : U32), (d <= Spec.month_days(month, y) : U32), e2))
      upper = U.and_right((y >= 1601 : U32) && (d >= 1 : U32), (d <= Spec.month_days(month, y) : U32), e2)
      month_safe_finish(month, y, d, lower, upper, month_safety(month, y))

def expires_safe(+s: String, ok: {Spec.expires_valid(s) == True{} : Bool}) -> Spec.no_delimiters(s):
  match s:
    case SNil{}: U.absurd(Spec.no_delimiters(s), U.false_true(ok))
    case SCon{+w1, SNil{}}: U.absurd(Spec.no_delimiters(s), U.false_true(ok))
    case SCon{+w1, SCon{+w2, SNil{}}}: U.absurd(Spec.no_delimiters(s), U.false_true(ok))
    case SCon{+w1, SCon{+w2, SCon{+w3, SNil{}}}}: U.absurd(Spec.no_delimiters(s), U.false_true(ok))
    case SCon{+w1, SCon{+w2, SCon{+w3, SCon{Chr{U32{WCon{False{}, WCon{False{}, WCon{False{}, wild1}}}}}, wild2}}}}: U.absurd(Spec.no_delimiters(s), U.false_true(ok))
    case SCon{+w1, SCon{+w2, SCon{+w3, SCon{Chr{U32{WCon{False{}, WCon{False{}, WCon{True{}, WCon{False{}, wild1}}}}}}, wild2}}}}: U.absurd(Spec.no_delimiters(s), U.false_true(ok))
    case SCon{+w1, SCon{+w2, SCon{+w3, SCon{Chr{U32{WCon{False{}, WCon{False{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, wild1}}}}}}}}, wild2}}}}: U.absurd(Spec.no_delimiters(s), U.false_true(ok))
