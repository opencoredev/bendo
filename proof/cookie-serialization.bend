def month_analysis_Nov(+s: String, +year: U32) -> {C.month_days("Nov" ++ s, year) == Spec.month_days("Nov" ++ s, year) : U32} & (Spec.no_delimiters("Nov" ++ s) | {Spec.month_days("Nov" ++ s, year) == 0 : U32}):
  match s:
    case SNil{}: ({==}, Inl{cons_safe(78, "ov", printable_safe(78, {==}, {==}), cons_safe(111, "v", printable_safe(111, {==}, {==}), cons_safe(118, "", printable_safe(118, {==}, {==}), Unit{})))})
    case SCon{h, t}: ({==}, Inr{{==}})

