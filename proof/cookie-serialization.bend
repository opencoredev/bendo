def path_option_safe(+o: Maybe<&2, String>, ok: {Spec.optional_valid(~Spec.path_valid, o) == True{} : Bool}) -> Spec.optional_payload_safe(o):
  match o:
    case None{}: Unit{}
    case Some{+s}: path_safe(s, ok)

def domain_option_safe(+o: Maybe<&2, String>, ok: {Spec.optional_valid(~Spec.domain_valid, o) == True{} : Bool}) -> Spec.optional_payload_safe(o):
  match o:
    case None{}: Unit{}
    case Some{+s}: domain_safe(s, ok)

def expires_option_safe(+o: Maybe<&2, String>, ok: {Spec.optional_valid(~Spec.expires_valid, o) == True{} : Bool}) -> Spec.optional_payload_safe(o):
  match o:
    case None{}: Unit{}
    case Some{+s}: expires_safe(s, ok)

def age_option_safe(+o: Maybe<&2, C.MaxAge>) -> Spec.age_payload_safe(o):
  match o:
    case None{}: Unit{}
    case Some{+a}: Age.age_safe(a)

def site_option_safe(+o: Maybe<&2, C.SameSite>) -> Spec.site_payload_safe(o):
