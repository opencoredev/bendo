def both_equal(+a: Bool, +b: Bool, +c: Bool, +d: Bool, ab: {a == b : Bool}, cd: {c == d : Bool}) -> {a && c == b && d : Bool}:
  Equal.trans(Bool, a && c, b && c, b && d, Equal.cong(Bool, Bool, x => x && c, a, b, ab), Equal.cong(Bool, Bool, x => b && x, c, d, cd))

def token_tail_equiv(+s: String) -> {Bytes.token_tail(s) == Spec.token_tail(s) : Bool}:
  match s:
    case SNil{}: {==}
    case SCon{Chr{+c}, +t}:
      Equal.cong(Bool, Bool, x => Spec.tchar(c) && x, Bytes.token_tail(t), Spec.token_tail(t), token_tail_equiv(t))

def name_equiv(+s: String) -> {C.name_valid(s) == Spec.name_valid(s) : Bool}:
  match s:
    case SNil{}: {==}
    case SCon{Chr{+c}, +t}:
      Equal.cong(Bool, Bool, x => Spec.tchar(c) && x, Bytes.token_tail(t), Spec.token_tail(t), token_tail_equiv(t))

def value_equiv(+s: String) -> {C.value_valid(s) == Spec.value_valid(s) : Bool}:
  match s:
    case SNil{}: {==}
    case SCon{Chr{+c}, +t}:
      Equal.cong(Bool, Bool, x => Spec.octet(c) && x, C.value_valid(t), Spec.value_valid(t), value_equiv(t))

def attribute_equiv(+s: String) -> {C.attribute(s) == Spec.attribute(s) : Bool}:
  match s:
    case SNil{}: {==}
    case SCon{Chr{+c}, +t}:
      Equal.cong(Bool, Bool, x => (c >= 32 : U32) && (c <= 126 : U32) && U32.is_ne(c, 59) && x, C.attribute(t), Spec.attribute(t), attribute_equiv(t))

def path_char_equiv(c: U32, +t: String) -> {C.path_body(SCon{Chr{c}, t}) == Spec.path_body(SCon{Chr{c}, t}) : Bool}:
  match c:
    case U32{WCon{False{}, _}}: {==}
    case U32{WCon{True{}, WCon{False{}, _}}}: {==}
    case U32{WCon{True{}, WCon{True{}, WCon{False{}, _}}}}: {==}
    case U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, _}}}}}: {==}
    case U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, _}}}}}}: {==}
    case U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, _}}}}}}}: {==}
