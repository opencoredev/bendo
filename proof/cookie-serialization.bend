    case None{}: Unit{}
    case Some{C.Strict{}}: cons_safe(83, "trict", printable_safe(83, {==}, {==}), cons_safe(116, "rict", printable_safe(116, {==}, {==}), cons_safe(114, "ict", printable_safe(114, {==}, {==}), cons_safe(105, "ct", printable_safe(105, {==}, {==}), cons_safe(99, "t", printable_safe(99, {==}, {==}), cons_safe(116, "", printable_safe(116, {==}, {==}), Unit{}))))))
    case Some{C.Lax{}}: cons_safe(76, "ax", printable_safe(76, {==}, {==}), cons_safe(97, "x", printable_safe(97, {==}, {==}), cons_safe(120, "", printable_safe(120, {==}, {==}), Unit{})))
    case Some{C.NoRestriction{}}: cons_safe(78, "one", printable_safe(78, {==}, {==}), cons_safe(111, "ne", printable_safe(111, {==}, {==}), cons_safe(110, "e", printable_safe(110, {==}, {==}), cons_safe(101, "", printable_safe(101, {==}, {==}), Unit{}))))

def Laws.admissible_payloads_safe(name, value, options, ok):
  match options:
    case C.Options{+p, +d, +a, +e, +secure, h, +site, +part}:
      +e0 = ok
      +e1 = U.and_right(Spec.name_valid(name), Spec.value_valid(value) && (Spec.optional_valid(~Spec.path_valid, p) && (Spec.optional_valid(~Spec.domain_valid, d) && (Spec.optional_valid(~Spec.expires_valid, e) && ((Bool.not(Spec.unrestricted(site)) || secure) && ((Bool.not(part) || secure)))))), e0)
      +e2 = U.and_right(Spec.value_valid(value), Spec.optional_valid(~Spec.path_valid, p) && (Spec.optional_valid(~Spec.domain_valid, d) && (Spec.optional_valid(~Spec.expires_valid, e) && ((Bool.not(Spec.unrestricted(site)) || secure) && ((Bool.not(part) || secure))))), e1)
      +e3 = U.and_right(Spec.optional_valid(~Spec.path_valid, p), Spec.optional_valid(~Spec.domain_valid, d) && (Spec.optional_valid(~Spec.expires_valid, e) && ((Bool.not(Spec.unrestricted(site)) || secure) && ((Bool.not(part) || secure)))), e2)
      +e4 = U.and_right(Spec.optional_valid(~Spec.domain_valid, d), Spec.optional_valid(~Spec.expires_valid, e) && ((Bool.not(Spec.unrestricted(site)) || secure) && ((Bool.not(part) || secure))), e3)
      path = U.and_left(Spec.optional_valid(~Spec.path_valid, p), Spec.optional_valid(~Spec.domain_valid, d) && (Spec.optional_valid(~Spec.expires_valid, e) && ((Bool.not(Spec.unrestricted(site)) || secure) && ((Bool.not(part) || secure)))), e2)
      domain = U.and_left(Spec.optional_valid(~Spec.domain_valid, d), Spec.optional_valid(~Spec.expires_valid, e) && ((Bool.not(Spec.unrestricted(site)) || secure) && ((Bool.not(part) || secure))), e3)
      expires = U.and_left(Spec.optional_valid(~Spec.expires_valid, e), (Bool.not(Spec.unrestricted(site)) || secure) && ((Bool.not(part) || secure)), e4)
      (path_option_safe(p, path), (domain_option_safe(d, domain), (expires_option_safe(e, expires), (age_option_safe(a), site_option_safe(site)))))

def structure_finish(+name: String, +value: String, +options: C.Options, +output: String, evidence: {status(C.validate(name, value, options)) == True{} : Bool} & {output == Spec.wire(name, value, options) : String}) -> Spec.structure(name, value, options, output):
  (valid, exact) = evidence
  +admissible = Equal.trans(Bool, Spec.admissible(name, value, options), status(C.validate(name, value, options)), True{}, Equal.sym(Bool, status(C.validate(name, value, options)), Spec.admissible(name, value, options), validation_status(name, value, options)), valid)
  (admissible, (exact, Laws.admissible_payloads_safe(name, value, options, admissible)))

def Laws.serialize_structure(name, value, options, output, ok):
  structure_finish(name, value, options, output, converse(name, value, options, output, C.validate(name, value, options), ok))
