def weekday_analysis_Mon(+s: String) -> {C.weekday("Mon" ++ s) == Spec.weekday("Mon" ++ s) : Bool} & ({Spec.weekday("Mon" ++ s) == True{} : Bool} -> Spec.no_delimiters("Mon" ++ s)):
  match s:
    case SNil{}: ({==}, ok => cons_safe(77, "on", printable_safe(77, {==}, {==}), cons_safe(111, "n", printable_safe(111, {==}, {==}), cons_safe(110, "", printable_safe(110, {==}, {==}), Unit{}))))
    case SCon{h, t}: ({==}, ok => U.absurd(Spec.no_delimiters("Mon" ++ s), U.false_true(ok)))

