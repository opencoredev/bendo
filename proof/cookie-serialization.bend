def month_analysis_Sep(+s: String, +year: U32) -> {C.month_days("Sep" ++ s, year) == Spec.month_days("Sep" ++ s, year) : U32} & (Spec.no_delimiters("Sep" ++ s) | {Spec.month_days("Sep" ++ s, year) == 0 : U32}):
  match s:
    case SNil{}: ({==}, Inl{cons_safe(83, "ep", printable_safe(83, {==}, {==}), cons_safe(101, "p", printable_safe(101, {==}, {==}), cons_safe(112, "", printable_safe(112, {==}, {==}), Unit{})))})
    case SCon{h, t}: ({==}, Inr{{==}})

