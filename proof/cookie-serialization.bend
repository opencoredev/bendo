def weekday_analysis_Thu(+s: String) -> {C.weekday("Thu" ++ s) == Spec.weekday("Thu" ++ s) : Bool} & ({Spec.weekday("Thu" ++ s) == True{} : Bool} -> Spec.no_delimiters("Thu" ++ s)):
  match s:
    case SNil{}: ({==}, ok => cons_safe(84, "hu", printable_safe(84, {==}, {==}), cons_safe(104, "u", printable_safe(104, {==}, {==}), cons_safe(117, "", printable_safe(117, {==}, {==}), Unit{}))))
    case SCon{h, t}: ({==}, ok => U.absurd(Spec.no_delimiters("Thu" ++ s), U.false_true(ok)))

