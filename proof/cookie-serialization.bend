  match s:
    case SNil{}: ({==}, Inl{cons_safe(77, "ar", printable_safe(77, {==}, {==}), cons_safe(97, "r", printable_safe(97, {==}, {==}), cons_safe(114, "", printable_safe(114, {==}, {==}), Unit{})))})
    case SCon{h, t}: ({==}, Inr{{==}})

