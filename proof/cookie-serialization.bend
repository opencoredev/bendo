def month_analysis_Aug(+s: String, +year: U32) -> {C.month_days("Aug" ++ s, year) == Spec.month_days("Aug" ++ s, year) : U32} & (Spec.no_delimiters("Aug" ++ s) | {Spec.month_days("Aug" ++ s, year) == 0 : U32}):
  match s:
    case SNil{}: ({==}, Inl{cons_safe(65, "ug", printable_safe(65, {==}, {==}), cons_safe(117, "g", printable_safe(117, {==}, {==}), cons_safe(103, "", printable_safe(103, {==}, {==}), Unit{})))})
    case SCon{h, t}: ({==}, Inr{{==}})

