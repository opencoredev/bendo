def text_equiv(+key: String, +o: Maybe<&2, String>) -> {C.option_text(key, o) == Spec.option_text(key, o) : String}:
  match o:
    case None{}: {==}
    case Some{s}: {==}

def flag_equiv(+key: String, +b: Bool) -> {C.flag(key, b) == Spec.flag(key, b) : String}:
  match b:
    case False{}: {==}
    case True{}: {==}

def age_text_equiv(+a: C.MaxAge) -> {C.age_text(a) == Spec.age_text(a) : String}:
  match a:
    case C.Seconds{n}: {==}
    case C.NegativeSeconds{n}: {==}

def age_equiv(+o: Maybe<&2, C.MaxAge>) -> {C.age_option(o) == Spec.age_option(o) : String}:
  match o:
    case None{}: {==}
    case Some{+a}: Equal.cong(String, String, x => "; Max-Age=" ++ x, C.age_text(a), Spec.age_text(a), age_text_equiv(a))

def site_equiv(+o: Maybe<&2, C.SameSite>) -> {C.site_text(o) == Spec.site_text(o) : String}:
  match o:
    case None{}: {==}
    case Some{C.Strict{}}: {==}
    case Some{C.Lax{}}: {==}
    case Some{C.NoRestriction{}}: {==}

def suffix_equiv(+o: C.Options) -> {C.attributes(o) == Spec.suffix(o) : String}:
  match o:
    case C.Options{+p, +d, +a, +e, +sec, +h, +site, +part}:
      %text_equiv("Path", p) : {C.attributes(C.Options{p, d, a, e, sec, h, site, part}) == _ ++ Spec.option_text("Domain", d) ++ Spec.age_option(a) ++ Spec.option_text("Expires", e) ++ Spec.flag("Secure", sec) ++ Spec.flag("HttpOnly", h) ++ Spec.site_text(site) ++ Spec.flag("Partitioned", part) : String}
      %text_equiv("Domain", d) : {C.attributes(C.Options{p, d, a, e, sec, h, site, part}) == C.option_text("Path", p) ++ _ ++ Spec.age_option(a) ++ Spec.option_text("Expires", e) ++ Spec.flag("Secure", sec) ++ Spec.flag("HttpOnly", h) ++ Spec.site_text(site) ++ Spec.flag("Partitioned", part) : String}
      %age_equiv(a) : {C.attributes(C.Options{p, d, a, e, sec, h, site, part}) == C.option_text("Path", p) ++ C.option_text("Domain", d) ++ _ ++ Spec.option_text("Expires", e) ++ Spec.flag("Secure", sec) ++ Spec.flag("HttpOnly", h) ++ Spec.site_text(site) ++ Spec.flag("Partitioned", part) : String}
      %text_equiv("Expires", e) : {C.attributes(C.Options{p, d, a, e, sec, h, site, part}) == C.option_text("Path", p) ++ C.option_text("Domain", d) ++ C.age_option(a) ++ _ ++ Spec.flag("Secure", sec) ++ Spec.flag("HttpOnly", h) ++ Spec.site_text(site) ++ Spec.flag("Partitioned", part) : String}
      %flag_equiv("Secure", sec) : {C.attributes(C.Options{p, d, a, e, sec, h, site, part}) == C.option_text("Path", p) ++ C.option_text("Domain", d) ++ C.age_option(a) ++ C.option_text("Expires", e) ++ _ ++ Spec.flag("HttpOnly", h) ++ Spec.site_text(site) ++ Spec.flag("Partitioned", part) : String}
      %flag_equiv("HttpOnly", h) : {C.attributes(C.Options{p, d, a, e, sec, h, site, part}) == C.option_text("Path", p) ++ C.option_text("Domain", d) ++ C.age_option(a) ++ C.option_text("Expires", e) ++ C.flag("Secure", sec) ++ _ ++ Spec.site_text(site) ++ Spec.flag("Partitioned", part) : String}
      %site_equiv(site) : {C.attributes(C.Options{p, d, a, e, sec, h, site, part}) == C.option_text("Path", p) ++ C.option_text("Domain", d) ++ C.age_option(a) ++ C.option_text("Expires", e) ++ C.flag("Secure", sec) ++ C.flag("HttpOnly", h) ++ _ ++ Spec.flag("Partitioned", part) : String}
      %flag_equiv("Partitioned", part) : {C.attributes(C.Options{p, d, a, e, sec, h, site, part}) == C.option_text("Path", p) ++ C.option_text("Domain", d) ++ C.age_option(a) ++ C.option_text("Expires", e) ++ C.flag("Secure", sec) ++ C.flag("HttpOnly", h) ++ C.site_text(site) ++ _ : String}
      {==}

def path_option_equiv(+o: Maybe<&2, String>) -> {C.optional_valid(~C.path_valid, o) == Spec.optional_valid(~Spec.path_valid, o) : Bool}:
  match o:
    case None{}: {==}
    case Some{s}: path_equiv(s)

def domain_option_equiv(+o: Maybe<&2, String>) -> {C.optional_valid(~C.domain_valid, o) == Spec.optional_valid(~Spec.domain_valid, o) : Bool}:
  match o:
    case None{}: {==}
    case Some{s}: domain_equiv(s)

def expires_option_equiv(+o: Maybe<&2, String>) -> {C.optional_valid(~C.expires_valid, o) == Spec.optional_valid(~Spec.expires_valid, o) : Bool}:
  match o:
    case None{}: {==}
    case Some{s}: expires_equiv(s)

def status(r: Result<&2, &2, C.Error, Unit>) -> Bool:
  match r:
    case Fail{e}: False{}
    case Done{u}: True{}

def flags(a: Bool, b: Bool, c: Bool, d: Bool, e: Bool, f: Bool, g: Bool) -> Result<&2, &2, C.Error, Unit>:
  C.require(a, C.InvalidName{}, C.require(b, C.InvalidValue{}, C.require(c, C.InvalidPath{}, C.require(d, C.InvalidDomain{}, C.require(e, C.InvalidExpires{}, C.require(f, C.SameSiteRequiresSecure{}, C.require(g, C.PartitionedRequiresSecure{}, Done{Unit{}})))))))

def flags_status(+a: Bool, +b: Bool, +c: Bool, +d: Bool, +e: Bool, +f: Bool, +g: Bool) -> {status(flags(a, b, c, d, e, f, g)) == a && (b && (c && (d && (e && (f && g))))) : Bool}:
  match a b c d e f g:
    case False{} _ _ _ _ _ _: {==}
    case True{} False{} _ _ _ _ _: {==}
    case True{} True{} False{} _ _ _ _: {==}
    case True{} True{} True{} False{} _ _ _: {==}
    case True{} True{} True{} True{} False{} _ _: {==}
    case True{} True{} True{} True{} True{} False{} _: {==}
    case True{} True{} True{} True{} True{} True{} False{}: {==}
    case True{} True{} True{} True{} True{} True{} True{}: {==}

def unrestricted_equiv(+site: Maybe<&2, C.SameSite>) -> {C.unrestricted(site) == Spec.unrestricted(site) : Bool}:
  match site:
    case None{}: {==}
    case Some{C.Strict{}}: {==}
    case Some{C.Lax{}}: {==}
    case Some{C.NoRestriction{}}: {==}

def validation_flags_status(+name: String, +value: String, +p: Maybe<&2, String>, +d: Maybe<&2, String>, +e: Bool, +f: Bool, +g: Bool) -> {status(flags(C.name_valid_fast(name), C.value_valid_fast(value), C.optional_valid(~C.path_valid_fast, p), C.optional_valid(~C.domain_valid_fast, d), e, f, g)) == C.name_valid(name) && (C.value_valid(value) && (C.optional_valid(~C.path_valid, p) && (C.optional_valid(~C.domain_valid, d) && (e && (f && g))))) : Bool}:
  %Equal.sym(Bool, C.name_valid_fast(name), C.name_valid(name), Fast.name_fast(name)) : {status(flags(_, C.value_valid_fast(value), C.optional_valid(~C.path_valid_fast, p), C.optional_valid(~C.domain_valid_fast, d), e, f, g)) == C.name_valid(name) && (C.value_valid(value) && (C.optional_valid(~C.path_valid, p) && (C.optional_valid(~C.domain_valid, d) && (e && (f && g))))) : Bool}
  %Equal.sym(Bool, C.value_valid_fast(value), C.value_valid(value), Fast.valid_fast(value)) : {status(flags(C.name_valid(name), _, C.optional_valid(~C.path_valid_fast, p), C.optional_valid(~C.domain_valid_fast, d), e, f, g)) == C.name_valid(name) && (C.value_valid(value) && (C.optional_valid(~C.path_valid, p) && (C.optional_valid(~C.domain_valid, d) && (e && (f && g))))) : Bool}
  %Equal.sym(Bool, C.optional_valid(~C.path_valid_fast, p), C.optional_valid(~C.path_valid, p), Fast.path_option_fast(p)) : {status(flags(C.name_valid(name), C.value_valid(value), _, C.optional_valid(~C.domain_valid_fast, d), e, f, g)) == C.name_valid(name) && (C.value_valid(value) && (C.optional_valid(~C.path_valid, p) && (C.optional_valid(~C.domain_valid, d) && (e && (f && g))))) : Bool}
  %Equal.sym(Bool, C.optional_valid(~C.domain_valid_fast, d), C.optional_valid(~C.domain_valid, d), Fast.domain_option_fast(d)) : {status(flags(C.name_valid(name), C.value_valid(value), C.optional_valid(~C.path_valid, p), _, e, f, g)) == C.name_valid(name) && (C.value_valid(value) && (C.optional_valid(~C.path_valid, p) && (C.optional_valid(~C.domain_valid, d) && (e && (f && g))))) : Bool}
  flags_status(C.name_valid(name), C.value_valid(value), C.optional_valid(~C.path_valid, p), C.optional_valid(~C.domain_valid, d), e, f, g)

def validation_status(+name: String, +value: String, +options: C.Options) -> {status(C.validate(name, value, options)) == Spec.admissible(name, value, options) : Bool}:
  match options:
    case C.Options{+p, +d, a, +e, +secure, h, +site, +part}:
      %name_equiv(name) : {status(C.validate(name, value, C.Options{p, d, a, e, secure, h, site, part})) == _ && (Spec.value_valid(value) && (Spec.optional_valid(~Spec.path_valid, p) && (Spec.optional_valid(~Spec.domain_valid, d) && (Spec.optional_valid(~Spec.expires_valid, e) && ((Bool.not(Spec.unrestricted(site)) || secure) && ((Bool.not(part) || secure))))))) : Bool}
      %value_equiv(value) : {status(C.validate(name, value, C.Options{p, d, a, e, secure, h, site, part})) == C.name_valid(name) && (_ && (Spec.optional_valid(~Spec.path_valid, p) && (Spec.optional_valid(~Spec.domain_valid, d) && (Spec.optional_valid(~Spec.expires_valid, e) && ((Bool.not(Spec.unrestricted(site)) || secure) && ((Bool.not(part) || secure))))))) : Bool}
      %path_option_equiv(p) : {status(C.validate(name, value, C.Options{p, d, a, e, secure, h, site, part})) == C.name_valid(name) && (C.value_valid(value) && (_ && (Spec.optional_valid(~Spec.domain_valid, d) && (Spec.optional_valid(~Spec.expires_valid, e) && ((Bool.not(Spec.unrestricted(site)) || secure) && ((Bool.not(part) || secure))))))) : Bool}
      %domain_option_equiv(d) : {status(C.validate(name, value, C.Options{p, d, a, e, secure, h, site, part})) == C.name_valid(name) && (C.value_valid(value) && (C.optional_valid(~C.path_valid, p) && (_ && (Spec.optional_valid(~Spec.expires_valid, e) && ((Bool.not(Spec.unrestricted(site)) || secure) && ((Bool.not(part) || secure))))))) : Bool}
      %expires_option_equiv(e) : {status(C.validate(name, value, C.Options{p, d, a, e, secure, h, site, part})) == C.name_valid(name) && (C.value_valid(value) && (C.optional_valid(~C.path_valid, p) && (C.optional_valid(~C.domain_valid, d) && (_ && ((Bool.not(Spec.unrestricted(site)) || secure) && ((Bool.not(part) || secure))))))) : Bool}
      %unrestricted_equiv(site) : {status(C.validate(name, value, C.Options{p, d, a, e, secure, h, site, part})) == C.name_valid(name) && (C.value_valid(value) && (C.optional_valid(~C.path_valid, p) && (C.optional_valid(~C.domain_valid, d) && (C.optional_valid(~C.expires_valid, e) && ((Bool.not(_) || secure) && (Bool.not(part) || secure)))))) : Bool}
      validation_flags_status(name, value, p, d, C.optional_valid(~C.expires_valid, e), (Bool.not(C.unrestricted(site)) || secure), (Bool.not(part) || secure))

def successful(+name: String, +value: String, +options: C.Options, checked: Result<&2, &2, C.Error, Unit>, ok: {status(checked) == True{} : Bool}) -> {C.serialize_checked(name, value, options, checked) == Done{Spec.wire(name, value, options)} : Result<&2, &2, C.Error, String>}:
  match checked:
    case Fail{error}: U.absurd({C.serialize_checked(name, value, options, Fail{error}) == Done{Spec.wire(name, value, options)} : Result<&2, &2, C.Error, String>}, U.false_true(ok))
    case Done{u}:
      Equal.cong(String, Result<&2, &2, C.Error, String>, s => Done{s}, C.serialize_pair(name, value) ++ C.attributes(options), Spec.wire(name, value, options), Equal.cong(String, String, s => (name ++ "=" ++ value) ++ s, C.attributes(options), Spec.suffix(options), suffix_equiv(options)))

def Laws.serialize_exact(name, value, options, ok):
  successful(name, value, options, C.validate(name, value, options), Equal.trans(Bool, status(C.validate(name, value, options)), Spec.admissible(name, value, options), True{}, validation_status(name, value, options), ok))

# Discriminate result constructors without extracting anything from a failure.
def result_status(r: Result<&2, &2, C.Error, String>) -> Bool:
  match r:
    case Fail{e}: False{}
    case Done{s}: True{}

def result_text(r: Result<&2, &2, C.Error, String>) -> String:
  match r:
    case Fail{e}: ""
    case Done{s}: s

def converse(+name: String, +value: String, +options: C.Options, +output: String, checked: Result<&2, &2, C.Error, Unit>, ok: {C.serialize_checked(name, value, options, checked) == Done{output} : Result<&2, &2, C.Error, String>}) -> {status(checked) == True{} : Bool} & {output == Spec.wire(name, value, options) : String}:
  match checked:
    case Fail{error}:
      U.absurd({False{} == True{} : Bool} & {output == Spec.wire(name, value, options) : String}, U.false_true(Equal.cong(Result<&2, &2, C.Error, String>, Bool, r => result_status(r), Fail{error}, Done{output}, ok)))
    case Done{u}:
      ({==}, Equal.trans(String, output, C.serialize_pair(name, value) ++ C.attributes(options), Spec.wire(name, value, options), Equal.sym(String, C.serialize_pair(name, value) ++ C.attributes(options), output, Equal.cong(Result<&2, &2, C.Error, String>, String, r => result_text(r), Done{C.serialize_pair(name, value) ++ C.attributes(options)}, Done{output}, ok)), Equal.cong(String, String, s => (name ++ "=" ++ value) ++ s, C.attributes(options), Spec.suffix(options), suffix_equiv(options))))

# A false predicate at a forbidden character contradicts its admissibility.
def attribute_step(+c: U32, +t: String, +ok: {((c >= 32 : U32) && (c <= 126 : U32) && U32.is_ne(c, 59)) && Spec.attribute(t) == True{} : Bool}, tail: Spec.no_delimiters(t)) -> Spec.no_delimiters(SCon{Chr{c}, t}):
  +head = U.and_left((c >= 32 : U32) && (c <= 126 : U32) && U32.is_ne(c, 59), Spec.attribute(t), ok)
  +lower = U.and_left((c >= 32 : U32), (c <= 126 : U32), U.and_left((c >= 32 : U32) && (c <= 126 : U32), U32.is_ne(c, 59), head))
  semi = U.and_right((c >= 32 : U32) && (c <= 126 : U32), U32.is_ne(c, 59), head)
  (same => exclude(~(x => U32.is_ne(x, 59)), c, 59, semi, {==}, same), (same => exclude(~(x => (x >= 32 : U32)), c, 13, lower, {==}, same), (same => exclude(~(x => (x >= 32 : U32)), c, 10, lower, {==}, same), tail)))

def Laws.attribute_no_delimiters(s, ok):
  match s:
    case SNil{}: Unit{}
    case SCon{Chr{+c}, +t}:
      +ok = ok
      attribute_step(c, t, ok, Laws.attribute_no_delimiters(t, U.and_right((c >= 32 : U32) && (c <= 126 : U32) && U32.is_ne(c, 59), Spec.attribute(t), ok)))

# The one-character witness has Unit as its tail; splice in any safe suffix.
def append_safe(+s: String, +t: String, se: Spec.no_delimiters(s), te: Spec.no_delimiters(t)) -> Spec.no_delimiters(s ++ t):
  match s:
    case SNil{}: te
    case SCon{Chr{+c}, +rest}:
      (semi, more) = se
      (cr, more) = more
      (lf, tail) = more
      (semi, (cr, (lf, append_safe(rest, t, tail, te))))

def domain_character(+c: U32) -> Bool:
  ((c >= 48 : U32) && (c <= 57 : U32)) || ((c >= 65 : U32) && (c <= 90 : U32)) || ((c >= 97 : U32) && (c <= 122 : U32)) || U32.is_eq(c, 45)

def domain_character_safe(+c: U32, +ok: {domain_character(c) == True{} : Bool}) -> Spec.no_delimiters(SCon{Chr{c}, ""}):
  (same => exclude(~(x => domain_character(x)), c, 59, ok, {==}, same), (same => exclude(~(x => domain_character(x)), c, 13, ok, {==}, same), (same => exclude(~(x => domain_character(x)), c, 10, ok, {==}, same), Unit{})))

def digit_safe(+c: U32, +ok: {Spec.digit(c) == True{} : Bool}) -> Spec.no_delimiters(SCon{Chr{c}, ""}):
  (same => exclude(~(x => Spec.digit(x)), c, 59, ok, {==}, same), (same => exclude(~(x => Spec.digit(x)), c, 13, ok, {==}, same), (same => exclude(~(x => Spec.digit(x)), c, 10, ok, {==}, same), Unit{})))

def domain_chars_safe(+s: String, ok: {Spec.domain_chars(s) == True{} : Bool}) -> Spec.no_delimiters(s):
  match s:
    case SNil{}: Unit{}
    case SCon{Chr{+c}, +t}:
      +ok = ok
      cons_safe(c, t, domain_character_safe(c, U.and_left(domain_character(c), Spec.domain_chars(t), ok)), domain_chars_safe(t, U.and_right(domain_character(c), Spec.domain_chars(t), ok)))

def label_safe(+s: String, ok: {Spec.label_valid(s) == True{} : Bool}) -> Spec.no_delimiters(s):
  domain_chars_safe(s, U.and_right(Bool.not(String.is_empty(s)) && Bool.not(String.starts_with(s, "-")) && Bool.not(String.ends_with(s, "-")) && (String.length(s) <= 63n : Nat), Spec.domain_chars(s), ok))

def pieces_safe(xs: List<&2, String>) -> Type:
  match xs:
    case Nil{}: Unit
    case h <> t: Spec.no_delimiters(h) & pieces_safe(t)

def labels_safe(+xs: List<&2, String>, ok: {Spec.labels_valid(xs) == True{} : Bool}) -> pieces_safe(xs):
  match xs:
    case Nil{}: Unit{}
    case +h <> +t:
      +ok = ok
      (label_safe(h, U.and_left(Spec.label_valid(h), Spec.labels_valid(t), ok)), labels_safe(t, U.and_right(Spec.label_valid(h), Spec.labels_valid(t), ok)))

# Local equality reflection avoids importing the root-law proof graph.
def cmp_fin_tail(a: Bool, b: Bool, c: Cmp, e: {Cmp.is_eq(Word.cmp.fin(a, b, c)) == True{} : Bool}) -> {Cmp.is_eq(c) == True{} : Bool}:
  match c:
    case LT{}:
      e
    case EQ{}:
      {==}
    case GT{}:
      e

def word_cmp_self(+n: Nat, +a: Word(n)) -> {Word.cmp(n, a, a) == EQ{} : Cmp}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match a:
        case WCon{False{}, t}:
          %word_cmp_self(p, t) : {Word.cmp.fin(False{}, False{}, Word.cmp(p, t, t)) == Word.cmp.fin(False{}, False{}, _) : Cmp}
          {==}
        case WCon{True{}, t}:
          %word_cmp_self(p, t) : {Word.cmp.fin(True{}, True{}, Word.cmp(p, t, t)) == Word.cmp.fin(True{}, True{}, _) : Cmp}
          {==}

def word_head(p: Nat, ah: Bool, bh: Bool, +at: Word(p)) -> {Cmp.is_eq(Bool.cmp(ah, bh)) == True{} : Bool} -> {WCon{ah, at} == WCon{bh, at} : Word(1n+p)}:
  match ah bh:
    case False{} False{}:
      e => {==}
    case False{} True{}:
      e => U.absurd({WCon{False{}, at} == WCon{True{}, at} : Word(1n+p)}, U.false_true(e))
    case True{} False{}:
      e => U.absurd({WCon{True{}, at} == WCon{False{}, at} : Word(1n+p)}, U.false_true(e))
    case True{} True{}:
      e => {==}

def word_step(+p: Nat, +ah: Bool, +bh: Bool, +at: Word(p), +bt: Word(p), tail: {at == bt : Word(p)}) -> {Cmp.is_eq(Word.cmp.fin(ah, bh, Word.cmp(p, at, bt))) == True{} : Bool} -> {WCon{ah, at} == WCon{bh, bt} : Word(1n+p)}:
  %tail : {Cmp.is_eq(Word.cmp.fin(ah, bh, Word.cmp(p, at, _))) == True{} : Bool} -> {WCon{ah, at} == WCon{bh, _} : Word(1n+p)}
  %Equal.sym(Cmp, Word.cmp(p, at, at), EQ{}, word_cmp_self(p, at)) : {Cmp.is_eq(Word.cmp.fin(ah, bh, _)) == True{} : Bool} -> {WCon{ah, at} == WCon{bh, at} : Word(1n+p)}
  word_head(p, ah, bh, at)

def word_eq_sound(+n: Nat, +a: Word(n), +b: Word(n), +e: {Cmp.is_eq(Word.cmp(n, a, b)) == True{} : Bool}) -> {a == b : Word(n)}:
  match n:
    case 0n:
      match a b:
        case WNil{} WNil{}:
          {==}
    case 1n+p:
      match a b:
        case WCon{ah, at} WCon{bh, bt}:
          tail = word_eq_sound(p, at, bt, cmp_fin_tail(ah, bh, Word.cmp(p, at, bt), e))
          word_step(p, ah, bh, at, bt, tail, e)

def u32_eq_sound(+a: U32, +b: U32, +e: {U32.is_eq(a, b) == True{} : Bool}) -> {a == b : U32}:
  match a b:
    case U32{x} U32{y}:
      Equal.cong(Word(32n), U32, w => U32{w}, x, y, word_eq_sound(32n, x, y, e))


def char_equal(+c: Char, ok: {Char.is_eq(c, '.') == True{} : Bool}) -> {c == '.' : Char}:
  match c:
    case Chr{+n}: Equal.cong(U32, Char, x => Chr{x}, n, 46, u32_eq_sound(n, 46, ok))

def push_pieces_safe(+c: Char, +xs: List<&2, String>, ok: pieces_safe(String.split.push(c, xs))) -> Spec.no_delimiters(SCon{c, ""}) & pieces_safe(xs):
  match c:
    case Chr{+n}:
      match xs:
        case Nil{}:
          (head, rest) = ok
          (head, Unit{})
        case +h <> +t:
          (head, rest) = ok
          (semi, more) = head
          (cr, more) = more
          (lf, tail) = more
          ((semi, (cr, (lf, Unit{}))), (tail, rest))

def cut_pieces_safe(+c: Char, +xs: List<&2, String>, cut: Bool, same: {Char.is_eq(c, '.') == cut : Bool}, ok: pieces_safe(String.split.fin(c, xs, cut))) -> Spec.no_delimiters(SCon{c, ""}) & pieces_safe(xs):
  match cut:
    case False{}: push_pieces_safe(c, xs, ok)
    case True{}:
      (empty, rest) = ok
      %Equal.sym(Char, c, '.', char_equal(c, same)) : Spec.no_delimiters(SCon{_, ""}) & pieces_safe(xs)
      (printable_safe(46, {==}, {==}), rest)

def split_safe_finish(+c: Char, +t: String, evidence: Spec.no_delimiters(SCon{c, ""}) & pieces_safe(String.split(t, '.')), step: pieces_safe(String.split(t, '.')) -> Spec.no_delimiters(t)) -> Spec.no_delimiters(SCon{c, t}):
  match c:
    case Chr{+n}:
      (head, tail) = evidence
      cons_safe(n, t, head, step(tail))

def split_safe(+s: String, ok: pieces_safe(String.split(s, '.'))) -> Spec.no_delimiters(s):
  match s:
    case SNil{}: Unit{}
    case SCon{+c, +t}:
      split_safe_finish(c, t, cut_pieces_safe(c, String.split(t, '.'), Char.is_eq(c, '.'), {==}, ok), e => split_safe(t, e))

def path_char_safe(c: U32, +t: String, ok: {Spec.path_body(SCon{Chr{c}, t}) == True{} : Bool}) -> Spec.no_delimiters(SCon{Chr{c}, t}):
  match c:
    case U32{WCon{False{}, w}}: U.absurd(Spec.no_delimiters(SCon{Chr{U32{WCon{False{}, w}}}, t}), U.false_true(ok))
    case U32{WCon{True{}, WCon{False{}, w}}}: U.absurd(Spec.no_delimiters(SCon{Chr{U32{WCon{True{}, WCon{False{}, w}}}}, t}), U.false_true(ok))
    case U32{WCon{True{}, WCon{True{}, WCon{False{}, w}}}}: U.absurd(Spec.no_delimiters(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{False{}, w}}}}}, t}), U.false_true(ok))
