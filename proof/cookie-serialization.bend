def month_analysis_Apr(+s: String, +year: U32) -> {C.month_days("Apr" ++ s, year) == Spec.month_days("Apr" ++ s, year) : U32} & (Spec.no_delimiters("Apr" ++ s) | {Spec.month_days("Apr" ++ s, year) == 0 : U32}):
  match s:
    case SNil{}: ({==}, Inl{cons_safe(65, "pr", printable_safe(65, {==}, {==}), cons_safe(112, "r", printable_safe(112, {==}, {==}), cons_safe(114, "", printable_safe(114, {==}, {==}), Unit{})))})
    case SCon{h, t}: ({==}, Inr{{==}})

