# Proofs of ws_decode_sound and ws_decode_valid. Does not import LAWS.bend.
# Generated by scripts/ws-frame-proofs/gen-decode.py, one lemma per decoder
# stage. Each stage lemma states, for every input, that what the stage returns
# re-encodes to the bytes it was given and is valid for the role, or else is
# not a frame at all (`holds`). Branches that reject are then `{==}`.
import Base
import ./ws-frame-spec.bend as S
import ./ws-frame.bend as P
import ./ws-frame-roundtrip.bend as R
import ./ws-frame-laws.bend as WL
import ./utf8.bend as UP
import ./chunked-arith.bend as A
import ../src/data/utf8.bend as Utf8
import ../src/ws/frame.bend as F

type Seen is Data:
  Seen{wire: List<&2, U32>, ok: Bool}

def got(d: F.Decoded) -> Bool:
  match d:
    case F.NeedMore{_}:
      False{}
    case F.Partial{_}:
      False{}
    case F.Got{_, _, _}:
      True{}
    case F.Reject{_}:
      False{}

# What a decoder result claims about the bytes `xs` it read: a frame and the
# bytes after it re-encode to xs, and the frame is valid for the role.
def seen(role: F.Role, max: U32, +xs: List<&2, U32>, d: F.Decoded) -> Seen:
  match d:
    case F.NeedMore{_}:
      Seen{xs, False{}}
    case F.Partial{_}:
      Seen{xs, False{}}
    case F.Got{+f, +k, rest}:
      Seen{List.append(&2, U32, F.encode_raw(f, k), rest), S.valid(max, f, k) && S.peer_key(role, k)}
    case F.Reject{_}:
      Seen{xs, False{}}

def holds(role: F.Role, max: U32, +xs: List<&2, U32>, +d: F.Decoded) -> Type:
  {seen(role, max, xs, d) == Seen{xs, got(d)} : Seen}

def seen_wire(s: Seen) -> List<&2, U32>:
  match s:
    case Seen{w, _}:
      w

def seen_ok(s: Seen) -> Bool:
  match s:
    case Seen{_, o}:
      o

def seen_eq(+a: List<&2, U32>, +b: Bool, +c: List<&2, U32>, +d: Bool, e1: {a == c : List<&2, U32>}, e2: {b == d : Bool}) -> {Seen{a, b} == Seen{c, d} : Seen}:
  %e1 : {Seen{a, b} == Seen{_, d} : Seen}
  %e2 : {Seen{a, b} == Seen{a, _} : Seen}
  {==}

# Words and U32s.

def cmp_fin_tail(a: Bool, b: Bool, c: Cmp, e: {Cmp.is_eq(Word.cmp.fin(a, b, c)) == True{} : Bool}) -> {Cmp.is_eq(c) == True{} : Bool}:
  match c:
    case LT{}:
      e
    case EQ{}:
      {==}
    case GT{}:
      e

def word_cmp_self(+n: Nat, +a: Word(n)) -> {Word.cmp(n, a, a) == EQ{} : Cmp}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match a:
        case WCon{False{}, t}:
          %word_cmp_self(p, t) : {Word.cmp.fin(False{}, False{}, Word.cmp(p, t, t)) == Word.cmp.fin(False{}, False{}, _) : Cmp}
          {==}
        case WCon{True{}, t}:
          %word_cmp_self(p, t) : {Word.cmp.fin(True{}, True{}, Word.cmp(p, t, t)) == Word.cmp.fin(True{}, True{}, _) : Cmp}
          {==}

def word_head(p: Nat, ah: Bool, bh: Bool, +at: Word(p)) -> {Cmp.is_eq(Bool.cmp(ah, bh)) == True{} : Bool} -> {WCon{ah, at} == WCon{bh, at} : Word(1n+p)}:
  match ah bh:
    case False{} False{}:
      e => {==}
    case False{} True{}:
      e => UP.absurd({WCon{False{}, at} == WCon{True{}, at} : Word(1n+p)}, UP.false_true(e))
    case True{} False{}:
      e => UP.absurd({WCon{True{}, at} == WCon{False{}, at} : Word(1n+p)}, UP.false_true(e))
    case True{} True{}:
      e => {==}

def word_step(+p: Nat, +ah: Bool, +bh: Bool, +at: Word(p), +bt: Word(p), tail: {at == bt : Word(p)}) -> {Cmp.is_eq(Word.cmp.fin(ah, bh, Word.cmp(p, at, bt))) == True{} : Bool} -> {WCon{ah, at} == WCon{bh, bt} : Word(1n+p)}:
  %tail : {Cmp.is_eq(Word.cmp.fin(ah, bh, Word.cmp(p, at, _))) == True{} : Bool} -> {WCon{ah, at} == WCon{bh, _} : Word(1n+p)}
  %Equal.sym(Cmp, Word.cmp(p, at, at), EQ{}, word_cmp_self(p, at)) : {Cmp.is_eq(Word.cmp.fin(ah, bh, _)) == True{} : Bool} -> {WCon{ah, at} == WCon{bh, at} : Word(1n+p)}
  word_head(p, ah, bh, at)

def word_eq_sound(+n: Nat, +a: Word(n), +b: Word(n), +e: {Cmp.is_eq(Word.cmp(n, a, b)) == True{} : Bool}) -> {a == b : Word(n)}:
  match n:
    case 0n:
      match a b:
        case WNil{} WNil{}:
          {==}
    case 1n+p:
      match a b:
        case WCon{ah, at} WCon{bh, bt}:
          tail = word_eq_sound(p, at, bt, cmp_fin_tail(ah, bh, Word.cmp(p, at, bt), e))
          word_step(p, ah, bh, at, bt, tail, e)

def u32_eq_sound(+a: U32, +b: U32, +e: {U32.is_eq(a, b) == True{} : Bool}) -> {a == b : U32}:
  match a b:
    case U32{x} U32{y}:
      Equal.cong(Word(32n), U32, w => U32{w}, x, y, word_eq_sound(32n, x, y, e))

def nat_eq_self(+n: Nat) -> {Nat.is_eq(n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      nat_eq_self(p)

def from_to_eq(+u: U32) -> {U32.is_eq(U32.from_nat(U32.to_nat(u)), u) == True{} : Bool}:
  %Equal.sym(Bool, U32.is_eq(U32.from_nat(U32.to_nat(u)), u), Nat.is_eq(U32.to_nat(U32.from_nat(U32.to_nat(u))), U32.to_nat(u)), A.u32_nat_eq(U32.from_nat(U32.to_nat(u)), u)) : {_ == True{} : Bool}
  %Equal.sym(Nat, U32.to_nat(U32.from_nat(U32.to_nat(u))), U32.to_nat(u), A.from_nat_exact(U32.to_nat(u), u, A.le_refl(U32.to_nat(u)))) : {Nat.is_eq(_, U32.to_nat(u)) == True{} : Bool}
  nat_eq_self(U32.to_nat(u))

# Converting a U32 to a Nat and back gives the same U32.
def from_to(+u: U32) -> {U32.from_nat(U32.to_nat(u)) == u : U32}:
  u32_eq_sound(U32.from_nat(U32.to_nat(u)), u, from_to_eq(u))

def not_true(+x: Bool, e: {Bool.not(x) == True{} : Bool}) -> {x == False{} : Bool}:
  match x:
    case False{}:
      {==}
    case True{}:
      UP.absurd({True{} == False{} : Bool}, UP.false_true(e))

def nat_fits(+n: U32, +max: U32, fits: {U32.is_le(n, max) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(n), U32.to_nat(max)) == True{} : Bool}:
  Equal.trans(Bool, Nat.is_le(U32.to_nat(n), U32.to_nat(max)), U32.is_le(n, max), True{}, Equal.sym(Bool, U32.is_le(n, max), Nat.is_le(U32.to_nat(n), U32.to_nat(max)), A.u32_nat_le(n, max)), fits)

def spec_octets(+q: List<&2, U32>, oq: {F.octets(q, True{}) == True{} : Bool}) -> {S.octets(q) == True{} : Bool}:
  Equal.trans(Bool, S.octets(q), F.octets(q, True{}), True{}, Equal.sym(Bool, F.octets(q, True{}), True{} && S.octets(q), P.octets_acc(q, True{})), oq)

# Facts the header stages hand to the payload stage.

def cv_short(+op: F.Opcode, +fin: Bool, +k: Nat, nf: {F.fragmented_control(F.is_control(op), fin) == False{} : Bool}, le: {Nat.is_le(k, 125n) == True{} : Bool}) -> {S.control_valid(op, fin, k) == True{} : Bool}:
  match op fin:
    case F.OpContinue{} _:
      {==}
    case F.OpText{} _:
      {==}
    case F.OpBinary{} _:
      {==}
    case F.OpClose{} True{}:
      le
    case F.OpClose{} False{}:
      UP.absurd({S.control_valid(F.OpClose{}, False{}, k) == True{} : Bool}, UP.false_true(Equal.sym(Bool, True{}, False{}, nf)))
    case F.OpPing{} True{}:
      le
    case F.OpPing{} False{}:
      UP.absurd({S.control_valid(F.OpPing{}, False{}, k) == True{} : Bool}, UP.false_true(Equal.sym(Bool, True{}, False{}, nf)))
    case F.OpPong{} True{}:
      le
    case F.OpPong{} False{}:
      UP.absurd({S.control_valid(F.OpPong{}, False{}, k) == True{} : Bool}, UP.false_true(Equal.sym(Bool, True{}, False{}, nf)))

def cv_data(+op: F.Opcode, +fin: Bool, +k: Nat, dat: {F.is_control(op) == False{} : Bool}) -> {S.control_valid(op, fin, k) == True{} : Bool}:
  match op:
    case F.OpContinue{}:
      {==}
    case F.OpText{}:
      {==}
    case F.OpBinary{}:
      {==}
    case F.OpClose{}:
      UP.absurd({S.control_valid(F.OpClose{}, fin, k) == True{} : Bool}, UP.false_true(Equal.sym(Bool, True{}, False{}, dat)))
    case F.OpPing{}:
      UP.absurd({S.control_valid(F.OpPing{}, fin, k) == True{} : Bool}, UP.false_true(Equal.sym(Bool, True{}, False{}, dat)))
    case F.OpPong{}:
      UP.absurd({S.control_valid(F.OpPong{}, fin, k) == True{} : Bool}, UP.false_true(Equal.sym(Bool, True{}, False{}, dat)))

def pk_none(+role: F.Role, rk: {F.role_mask(role, False{}) == True{} : Bool}) -> {S.peer_key(role, None{}) == True{} : Bool}:
  match role:
    case F.Server{}:
      UP.absurd({S.peer_key(F.Server{}, None{}) == True{} : Bool}, UP.false_true(rk))
    case F.Client{}:
      {==}

def pk_some(+role: F.Role, +k: F.Key, rk: {F.role_mask(role, True{}) == True{} : Bool}) -> {S.peer_key(role, Some{k}) == True{} : Bool}:
  match role:
    case F.Server{}:
      {==}
    case F.Client{}:
      UP.absurd({S.peer_key(F.Client{}, Some{k}) == True{} : Bool}, UP.false_true(rk))

# Payload stage. `take_n` and `drop_n` name the bytes the decoder read and the
# bytes it left.

def take_n(n: Nat, xs: List<&2, U32>) -> List<&2, U32>:
  match n:
    case 0n:
      []
    case 1n+p:
      match xs:
        case Nil{}:
          []
        case x <> t:
          x <> take_n(p, t)

def drop_n(n: Nat, xs: List<&2, U32>) -> List<&2, U32>:
  match n:
    case 0n:
      xs
    case 1n+p:
      match xs:
        case Nil{}:
          []
        case _ <> t:
          drop_n(p, t)

def split_n(+n: Nat, +xs: List<&2, U32>) -> {List.append(&2, U32, take_n(n, xs), drop_n(n, xs)) == xs : List<&2, U32>}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match xs:
        case Nil{}:
          {==}
        case +x <> t:
          Equal.cong(List<&2, U32>, List<&2, U32>, l => x <> l, List.append(&2, U32, take_n(p, t), drop_n(p, t)), t, split_n(p, t))

def is_took(t: F.Taken) -> Bool:
  match t:
    case F.Took{_, _, _}:
      True{}
    case F.Short{_, _, _, _}:
      False{}

def took_ok(t: F.Taken) -> Bool:
  match t:
    case F.Took{o, _, _}:
      o
    case F.Short{o, _, _, _}:
      o

def took_acc(t: F.Taken) -> List<&2, U32>:
  match t:
    case F.Took{_, acc, _}:
      acc
    case F.Short{_, _, _, acc}:
      acc

def took_rest(t: F.Taken) -> List<&2, U32>:
  match t:
    case F.Took{_, _, r}:
      r
    case F.Short{_, _, _, _}:
      []

# A finished read took exactly n bytes.
def plain_len(+n: Nat, +xs: List<&2, U32>, +acc: List<&2, U32>, +ok: Bool, e: {is_took(F.take_plain(n, xs, acc, ok)) == True{} : Bool}) -> {List.length(&2, U32, take_n(n, xs)) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match xs:
        case Nil{}:
          UP.absurd({0n == 1n+p : Nat}, UP.false_true(e))
        case +x <> t:
          Equal.cong(Nat, Nat, k => 1n+k, List.length(&2, U32, take_n(p, t)), p, plain_len(p, t, x <> acc, ok && F.is_octet(x), e))

def mask_len(+n: Nat, +xs: List<&2, U32>, +a: U32, +b: U32, +c: U32, +d: U32, +acc: List<&2, U32>, +ok: Bool, e: {is_took(F.take_mask(n, xs, a, b, c, d, acc, ok)) == True{} : Bool}) -> {List.length(&2, U32, take_n(n, xs)) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match xs:
        case Nil{}:
          UP.absurd({0n == 1n+p : Nat}, UP.false_true(e))
        case +x <> t:
          Equal.cong(Nat, Nat, k => 1n+k, List.length(&2, U32, take_n(p, t)), p, mask_len(p, t, b, c, d, a, U32.xor(x, a) <> acc, ok && F.is_octet(x), e))

# Unmasking any q, followed by any bytes, reads q and leaves the rest.
def take_mask_gen(+q: List<&2, U32>, +rest: List<&2, U32>, +a: U32, +b: U32, +c: U32, +d: U32, +acc: List<&2, U32>, +ok: Bool) -> {F.take_mask(List.length(&2, U32, q), List.append(&2, U32, q, rest), a, b, c, d, acc, ok) == F.Took{F.octets(q, ok), List.reverse.go(&2, U32, S.mask(q, F.MaskKey{a, b, c, d}), acc), rest} : F.Taken}:
  match q:
    case Nil{}:
      {==}
    case x <> t:
      take_mask_gen(t, rest, b, c, d, a, U32.xor(x, a) <> acc, ok && F.is_octet(x))

def plain_took(+len: Nat, +xs: List<&2, U32>, +q: List<&2, U32>, +dr: List<&2, U32>, ln: {List.length(&2, U32, q) == len : Nat}, sp: {List.append(&2, U32, q, dr) == xs : List<&2, U32>}) -> {F.take_plain(len, xs, [], True{}) == F.Took{F.octets(q, True{}), List.reverse.go(&2, U32, q, []), dr} : F.Taken}:
  %ln : {F.take_plain(_, xs, [], True{}) == F.Took{F.octets(q, True{}), List.reverse.go(&2, U32, q, []), dr} : F.Taken}
  %sp : {F.take_plain(List.length(&2, U32, q), _, [], True{}) == F.Took{F.octets(q, True{}), List.reverse.go(&2, U32, q, []), dr} : F.Taken}
  R.take_plain_append(q, dr, [], True{})

def mask_took(+len: Nat, +xs: List<&2, U32>, +q: List<&2, U32>, +dr: List<&2, U32>, +a: U32, +b: U32, +c: U32, +d: U32, ln: {List.length(&2, U32, q) == len : Nat}, sp: {List.append(&2, U32, q, dr) == xs : List<&2, U32>}) -> {F.take_mask(len, xs, a, b, c, d, [], True{}) == F.Took{F.octets(q, True{}), List.reverse.go(&2, U32, S.mask(q, F.MaskKey{a, b, c, d}), []), dr} : F.Taken}:
  %ln : {F.take_mask(_, xs, a, b, c, d, [], True{}) == F.Took{F.octets(q, True{}), List.reverse.go(&2, U32, S.mask(q, F.MaskKey{a, b, c, d}), []), dr} : F.Taken}
  %sp : {F.take_mask(List.length(&2, U32, q), _, a, b, c, d, [], True{}) == F.Took{F.octets(q, True{}), List.reverse.go(&2, U32, S.mask(q, F.MaskKey{a, b, c, d}), []), dr} : F.Taken}
  take_mask_gen(q, dr, a, b, c, d, [], True{})

def from_len(+q: List<&2, U32>, +n: U32, ln: {List.length(&2, U32, q) == U32.to_nat(n) : Nat}) -> {U32.from_nat(F.length(q)) == n : U32}:
  Equal.trans(U32, U32.from_nat(F.length(q)), U32.from_nat(U32.to_nat(n)), n, Equal.cong(Nat, U32, x => U32.from_nat(x), F.length(q), U32.to_nat(n), Equal.trans(Nat, F.length(q), List.length(&2, U32, q), U32.to_nat(n), P.length_eq(q), ln)), from_to(n))

# Unmasked payload: the frame is the header, then q; q and the rest are xs.
def plain_wire(+fin: Bool, +op: F.Opcode, +n: U32, +xs: List<&2, U32>, +q: List<&2, U32>, +dr: List<&2, U32>, +ln: {List.length(&2, U32, q) == U32.to_nat(n) : Nat}, sp: {List.append(&2, U32, q, dr) == xs : List<&2, U32>}) -> {List.append(&2, U32, F.encode_raw(F.Frame{fin, op, q}, None{}), dr) == F.first_byte(fin, op) <> List.append(&2, U32, F.header_with(None{}, n), xs) : List<&2, U32>}:
  %sp : {List.append(&2, U32, F.encode_raw(F.Frame{fin, op, q}, None{}), dr) == F.first_byte(fin, op) <> List.append(&2, U32, F.header_with(None{}, n), _) : List<&2, U32>}
  %from_len(q, n, ln) : {List.append(&2, U32, F.encode_raw(F.Frame{fin, op, q}, None{}), dr) == F.first_byte(fin, op) <> List.append(&2, U32, F.header_with(None{}, _), List.append(&2, U32, q, dr)) : List<&2, U32>}
  Equal.cong(List<&2, U32>, List<&2, U32>, x => F.first_byte(fin, op) <> x, List.append(&2, U32, List.append(&2, U32, F.header_with(None{}, U32.from_nat(F.length(q))), q), dr), List.append(&2, U32, F.header_with(None{}, U32.from_nat(F.length(q))), List.append(&2, U32, q, dr)), UP.append_assoc(U32, F.header_with(None{}, U32.from_nat(F.length(q))), q, dr))

def plain_ok(+role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, +n: U32, +q: List<&2, U32>, ln: {List.length(&2, U32, q) == U32.to_nat(n) : Nat}, oq: {F.octets(q, True{}) == True{} : Bool}, pk: {S.peer_key(role, None{}) == True{} : Bool}, cv: {S.control_valid(op, fin, U32.to_nat(n)) == True{} : Bool}, fits: {U32.is_le(n, max) == True{} : Bool}) -> {S.valid(max, F.Frame{fin, op, q}, None{}) && S.peer_key(role, None{}) == True{} : Bool}:
  %Equal.sym(Nat, List.length(&2, U32, q), U32.to_nat(n), ln) : {S.control_valid(op, fin, _) && Nat.is_le(_, U32.to_nat(max)) && S.key_valid(None{}) && S.octets(q) && S.peer_key(role, None{}) == True{} : Bool}
  %Equal.sym(Bool, S.control_valid(op, fin, U32.to_nat(n)), True{}, cv) : {_ && Nat.is_le(U32.to_nat(n), U32.to_nat(max)) && True{} && S.octets(q) && S.peer_key(role, None{}) == True{} : Bool}
  %Equal.sym(Bool, Nat.is_le(U32.to_nat(n), U32.to_nat(max)), True{}, nat_fits(n, max, fits)) : {True{} && _ && True{} && S.octets(q) && S.peer_key(role, None{}) == True{} : Bool}
  %Equal.sym(Bool, S.octets(q), True{}, spec_octets(q, oq)) : {True{} && True{} && True{} && _ && S.peer_key(role, None{}) == True{} : Bool}
  %Equal.sym(Bool, S.peer_key(role, None{}), True{}, pk) : {True{} && True{} && True{} && True{} && _ == True{} : Bool}
  {==}

def plain_got(+role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, +n: U32, +xs: List<&2, U32>, +q: List<&2, U32>, +dr: List<&2, U32>, +ln: {List.length(&2, U32, q) == U32.to_nat(n) : Nat}, sp: {List.append(&2, U32, q, dr) == xs : List<&2, U32>}, oq: {F.octets(q, True{}) == True{} : Bool}, pk: {S.peer_key(role, None{}) == True{} : Bool}, cv: {S.control_valid(op, fin, U32.to_nat(n)) == True{} : Bool}, fits: {U32.is_le(n, max) == True{} : Bool}) -> holds(role, max, F.first_byte(fin, op) <> List.append(&2, U32, F.header_with(None{}, n), xs), F.Got{F.Frame{fin, op, q}, None{}, dr}):
  seen_eq(List.append(&2, U32, F.encode_raw(F.Frame{fin, op, q}, None{}), dr), S.valid(max, F.Frame{fin, op, q}, None{}) && S.peer_key(role, None{}), F.first_byte(fin, op) <> List.append(&2, U32, F.header_with(None{}, n), xs), True{}, plain_wire(fin, op, n, xs, q, dr, ln, sp), plain_ok(role, max, fin, op, n, q, ln, oq, pk, cv, fits))

def plain_took_case(+role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, +n: U32, +xs: List<&2, U32>, +acc: List<&2, U32>, +r: List<&2, U32>, +q: List<&2, U32>, +dr: List<&2, U32>, +ln: {List.length(&2, U32, q) == U32.to_nat(n) : Nat}, +sp: {List.append(&2, U32, q, dr) == xs : List<&2, U32>}, pk: {S.peer_key(role, None{}) == True{} : Bool}, cv: {S.control_valid(op, fin, U32.to_nat(n)) == True{} : Bool}, fits: {U32.is_le(n, max) == True{} : Bool}, et: {F.take_plain(U32.to_nat(n), xs, [], True{}) == F.Took{True{}, acc, r} : F.Taken}) -> holds(role, max, F.first_byte(fin, op) <> List.append(&2, U32, F.header_with(None{}, n), xs), F.Got{F.Frame{fin, op, List.reverse(&2, U32, acc)}, None{}, r}):
  +same = Equal.trans(F.Taken, F.Took{True{}, acc, r}, F.take_plain(U32.to_nat(n), xs, [], True{}), F.Took{F.octets(q, True{}), List.reverse.go(&2, U32, q, []), dr}, Equal.sym(F.Taken, F.take_plain(U32.to_nat(n), xs, [], True{}), F.Took{True{}, acc, r}, et), plain_took(U32.to_nat(n), xs, q, dr, ln, sp))
