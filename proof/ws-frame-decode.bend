      plain_leaf(role, max, fin, op, U32{w}, xs, pk_none(role, rk), cv, fits, F.take_plain(U32.to_nat(U32{w}), xs, [], True{}), {==})
    case True{}:
      match xs:
        case Nil{}:
          {==}
        case _ <> Nil{}:
          {==}
        case _ <> _ <> Nil{}:
          {==}
        case _ <> _ <> _ <> Nil{}:
          {==}
        case +a <> +b <> +c <> +d <> t:
          key_go(role, max, fin, op, w, a, b, c, d, t, rk, cv, fits, F.key_octet(d, F.key_octet(c, F.key_octet(b, F.key_octet(a, True{})))), {==})

# 16-bit length: two octets, big endian, above 125.
def le16(+x0: Bool, +x1: Bool, +x2: Bool, +x3: Bool, +x4: Bool, +x5: Bool, +x6: Bool, +x7: Bool, +h0: Bool, +h1: Bool, +h2: Bool, +h3: Bool, +h4: Bool, +h5: Bool, +h6: Bool, +h7: Bool) -> {U32.is_le(U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}, 65535) == True{} : Bool}:
  R.cmp_le_ones(16n, WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, WNil{}}}}}}}}}}}}}}}}})

def ext16_fits(+role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, +m: Bool, +h0: Bool, +h1: Bool, +h2: Bool, +h3: Bool, +h4: Bool, +h5: Bool, +h6: Bool, +h7: Bool, +x0: Bool, +x1: Bool, +x2: Bool, +x3: Bool, +x4: Bool, +x5: Bool, +x6: Bool, +x7: Bool, +t3: List<&2, U32>, rk: {F.role_mask(role, m) == True{} : Bool}, dat: {F.is_control(op) == False{} : Bool}, +emn: {Bool.not(U32.is_le(U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}, 125)) == True{} : Bool}, fz: Bool, efz: {U32.is_le(U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}, max) == fz : Bool}) -> holds(role, max, F.first_byte(fin, op) <> U32{WCon{False{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{m, Word.zero(24n)}}}}}}}}} <> U32{WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(24n)}}}}}}}}} <> U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, Word.zero(24n)}}}}}}}}} <> t3, F.sized(fz, m, fin, op, U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}, t3)):
  match fz:
    case False{}:
      {==}
    case True{}:
      %le16(x0, x1, x2, x3, x4, x5, x6, x7, h0, h1, h2, h3, h4, h5, h6, h7) : holds(role, max, F.first_byte(fin, op) <> List.append(&2, U32, F.length_bytes(m, WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}, False{}, _), t3), F.read_key(m, fin, op, U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}, t3))
      %not_true(U32.is_le(U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}, 125), emn) : holds(role, max, F.first_byte(fin, op) <> List.append(&2, U32, F.length_bytes(m, WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}, _, U32.is_le(U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}, 65535)), t3), F.read_key(m, fin, op, U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}, t3))
      key_stage(role, max, m, fin, op, WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}, t3, rk, cv_data(op, fin, U32.to_nat(U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}), dat), efz)

def ext16_min(+role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, +m: Bool, +h0: Bool, +h1: Bool, +h2: Bool, +h3: Bool, +h4: Bool, +h5: Bool, +h6: Bool, +h7: Bool, +x0: Bool, +x1: Bool, +x2: Bool, +x3: Bool, +x4: Bool, +x5: Bool, +x6: Bool, +x7: Bool, +t3: List<&2, U32>, rk: {F.role_mask(role, m) == True{} : Bool}, dat: {F.is_control(op) == False{} : Bool}, mn: Bool, emn: {Bool.not(U32.is_le(U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}, 125)) == mn : Bool}) -> holds(role, max, F.first_byte(fin, op) <> U32{WCon{False{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{m, Word.zero(24n)}}}}}}}}} <> U32{WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(24n)}}}}}}}}} <> U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, Word.zero(24n)}}}}}}}}} <> t3, F.minimal(mn, max, m, fin, op, U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}, t3)):
  match mn:
    case False{}:
      {==}
    case True{}:
      ext16_fits(role, max, fin, op, m, h0, h1, h2, h3, h4, h5, h6, h7, x0, x1, x2, x3, x4, x5, x6, x7, t3, rk, dat, emn, U32.is_le(U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}, max), {==})

def ext16_z(+role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, +m: Bool, +h0: Bool, +h1: Bool, +h2: Bool, +h3: Bool, +h4: Bool, +h5: Bool, +h6: Bool, +h7: Bool, +x0: Bool, +x1: Bool, +x2: Bool, +x3: Bool, +x4: Bool, +x5: Bool, +x6: Bool, +x7: Bool, +hh: Word(24n), +lh: Word(24n), +t3: List<&2, U32>, rk: {F.role_mask(role, m) == True{} : Bool}, dat: {F.is_control(op) == False{} : Bool}, z: Bool, +ez: {Utf8.zero(24n, hh) && Utf8.zero(24n, lh) == z : Bool}) -> holds(role, max, F.first_byte(fin, op) <> U32{WCon{False{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{m, Word.zero(24n)}}}}}}}}} <> U32{WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, hh}}}}}}}}} <> U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, lh}}}}}}}}} <> t3, F.octets_then(z, Bool.not(U32.is_le(U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}, 125)), max, m, fin, op, U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}, t3)):
  match z:
    case False{}:
      {==}
    case True{}:
      %Equal.sym(Word(24n), hh, Word.zero(24n), UP.zero_sound(24n, hh, UP.and_left(Utf8.zero(24n, hh), Utf8.zero(24n, lh), ez))) : holds(role, max, F.first_byte(fin, op) <> U32{WCon{False{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{m, Word.zero(24n)}}}}}}}}} <> U32{WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, _}}}}}}}}} <> U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, lh}}}}}}}}} <> t3, F.minimal(Bool.not(U32.is_le(U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}, 125)), max, m, fin, op, U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}, t3))
      %Equal.sym(Word(24n), lh, Word.zero(24n), UP.zero_sound(24n, lh, UP.and_right(Utf8.zero(24n, hh), Utf8.zero(24n, lh), ez))) : holds(role, max, F.first_byte(fin, op) <> U32{WCon{False{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{m, Word.zero(24n)}}}}}}}}} <> U32{WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(24n)}}}}}}}}} <> U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, _}}}}}}}}} <> t3, F.minimal(Bool.not(U32.is_le(U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}, 125)), max, m, fin, op, U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}, t3))
      ext16_min(role, max, fin, op, m, h0, h1, h2, h3, h4, h5, h6, h7, x0, x1, x2, x3, x4, x5, x6, x7, t3, rk, dat, Bool.not(U32.is_le(U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, Word.zero(16n)}}}}}}}}}}}}}}}}}, 125)), {==})

def ext16_stage(+role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, +m: Bool, +t: List<&2, U32>, rk: {F.role_mask(role, m) == True{} : Bool}, dat: {F.is_control(op) == False{} : Bool}) -> holds(role, max, F.first_byte(fin, op) <> U32{WCon{False{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.ext16(max, m, fin, op, t)):
  match t:
    case Nil{}:
      {==}
    case _ <> Nil{}:
      {==}
    case U32{WCon{h0, WCon{h1, WCon{h2, WCon{h3, WCon{h4, WCon{h5, WCon{h6, WCon{h7, hh}}}}}}}}} <> U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, lh}}}}}}}}} <> t3:
      ext16_z(role, max, fin, op, m, h0, h1, h2, h3, h4, h5, h6, h7, x0, x1, x2, x3, x4, x5, x6, x7, hh, lh, t3, rk, dat, Utf8.zero(24n, hh) && Utf8.zero(24n, lh), {==})

# 64-bit length: four zero octets, then four octets above 65535.
def le125_go(+n0: Bool, +n1: Bool, +n2: Bool, +n3: Bool, +n4: Bool, +n5: Bool, +n6: Bool, +hi: Word(25n), em: {U32.is_le(U32{WCon{n0, WCon{n1, WCon{n2, WCon{n3, WCon{n4, WCon{n5, WCon{n6, hi}}}}}}}}, 65535) == False{} : Bool}, s: Bool, es: {U32.is_le(U32{WCon{n0, WCon{n1, WCon{n2, WCon{n3, WCon{n4, WCon{n5, WCon{n6, hi}}}}}}}}, 125) == s : Bool}) -> {s == False{} : Bool}:
  match s:
    case False{}:
      {==}
    case True{}:
      +hz = UP.cmp_le_zero(25n, hi, UP.high_le(7n, 25n, WCon{n0, WCon{n1, WCon{n2, WCon{n3, WCon{n4, WCon{n5, WCon{n6, hi}}}}}}}, UP.bits(125), es))
      UP.absurd({True{} == False{} : Bool}, UP.false_true(Equal.sym(Bool, True{}, False{}, Equal.trans(Bool, True{}, U32.is_le(U32{WCon{n0, WCon{n1, WCon{n2, WCon{n3, WCon{n4, WCon{n5, WCon{n6, hi}}}}}}}}, 65535), False{}, Equal.cong(Word(25n), Bool, x => U32.is_le(U32{WCon{n0, WCon{n1, WCon{n2, WCon{n3, WCon{n4, WCon{n5, WCon{n6, x}}}}}}}}, 65535), Word.zero(25n), hi, Equal.sym(Word(25n), hi, Word.zero(25n), hz)), em))))

def le125_false(+n0: Bool, +n1: Bool, +n2: Bool, +n3: Bool, +n4: Bool, +n5: Bool, +n6: Bool, +hi: Word(25n), em: {U32.is_le(U32{WCon{n0, WCon{n1, WCon{n2, WCon{n3, WCon{n4, WCon{n5, WCon{n6, hi}}}}}}}}, 65535) == False{} : Bool}) -> {U32.is_le(U32{WCon{n0, WCon{n1, WCon{n2, WCon{n3, WCon{n4, WCon{n5, WCon{n6, hi}}}}}}}}, 125) == False{} : Bool}:
  le125_go(n0, n1, n2, n3, n4, n5, n6, hi, em, U32.is_le(U32{WCon{n0, WCon{n1, WCon{n2, WCon{n3, WCon{n4, WCon{n5, WCon{n6, hi}}}}}}}}, 125), {==})

def ext64_fits(+role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, +m: Bool, +n0: Bool, +n1: Bool, +n2: Bool, +n3: Bool, +n4: Bool, +n5: Bool, +n6: Bool, +n7: Bool, +n8: Bool, +n9: Bool, +n10: Bool, +n11: Bool, +n12: Bool, +n13: Bool, +n14: Bool, +n15: Bool, +n16: Bool, +n17: Bool, +n18: Bool, +n19: Bool, +n20: Bool, +n21: Bool, +n22: Bool, +n23: Bool, +n24: Bool, +n25: Bool, +n26: Bool, +n27: Bool, +n28: Bool, +n29: Bool, +n30: Bool, +n31: Bool, +t3: List<&2, U32>, rk: {F.role_mask(role, m) == True{} : Bool}, dat: {F.is_control(op) == False{} : Bool}, +emn: {Bool.not(U32.is_le(U32{WCon{n0, WCon{n1, WCon{n2, WCon{n3, WCon{n4, WCon{n5, WCon{n6, WCon{n7, WCon{n8, WCon{n9, WCon{n10, WCon{n11, WCon{n12, WCon{n13, WCon{n14, WCon{n15, WCon{n16, WCon{n17, WCon{n18, WCon{n19, WCon{n20, WCon{n21, WCon{n22, WCon{n23, WCon{n24, WCon{n25, WCon{n26, WCon{n27, WCon{n28, WCon{n29, WCon{n30, WCon{n31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, 65535)) == True{} : Bool}, fz: Bool, efz: {U32.is_le(U32{WCon{n0, WCon{n1, WCon{n2, WCon{n3, WCon{n4, WCon{n5, WCon{n6, WCon{n7, WCon{n8, WCon{n9, WCon{n10, WCon{n11, WCon{n12, WCon{n13, WCon{n14, WCon{n15, WCon{n16, WCon{n17, WCon{n18, WCon{n19, WCon{n20, WCon{n21, WCon{n22, WCon{n23, WCon{n24, WCon{n25, WCon{n26, WCon{n27, WCon{n28, WCon{n29, WCon{n30, WCon{n31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, max) == fz : Bool}) -> holds(role, max, F.first_byte(fin, op) <> U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{m, Word.zero(24n)}}}}}}}}} <> 0 <> 0 <> 0 <> 0 <> U32{WCon{n24, WCon{n25, WCon{n26, WCon{n27, WCon{n28, WCon{n29, WCon{n30, WCon{n31, Word.zero(24n)}}}}}}}}} <> U32{WCon{n16, WCon{n17, WCon{n18, WCon{n19, WCon{n20, WCon{n21, WCon{n22, WCon{n23, Word.zero(24n)}}}}}}}}} <> U32{WCon{n8, WCon{n9, WCon{n10, WCon{n11, WCon{n12, WCon{n13, WCon{n14, WCon{n15, Word.zero(24n)}}}}}}}}} <> U32{WCon{n0, WCon{n1, WCon{n2, WCon{n3, WCon{n4, WCon{n5, WCon{n6, WCon{n7, Word.zero(24n)}}}}}}}}} <> t3, F.sized(fz, m, fin, op, U32{WCon{n0, WCon{n1, WCon{n2, WCon{n3, WCon{n4, WCon{n5, WCon{n6, WCon{n7, WCon{n8, WCon{n9, WCon{n10, WCon{n11, WCon{n12, WCon{n13, WCon{n14, WCon{n15, WCon{n16, WCon{n17, WCon{n18, WCon{n19, WCon{n20, WCon{n21, WCon{n22, WCon{n23, WCon{n24, WCon{n25, WCon{n26, WCon{n27, WCon{n28, WCon{n29, WCon{n30, WCon{n31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, t3)):
  match fz:
    case False{}:
