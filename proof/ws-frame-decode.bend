# Key stage: after the length, a masked frame carries four key octets.
def key_go(+role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, +w: Word(32n), +a: U32, +b: U32, +c: U32, +d: U32, +t: List<&2, U32>, rk: {F.role_mask(role, True{}) == True{} : Bool}, cv: {S.control_valid(op, fin, U32.to_nat(U32{w})) == True{} : Bool}, fits: {U32.is_le(U32{w}, max) == True{} : Bool}, ko: Bool, eko: {F.key_octet(d, F.key_octet(c, F.key_octet(b, F.key_octet(a, True{})))) == ko : Bool}) -> holds(role, max, F.first_byte(fin, op) <> List.append(&2, U32, F.length_bytes(True{}, w, U32.is_le(U32{w}, 125), U32.is_le(U32{w}, 65535)), a <> b <> c <> d <> t), F.with_key(a, b, c, d, fin, op, U32{w}, t, ko)):
  match ko:
    case False{}:
      {==}
    case True{}:
      mask_leaf(role, max, fin, op, U32{w}, a, b, c, d, t, pk_some(role, F.MaskKey{a, b, c, d}, rk), eko, cv, fits, F.take_mask(U32.to_nat(U32{w}), t, a, b, c, d, [], True{}), {==})

def key_stage(+role: F.Role, +max: U32, +m: Bool, +fin: Bool, +op: F.Opcode, +w: Word(32n), +xs: List<&2, U32>, rk: {F.role_mask(role, m) == True{} : Bool}, cv: {S.control_valid(op, fin, U32.to_nat(U32{w})) == True{} : Bool}, fits: {U32.is_le(U32{w}, max) == True{} : Bool}) -> holds(role, max, F.first_byte(fin, op) <> List.append(&2, U32, F.length_bytes(m, w, U32.is_le(U32{w}, 125), U32.is_le(U32{w}, 65535)), xs), F.read_key(m, fin, op, U32{w}, xs)):
  match m:
