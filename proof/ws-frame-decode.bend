      ext64_top(role, max, fin, op, m, u3, u2, u1, u0, n0, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, n14, n15, n16, n17, n18, n19, n20, n21, n22, n23, n24, n25, n26, n27, n28, n29, n30, n31, h3, h2, h1, h0, t3, rk, dat, (u3 >= 128 : U32), F.is_zero_byte(u0, F.is_zero_byte(u1, F.is_zero_byte(u2, F.is_zero_byte(u3, True{})))), {==})
    case Nil{}:
      {==}
    case _ <> Nil{}:
      {==}
    case _ <> _ <> Nil{}:
      {==}
    case _ <> _ <> _ <> Nil{}:
      {==}
    case _ <> _ <> _ <> _ <> Nil{}:
      {==}
    case _ <> _ <> _ <> _ <> _ <> Nil{}:
      {==}
    case _ <> _ <> _ <> _ <> _ <> _ <> Nil{}:
      {==}
    case _ <> _ <> _ <> _ <> _ <> _ <> _ <> Nil{}:
      {==}

# The 7-bit field 126: every other value of this parity is at most 125.
def ext16_entry(+role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, +m: Bool, +t: List<&2, U32>, rk: {F.role_mask(role, m) == True{} : Bool}, dat: {F.is_control(op) == False{} : Bool}, +l6: Bool, +l5: Bool, +l4: Bool, +l3: Bool, +l2: Bool, +l1: Bool, es: {F.short7(WCon{False{}, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}) == False{} : Bool}) -> holds(role, max, F.first_byte(fin, op) <> U32{WCon{False{}, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.ext16(max, m, fin, op, t)):
  match l6:
    case False{}:
      UP.absurd(holds(role, max, F.first_byte(fin, op) <> U32{WCon{False{}, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{False{}, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.ext16(max, m, fin, op, t)), UP.false_true(Equal.sym(Bool, True{}, False{}, es)))
    case True{}:
      match l5:
        case False{}:
          UP.absurd(holds(role, max, F.first_byte(fin, op) <> U32{WCon{False{}, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{False{}, WCon{True{}, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.ext16(max, m, fin, op, t)), UP.false_true(Equal.sym(Bool, True{}, False{}, es)))
        case True{}:
          match l4:
            case False{}:
              UP.absurd(holds(role, max, F.first_byte(fin, op) <> U32{WCon{False{}, WCon{l1, WCon{l2, WCon{l3, WCon{False{}, WCon{True{}, WCon{True{}, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.ext16(max, m, fin, op, t)), UP.false_true(Equal.sym(Bool, True{}, False{}, es)))
            case True{}:
              match l3:
                case False{}:
                  UP.absurd(holds(role, max, F.first_byte(fin, op) <> U32{WCon{False{}, WCon{l1, WCon{l2, WCon{False{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.ext16(max, m, fin, op, t)), UP.false_true(Equal.sym(Bool, True{}, False{}, es)))
                case True{}:
                  match l2:
                    case False{}:
                      UP.absurd(holds(role, max, F.first_byte(fin, op) <> U32{WCon{False{}, WCon{l1, WCon{False{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.ext16(max, m, fin, op, t)), UP.false_true(Equal.sym(Bool, True{}, False{}, es)))
                    case True{}:
                      match l1:
                        case False{}:
                          UP.absurd(holds(role, max, F.first_byte(fin, op) <> U32{WCon{False{}, WCon{False{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.ext16(max, m, fin, op, t)), UP.false_true(Equal.sym(Bool, True{}, False{}, es)))
                        case True{}:
                          ext16_stage(role, max, fin, op, m, t, rk, dat)

# The 7-bit field 127: every other value of this parity is at most 125.
def ext64_entry(+role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, +m: Bool, +t: List<&2, U32>, rk: {F.role_mask(role, m) == True{} : Bool}, dat: {F.is_control(op) == False{} : Bool}, +l6: Bool, +l5: Bool, +l4: Bool, +l3: Bool, +l2: Bool, +l1: Bool, es: {F.short7(WCon{True{}, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}) == False{} : Bool}) -> holds(role, max, F.first_byte(fin, op) <> U32{WCon{True{}, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.ext64(max, m, fin, op, t)):
  match l6:
    case False{}:
      UP.absurd(holds(role, max, F.first_byte(fin, op) <> U32{WCon{True{}, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{False{}, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.ext64(max, m, fin, op, t)), UP.false_true(Equal.sym(Bool, True{}, False{}, es)))
    case True{}:
      match l5:
        case False{}:
          UP.absurd(holds(role, max, F.first_byte(fin, op) <> U32{WCon{True{}, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{False{}, WCon{True{}, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.ext64(max, m, fin, op, t)), UP.false_true(Equal.sym(Bool, True{}, False{}, es)))
        case True{}:
          match l4:
            case False{}:
              UP.absurd(holds(role, max, F.first_byte(fin, op) <> U32{WCon{True{}, WCon{l1, WCon{l2, WCon{l3, WCon{False{}, WCon{True{}, WCon{True{}, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.ext64(max, m, fin, op, t)), UP.false_true(Equal.sym(Bool, True{}, False{}, es)))
            case True{}:
              match l3:
                case False{}:
                  UP.absurd(holds(role, max, F.first_byte(fin, op) <> U32{WCon{True{}, WCon{l1, WCon{l2, WCon{False{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.ext64(max, m, fin, op, t)), UP.false_true(Equal.sym(Bool, True{}, False{}, es)))
                case True{}:
                  match l2:
                    case False{}:
                      UP.absurd(holds(role, max, F.first_byte(fin, op) <> U32{WCon{True{}, WCon{l1, WCon{False{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.ext64(max, m, fin, op, t)), UP.false_true(Equal.sym(Bool, True{}, False{}, es)))
                    case True{}:
                      match l1:
                        case False{}:
                          UP.absurd(holds(role, max, F.first_byte(fin, op) <> U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.ext64(max, m, fin, op, t)), UP.false_true(Equal.sym(Bool, True{}, False{}, es)))
                        case True{}:
                          ext64_stage(role, max, fin, op, m, t, rk, dat)

def ext_stage(+role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, +m: Bool, +t: List<&2, U32>, rk: {F.role_mask(role, m) == True{} : Bool}, dc: Bool, edc: {F.is_control(op) == dc : Bool}, +l0: Bool, +l1: Bool, +l2: Bool, +l3: Bool, +l4: Bool, +l5: Bool, +l6: Bool, es: {F.short7(WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}) == False{} : Bool}) -> holds(role, max, F.first_byte(fin, op) <> U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.extended(dc, l0, max, m, fin, op, t)):
  match dc:
    case True{}:
      {==}
    case False{}:
      match l0:
        case False{}:
          ext16_entry(role, max, fin, op, m, t, rk, edc, l6, l5, l4, l3, l2, l1, es)
        case True{}:
          ext64_entry(role, max, fin, op, m, t, rk, edc, l6, l5, l4, l3, l2, l1, es)

# 7-bit length: at most 125, so it needs no more bytes.
def short_stage(+role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, +l0: Bool, +l1: Bool, +l2: Bool, +l3: Bool, +l4: Bool, +l5: Bool, +l6: Bool, +m: Bool, +t: List<&2, U32>, nf: {F.fragmented_control(F.is_control(op), fin) == False{} : Bool}, rk: {F.role_mask(role, m) == True{} : Bool}, +es: {F.short7(WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}) == True{} : Bool}, fz: Bool, efz: {U32.is_le(U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}}, max) == fz : Bool}) -> holds(role, max, F.first_byte(fin, op) <> U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.sized(fz, m, fin, op, U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}}, t)):
  match fz:
    case False{}:
      {==}
    case True{}:
      %es : holds(role, max, F.first_byte(fin, op) <> List.append(&2, U32, F.length_bytes(m, WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}, _, U32.is_le(U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}}, 65535)), t), F.read_key(m, fin, op, U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}}, t))
      key_stage(role, max, m, fin, op, WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}, t, rk, cv_short(op, fin, U32.to_nat(U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}}), nf, Equal.trans(Bool, Nat.is_le(U32.to_nat(U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}}), 125n), U32.is_le(U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}}, 125), True{}, Equal.sym(Bool, U32.is_le(U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}}, 125), Nat.is_le(U32.to_nat(U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}}), U32.to_nat(125)), A.u32_nat_le(U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}}, 125)), es)), efz)

def len_stage(+role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, +l0: Bool, +l1: Bool, +l2: Bool, +l3: Bool, +l4: Bool, +l5: Bool, +l6: Bool, +m: Bool, +t: List<&2, U32>, nf: {F.fragmented_control(F.is_control(op), fin) == False{} : Bool}, rk: {F.role_mask(role, m) == True{} : Bool}, s: Bool, es: {F.short7(WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}) == s : Bool}) -> holds(role, max, F.first_byte(fin, op) <> U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.length7(s, WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}, max, m, fin, op, t)):
  match s:
    case True{}:
      short_stage(role, max, fin, op, l0, l1, l2, l3, l4, l5, l6, m, t, nf, rk, es, U32.is_le(U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}}, max), {==})
    case False{}:
      ext_stage(role, max, fin, op, m, t, rk, F.is_control(op), {==}, l0, l1, l2, l3, l4, l5, l6, es)

def mask_stage(+role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, +l0: Bool, +l1: Bool, +l2: Bool, +l3: Bool, +l4: Bool, +l5: Bool, +l6: Bool, +m: Bool, +t: List<&2, U32>, nf: {F.fragmented_control(F.is_control(op), fin) == False{} : Bool}, r: Bool, er: {F.role_mask(role, m) == r : Bool}) -> holds(role, max, F.first_byte(fin, op) <> U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WCon{m, Word.zero(24n)}}}}}}}}} <> t, F.masked_ok(r, F.short7(WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}), WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}, max, m, fin, op, t)):
  match r:
    case False{}:
      {==}
    case True{}:
      len_stage(role, max, fin, op, l0, l1, l2, l3, l4, l5, l6, m, t, nf, er, F.short7(WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}), {==})

def second_z(+role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, +l0: Bool, +l1: Bool, +l2: Bool, +l3: Bool, +l4: Bool, +l5: Bool, +l6: Bool, +m: Bool, +h: Word(24n), +t: List<&2, U32>, nf: {F.fragmented_control(F.is_control(op), fin) == False{} : Bool}, z: Bool, ez: {Utf8.zero(24n, h) == z : Bool}) -> holds(role, max, F.first_byte(fin, op) <> U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WCon{m, h}}}}}}}}} <> t, F.second(z, WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WCon{m, WNil{}}}}}}}}}, role, max, fin, op, t)):
  match z:
    case False{}:
      {==}
    case True{}:
      %Equal.sym(Word(24n), h, Word.zero(24n), UP.zero_sound(24n, h, ez)) : holds(role, max, F.first_byte(fin, op) <> U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WCon{m, _}}}}}}}}} <> t, F.masked_ok(F.role_mask(role, m), F.short7(WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}), WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}, max, m, fin, op, t))
      mask_stage(role, max, fin, op, l0, l1, l2, l3, l4, l5, l6, m, t, nf, F.role_mask(role, m), {==})

# Second byte: MASK and the 7-bit length.
def second_stage(+role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, +xs: List<&2, U32>, nf: {F.fragmented_control(F.is_control(op), fin) == False{} : Bool}) -> holds(role, max, F.first_byte(fin, op) <> xs, F.read_second(role, max, fin, op, xs)):
  match xs:
    case Nil{}:
      {==}
    case U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WCon{m, h}}}}}}}}} <> t:
      second_z(role, max, fin, op, l0, l1, l2, l3, l4, l5, l6, m, h, t, nf, Utf8.zero(24n, h), {==})

# First byte: FIN, three clear RSV bits and a known opcode.
def op_stage(+role: F.Role, +max: U32, +r1: Bool, +r2: Bool, +r3: Bool, +o0: Bool, +o1: Bool, +o2: Bool, +o3: Bool, +fin: Bool, +t: List<&2, U32>) -> holds(role, max, U32{WCon{o0, WCon{o1, WCon{o2, WCon{o3, WCon{r1, WCon{r2, WCon{r3, WCon{fin, Word.zero(24n)}}}}}}}}} <> t, F.reserved(F.rsv_clear(r1, r2, r3), F.opcode_of(o0, o1, o2, o3), fin, role, max, t)):
  match r1:
    case True{}:
      {==}
    case False{}:
      match r2:
        case True{}:
          {==}
        case False{}:
          match r3:
            case True{}:
              {==}
            case False{}:
              match o0 o1 o2 o3:
                case False{} False{} False{} False{}:
                  second_stage(role, max, fin, F.OpContinue{}, t, {==})
                case False{} False{} False{} True{}:
                  match fin:
                    case True{}:
                      second_stage(role, max, True{}, F.OpClose{}, t, {==})
                    case False{}:
                      {==}
                case False{} False{} True{} False{}:
                  {==}
                case False{} False{} True{} True{}:
                  {==}
                case False{} True{} False{} False{}:
                  second_stage(role, max, fin, F.OpBinary{}, t, {==})
                case False{} True{} False{} True{}:
                  match fin:
                    case True{}:
                      second_stage(role, max, True{}, F.OpPong{}, t, {==})
                    case False{}:
                      {==}
                case False{} True{} True{} False{}:
                  {==}
                case False{} True{} True{} True{}:
                  {==}
                case True{} False{} False{} False{}:
                  second_stage(role, max, fin, F.OpText{}, t, {==})
                case True{} False{} False{} True{}:
                  match fin:
                    case True{}:
                      second_stage(role, max, True{}, F.OpPing{}, t, {==})
                    case False{}:
                      {==}
                case True{} False{} True{} False{}:
                  {==}
                case True{} False{} True{} True{}:
                  {==}
                case True{} True{} False{} False{}:
                  {==}
                case True{} True{} False{} True{}:
                  {==}
                case True{} True{} True{} False{}:
                  {==}
                case True{} True{} True{} True{}:
                  {==}

def first_z(+role: F.Role, +max: U32, +o0: Bool, +o1: Bool, +o2: Bool, +o3: Bool, +r1: Bool, +r2: Bool, +r3: Bool, +fin: Bool, +h: Word(24n), +t: List<&2, U32>, z: Bool, ez: {Utf8.zero(24n, h) == z : Bool}) -> holds(role, max, U32{WCon{o0, WCon{o1, WCon{o2, WCon{o3, WCon{r1, WCon{r2, WCon{r3, WCon{fin, h}}}}}}}}} <> t, F.first(z, WCon{o0, WCon{o1, WCon{o2, WCon{o3, WCon{r1, WCon{r2, WCon{r3, WCon{fin, WNil{}}}}}}}}}, role, max, t)):
  match z:
    case False{}:
      {==}
    case True{}:
      %Equal.sym(Word(24n), h, Word.zero(24n), UP.zero_sound(24n, h, ez)) : holds(role, max, U32{WCon{o0, WCon{o1, WCon{o2, WCon{o3, WCon{r1, WCon{r2, WCon{r3, WCon{fin, _}}}}}}}}} <> t, F.reserved(F.rsv_clear(r1, r2, r3), F.opcode_of(o0, o1, o2, o3), fin, role, max, t))
      op_stage(role, max, r1, r2, r3, o0, o1, o2, o3, fin, t)

def start_stage(+role: F.Role, +max: U32, +xs: List<&2, U32>) -> holds(role, max, xs, F.start(F.Config{role, max}, xs)):
  match xs:
    case Nil{}:
      {==}
    case U32{WCon{o0, WCon{o1, WCon{o2, WCon{o3, WCon{r1, WCon{r2, WCon{r3, WCon{fin, h}}}}}}}}} <> t:
      first_z(role, max, o0, o1, o2, o3, r1, r2, r3, fin, h, t, Utf8.zero(24n, h), {==})

def settle_seen(+role: F.Role, +max: U32, +xs: List<&2, U32>, d: F.Decoded, e: holds(role, max, xs, d)) -> holds(role, max, xs, F.settle(d)):
  match d:
    case F.NeedMore{n}:
      {==}
    case F.Partial{F.Body{fin, op, key, rot, left, acc, ok}}:
      {==}
    case F.Got{f, k, rest}:
      e
    case F.Reject{c}:
      {==}

# Every decoder result, from any bytes, either is no frame or re-encodes to
# those bytes and is valid for the role.
def decode_seen(+role: F.Role, +max: U32, +xs: List<&2, U32>) -> holds(role, max, xs, F.decode(F.Config{role, max}, xs)):
  settle_seen(role, max, xs, F.start(F.Config{role, max}, xs), start_stage(role, max, xs))

def accepted(+role: F.Role, +max: U32, +xs: List<&2, U32>, +f: F.Frame, +k: Maybe<&2, F.Key>, +rest: List<&2, U32>, e: {F.decode(F.Config{role, max}, xs) == F.Got{f, k, rest} : F.Decoded}) -> {Seen{List.append(&2, U32, F.encode_raw(f, k), rest), S.valid(max, f, k) && S.peer_key(role, k)} == Seen{xs, True{}} : Seen}:
  %e : holds(role, max, xs, _)
  decode_seen(role, max, xs)

def WL.ws_decode_sound(cfg, xs, f, k, rest, e):
  match cfg:
    case F.Config{role, max}:
      Equal.cong(Seen, List<&2, U32>, s => seen_wire(s), Seen{List.append(&2, U32, F.encode_raw(f, k), rest), S.valid(max, f, k) && S.peer_key(role, k)}, Seen{xs, True{}}, accepted(role, max, xs, f, k, rest, e))

def WL.ws_decode_valid(role, max, xs, f, k, rest, e):
  Equal.cong(Seen, Bool, s => seen_ok(s), Seen{List.append(&2, U32, F.encode_raw(f, k), rest), S.valid(max, f, k) && S.peer_key(role, k)}, Seen{xs, True{}}, accepted(role, max, xs, f, k, rest, e))
