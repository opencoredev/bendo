def normalized(+w: Word(32n), bound: {Cmp.is_le(Word.cmp(32n, w, word(599))) == True{} : Bool}) -> {U32{w} == narrowed(U.low(10n, 22n, w)) : U32}:
  upper = Bits.high_le(10n, 22n, w, word(599), bound)
  zero = Bits.cmp_le_zero(22n, U.high(10n, 22n, w), upper)
  split = Equal.sym(Word(32n), U.join(10n, 22n, U.low(10n, 22n, w), U.high(10n, 22n, w)), w, Bits.join_split(10n, 22n, w))
  Equal.cong(Word(32n), U32, x => U32{x}, w, U.join(10n, 22n, U.low(10n, 22n, w), Word.zero(22n)), Equal.trans(Word(32n), w, U.join(10n, 22n, U.low(10n, 22n, w), U.high(10n, 22n, w)), U.join(10n, 22n, U.low(10n, 22n, w), Word.zero(22n)), split, Equal.cong(Word(22n), Word(32n), x => U.join(10n, 22n, U.low(10n, 22n, w), x), U.high(10n, 22n, w), Word.zero(22n), zero)))

def valid(+s: U32, +ok: {(s >= 100 : U32) && (s <= 599 : U32) == True{} : Bool}) -> {Spec.status_valid(B.encode(W.status_text(s))) == True{} : Bool}:
  match s:
    case U32{w}:
      +same = normalized(w, Laws.and_right((U32{w} >= 100 : U32), (U32{w} <= 599 : U32), ok))
      small_ok = Equal.cong(U32, Bool, x => (x >= 100 : U32) && (x <= 599 : U32), U32{w}, narrowed(U.low(10n, 22n, w)), same)
      narrowed_ok = Equal.trans(Bool, (narrowed(U.low(10n, 22n, w)) >= 100 : U32) && (narrowed(U.low(10n, 22n, w)) <= 599 : U32), (U32{w} >= 100 : U32) && (U32{w} <= 599 : U32), True{}, Equal.sym(Bool, (U32{w} >= 100 : U32) && (U32{w} <= 599 : U32), (narrowed(U.low(10n, 22n, w)) >= 100 : U32) && (narrowed(U.low(10n, 22n, w)) <= 599 : U32), small_ok), ok)
      %Equal.sym(U32, U32{w}, narrowed(U.low(10n, 22n, w)), same) : {Spec.status_valid(B.encode(W.status_text(_))) == True{} : Bool}
      small(U.low(10n, 22n, w), narrowed_ok)

def status(r: Response.Res) -> U32:
  match r:
    case Response.Res{s, hs, b, rep}:
      s

def response(+r: Response.Res, +ok: {Response.valid(r) == True{} : Bool}) -> {Spec.status_valid(B.encode(W.status_text(status(r)))) == True{} : Bool}:
  match r:
    case Response.Res{s, hs, b, rep}:
      a = Laws.and_left((s >= 100 : U32) && (s <= 599 : U32) && R.headers_valid(hs) && Response.octets(b), Response.representation_valid(rep), ok)
      bvalid = Laws.and_left((s >= 100 : U32) && (s <= 599 : U32) && R.headers_valid(hs), Response.octets(b), a)
      valid(s, Laws.and_left((s >= 100 : U32) && (s <= 599 : U32), R.headers_valid(hs), bvalid))
