# Valid status codes serialize as three HTTP status digits. The finite table
# below checks 10-bit codes; the bound first excludes every higher bit.
import Base
import ../src/data/utf8.bend as U
import ../src/http/bytes.bend as B
import ../src/http/write_response.bend as W
import ../src/http/response.bend as Response
import ../src/http/request.bend as R
import ./response-spec.bend as Spec
import ./utf8.bend as Bits
import ./equality.bend as E
import ../LAWS.bend as Laws

def word(c: U32) -> Word(32n):
  match c:
    case U32{w}:
      w

def narrowed(w: Word(10n)) -> U32:
  U32{U.join(10n, 22n, w, Word.zero(22n))}

def small(+w: Word(10n), ok: {(narrowed(w) >= 100 : U32) && (narrowed(w) <= 599 : U32) == True{} : Bool}) -> {Spec.status_valid(B.encode(W.status_text(narrowed(w)))) == True{} : Bool}:
