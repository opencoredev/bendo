def all_zero(n: Nat, w: Word(n)) -> Bool:
  match n:
    case 0n:
      True{}
    case 1n+p:
      match w:
        case WCon{h, t}:
          Bool.not(h) && all_zero(p, t)

def octet(c: U32) -> Bool:
  match c:
    case U32{WCon{a, WCon{b, WCon{c, WCon{d, WCon{e, WCon{f, WCon{g, WCon{h, hi}}}}}}}}}:
      all_zero(24n, hi)

def octets(xs: List<&2, U32>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case c <> t:
      octet(c) && octets(t)

def distinguish(b: Bool) -> Type:
  match b:
    case False{}:
      Unit
    case True{}:
      Empty

def false_true(e: {False{} == True{} : Bool}) -> Empty:
  %e : distinguish(_)
  Unit{}

def absurd(-A: Type, e: Empty) -> A:
  match e:

def and_left(+a: Bool, +b: Bool, ok: {a && b == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case False{}:
      ok
    case True{}:
      {==}

def and_right(+a: Bool, +b: Bool, ok: {a && b == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case False{}:
      absurd({b == True{} : Bool}, false_true(ok))
    case True{}:
      ok

def zero_sound(+n: Nat, +w: Word(n), ok: {all_zero(n, w) == True{} : Bool}) -> {w == zeros(n) : Word(n)}:
  match n:
    case 0n:
      match w:
        case WNil{}:
          {==}
    case 1n+p:
      match w:
        case WCon{False{}, t}:
          %zero_sound(p, t, ok) : {WCon{False{}, t} == WCon{False{}, _} : Word(1n+p)}
          {==}
        case WCon{True{}, t}:
          absurd({WCon{True{}, t} == zeros(1n+p) : Word(1n+p)}, false_true(ok))

def low(c: U32) -> Word(8n):
  match c:
    case U32{WCon{a, WCon{b, WCon{c, WCon{d, WCon{e, WCon{f, WCon{g, WCon{h, hi}}}}}}}}}:
      WCon{a, WCon{b, WCon{c, WCon{d, WCon{e, WCon{f, WCon{g, WCon{h, WNil{}}}}}}}}}

def octet_sound(+c: U32, ok: {octet(c) == True{} : Bool}) -> {c == byte(low(c)) : U32}:
  match c:
    case U32{WCon{a, WCon{b, WCon{c, WCon{d, WCon{e, WCon{f, WCon{g, WCon{h, hi}}}}}}}}}:
      %zero_sound(24n, hi, ok) : {U32{WCon{a, WCon{b, WCon{c, WCon{d, WCon{e, WCon{f, WCon{g, WCon{h, hi}}}}}}}}} == U32{WCon{a, WCon{b, WCon{c, WCon{d, WCon{e, WCon{f, WCon{g, WCon{h, _}}}}}}}}} : U32}
      {==}

def octet_step(+c: U32, +tail: List<&2, U32>, +form: Bool, +rev: List<&2, U32>, ok: {octet(c) == True{} : Bool}) -> {F.percent_decode_go(List.append(&2, U32, U.encode_spec(F.encode_byte(c, form, F.safe(c, form))), tail), form, Done{rev}) == F.percent_decode_go(tail, form, Done{c <> rev}) : Result<&2, &2, F.Error, List<&2, U32>>}:
  %Equal.sym(U32, c, byte(low(c)), octet_sound(c, ok)) : {F.percent_decode_go(List.append(&2, U32, U.encode_spec(F.encode_byte(_, form, F.safe(_, form))), tail), form, Done{rev}) == F.percent_decode_go(tail, form, Done{_ <> rev}) : Result<&2, &2, F.Error, List<&2, U32>>}
  byte_step(low(c), tail, form, rev)

def append_assoc(+xs: List<&2, U32>, +ys: List<&2, U32>, +zs: List<&2, U32>) -> {List.append(&2, U32, List.append(&2, U32, xs, ys), zs) == List.append(&2, U32, xs, List.append(&2, U32, ys, zs)) : List<&2, U32>}:
  match xs:
    case Nil{}:
      {==}
    case h <> t:
      %append_assoc(t, ys, zs) : {h <> List.append(&2, U32, List.append(&2, U32, t, ys), zs) == h <> _ : List<&2, U32>}
      {==}

def utf8_append(+a: String, +b: String) -> {U.encode_spec(a ++ b) == List.append(&2, U32, U.encode_spec(a), U.encode_spec(b)) : List<&2, U32>}:
  match a:
    case SNil{}:
      {==}
    case SCon{Chr{+c}, t}:
      %Equal.sym(List<&2, U32>, U.encode_spec(t ++ b), List.append(&2, U32, U.encode_spec(t), U.encode_spec(b)), utf8_append(t, b)) : {List.append(&2, U32, U.encode_char(c), _) == List.append(&2, U32, U.encode_spec(SCon{Chr{c}, t}), U.encode_spec(b)) : List<&2, U32>}
      Equal.sym(List<&2, U32>, List.append(&2, U32, List.append(&2, U32, U.encode_char(c), U.encode_spec(t)), U.encode_spec(b)), List.append(&2, U32, U.encode_char(c), List.append(&2, U32, U.encode_spec(t), U.encode_spec(b))), append_assoc(U.encode_char(c), U.encode_spec(t), U.encode_spec(b)))

def roundtrip_go(+xs: List<&2, U32>, +form: Bool, +rev: List<&2, U32>, +ok: {octets(xs) == True{} : Bool}) -> {F.percent_decode_go(U.encode_spec(F.encode_bytes_spec(xs, form)), form, Done{rev}) == Done{List.reverse.go(&2, U32, rev, xs)} : Result<&2, &2, F.Error, List<&2, U32>>}:
  match xs:
    case Nil{}:
      {==}
    case +c <> t:
      +piece = F.encode_byte(c, form, F.safe(c, form))
      +tail = U.encode_spec(F.encode_bytes_spec(t, form))
      %Equal.sym(List<&2, U32>, U.encode_spec(piece ++ F.encode_bytes_spec(t, form)), List.append(&2, U32, U.encode_spec(piece), tail), utf8_append(piece, F.encode_bytes_spec(t, form))) : {F.percent_decode_go(_, form, Done{rev}) == Done{List.reverse.go(&2, U32, rev, c <> t)} : Result<&2, &2, F.Error, List<&2, U32>>}
      %Equal.sym(Result<&2, &2, F.Error, List<&2, U32>>, F.percent_decode_go(List.append(&2, U32, U.encode_spec(piece), tail), form, Done{rev}), F.percent_decode_go(tail, form, Done{c <> rev}), octet_step(c, tail, form, rev, and_left(octet(c), octets(t), ok))) : {_ == Done{List.reverse.go(&2, U32, rev, c <> t)} : Result<&2, &2, F.Error, List<&2, U32>>}
      roundtrip_go(t, form, c <> rev, and_right(octet(c), octets(t), ok))

def code7_octet(+w: Word(7n)) -> {octet(U.code7(w)) == True{} : Bool}:
  match w:
    case WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WNil{}}}}}}}}:
      {==}

def byte6_octet(+w: Word(6n)) -> {octet(U.byte6(w)) == True{} : Bool}:
  match w:
    case WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WNil{}}}}}}}:
      {==}

def byte5_octet(+w: Word(5n)) -> {octet(U.byte5(w)) == True{} : Bool}:
  match w:
    case WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WNil{}}}}}}:
      {==}

def byte4_octet(+w: Word(4n)) -> {octet(U.byte4(w)) == True{} : Bool}:
  match w:
    case WCon{b0, WCon{b1, WCon{b2, WCon{b3, WNil{}}}}}:
      {==}

def byte3_octet(+w: Word(3n)) -> {octet(U.byte3(w)) == True{} : Bool}:
  match w:
    case WCon{b0, WCon{b1, WCon{b2, WNil{}}}}:
      {==}

def and_intro(+a: Bool, +b: Bool, ea: {a == True{} : Bool}, eb: {b == True{} : Bool}) -> {a && b == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, ea) : {_ && b == True{} : Bool}
  eb

def cons_octets(+c: U32, +t: List<&2, U32>, co: {octet(c) == True{} : Bool}, to: {octets(t) == True{} : Bool}) -> {octets(c <> t) == True{} : Bool}:
  and_intro(octet(c), octets(t), co, to)

def encode7_octets(+w: Word(7n)) -> {octets(U.encode7(w)) == True{} : Bool}:
  cons_octets(U.code7(w), [], code7_octet(w), {==})

def encode11_go_octets(+w: Word(11n), small: Bool) -> {octets(U.encode11_go(w, small)) == True{} : Bool}:
  match small:
    case True{}:
      encode7_octets(U.low(7n, 4n, w))
    case False{}:
      cons_octets(U.byte5(U.high(6n, 5n, w)), [U.byte6(U.low(6n, 5n, w))], byte5_octet(U.high(6n, 5n, w)), cons_octets(U.byte6(U.low(6n, 5n, w)), [], byte6_octet(U.low(6n, 5n, w)), {==}))

def encode11_octets(+w: Word(11n)) -> {octets(U.encode11(w)) == True{} : Bool}:
  encode11_go_octets(w, U.zero(4n, U.high(7n, 4n, w)))

def three_octets(+a: Word(4n), +b: Word(6n), +c: Word(6n)) -> {octets([U.byte4(a), U.byte6(b), U.byte6(c)]) == True{} : Bool}:
  cons_octets(U.byte4(a), [U.byte6(b), U.byte6(c)], byte4_octet(a), cons_octets(U.byte6(b), [U.byte6(c)], byte6_octet(b), cons_octets(U.byte6(c), [], byte6_octet(c), {==})))

def encode16_go_octets(+w: Word(16n), small: Bool) -> {octets(U.encode16_go(w, small)) == True{} : Bool}:
  match small:
    case True{}:
      encode11_octets(U.low(11n, 5n, w))
    case False{}:
      three_octets(U.high(12n, 4n, w), U.low(6n, 4n, U.high(6n, 10n, w)), U.low(6n, 10n, w))

def encode16_octets(+w: Word(16n)) -> {octets(U.encode16(w)) == True{} : Bool}:
  encode16_go_octets(w, U.zero(5n, U.high(11n, 5n, w)))

def four_octets(+a: Word(3n), +b: Word(6n), +c: Word(6n), +d: Word(6n)) -> {octets([U.byte3(a), U.byte6(b), U.byte6(c), U.byte6(d)]) == True{} : Bool}:
  cons_octets(U.byte3(a), [U.byte6(b), U.byte6(c), U.byte6(d)], byte3_octet(a), cons_octets(U.byte6(b), [U.byte6(c), U.byte6(d)], byte6_octet(b), cons_octets(U.byte6(c), [U.byte6(d)], byte6_octet(c), cons_octets(U.byte6(d), [], byte6_octet(d), {==}))))

def encode21_go_octets(+w: Word(21n), small: Bool) -> {octets(U.encode21_go(w, small)) == True{} : Bool}:
  match small:
    case True{}:
      encode16_octets(U.low(16n, 5n, w))
    case False{}:
      four_octets(U.high(18n, 3n, w), U.low(6n, 3n, U.high(12n, 9n, w)), U.low(6n, 9n, U.high(6n, 15n, w)), U.low(6n, 15n, w))

def encode_fit_octets(+w: Word(21n), fits: Bool) -> {octets(U.encode_fit(w, fits)) == True{} : Bool}:
  match fits:
    case True{}:
      encode21_go_octets(w, U.zero(5n, U.high(16n, 5n, w)))
    case False{}:
      {==}

def char_octets(+c: U32) -> {octets(U.encode_char(c)) == True{} : Bool}:
  match c:
    case U32{w}:
      encode_fit_octets(U.low(21n, 11n, w), U.zero(11n, U.high(21n, 11n, w)))

def append_octets(+xs: List<&2, U32>, +ys: List<&2, U32>, +xo: {octets(xs) == True{} : Bool}, +yo: {octets(ys) == True{} : Bool}) -> {octets(List.append(&2, U32, xs, ys)) == True{} : Bool}:
  match xs:
    case Nil{}:
      yo
    case c <> t:
      cons_octets(c, List.append(&2, U32, t, ys), and_left(octet(c), octets(t), xo), append_octets(t, ys, and_right(octet(c), octets(t), xo), yo))

def encode_octets(+s: String) -> {octets(U.encode_spec(s)) == True{} : Bool}:
  match s:
    case SNil{}:
      {==}
    case SCon{Chr{c}, t}:
      append_octets(U.encode_char(c), U.encode_spec(t), char_octets(c), encode_octets(t))

def string_nil(+s: String) -> {s ++ "" == s : String}:
  match s:
    case SNil{}:
      {==}
    case SCon{c, t}:
      Equal.cong(String, String, x => SCon{c, x}, t ++ "", t, string_nil(t))

def string_assoc(+a: String, +b: String, +c: String) -> {(a ++ b) ++ c == a ++ (b ++ c) : String}:
  match a:
    case SNil{}:
      {==}
    case SCon{h, t}:
      Equal.cong(String, String, x => SCon{h, x}, (t ++ b) ++ c, t ++ (b ++ c), string_assoc(t, b, c))

def encode_reverse(+xs: List<&2, U32>, +rev: List<&2, U32>, +form: Bool, +acc: String) -> {F.encode_bytes_go(List.reverse.go(&2, U32, xs, rev), form, acc) == F.encode_bytes_go(rev, form, F.encode_bytes_spec(xs, form) ++ acc) : String}:
  match xs:
    case Nil{}:
      {==}
    case +b <> t:
      +piece = F.encode_byte(b, form, F.safe(b, form))
      %Equal.sym(String, (piece ++ F.encode_bytes_spec(t, form)) ++ acc, piece ++ (F.encode_bytes_spec(t, form) ++ acc), string_assoc(piece, F.encode_bytes_spec(t, form), acc)) : {F.encode_bytes_go(List.reverse.go(&2, U32, t, b <> rev), form, acc) == F.encode_bytes_go(rev, form, _) : String}
      encode_reverse(t, b <> rev, form, acc)

def encode_equiv(+xs: List<&2, U32>, +form: Bool) -> {F.encode_bytes(xs, form) == F.encode_bytes_spec(xs, form) : String}:
  Equal.trans(String, F.encode_bytes(xs, form), F.encode_bytes_spec(xs, form) ++ "", F.encode_bytes_spec(xs, form), encode_reverse(xs, [], form, ""), string_nil(F.encode_bytes_spec(xs, form)))

# Compose stack-safe percent-byte inversion with universal UTF-8 inversion.
def component_roundtrip(+s: String, +form: Bool, inverse: {U.decode(U.encode(s)) == Some{s} : Maybe<&2, String>}) -> {F.decode_bytes(U.encode(F.encode_bytes(U.encode(s), form)), form) == Done{s} : Result<&2, &2, F.Error, String>}:
  +xs = U.encode(s)
  %Equal.sym(List<&2, U32>, U.encode(F.encode_bytes(xs, form)), U.encode_spec(F.encode_bytes(xs, form)), UP.encode_equiv(F.encode_bytes(xs, form))) : {F.decode_result(F.percent_decode(_, form)) == Done{s} : Result<&2, &2, F.Error, String>}
  %Equal.sym(String, F.encode_bytes(xs, form), F.encode_bytes_spec(xs, form), encode_equiv(xs, form)) : {F.decode_result(F.percent_decode(U.encode_spec(_), form)) == Done{s} : Result<&2, &2, F.Error, String>}
  +xo = Equal.trans(Bool, octets(U.encode(s)), octets(U.encode_spec(s)), True{}, Equal.cong(List<&2, U32>, Bool, bs => octets(bs), U.encode(s), U.encode_spec(s), UP.encode_equiv(s)), encode_octets(s))
  %Equal.sym(Result<&2, &2, F.Error, List<&2, U32>>, F.percent_decode(U.encode_spec(F.encode_bytes_spec(xs, form)), form), Done{xs}, roundtrip_go(xs, form, [], xo)) : {F.decode_result(_) == Done{s} : Result<&2, &2, F.Error, String>}
  %Equal.sym(Maybe<&2, String>, U.decode(xs), Some{s}, inverse) : {F.utf8_result(_) == Done{s} : Result<&2, &2, F.Error, String>}
  {==}
