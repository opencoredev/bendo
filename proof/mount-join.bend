# ---- Splitting and tokenizing a joined text ----

def is_cons(xs: List<&2, String>) -> Type:
  match xs:
    case Nil{}:
      Empty
    case h <> t:
      Unit

def nil_cons(+h: String, +t: List<&2, String>, e: {h <> t == Nil{} : List<&2, String>}) -> Empty:
  %e : is_cons(_)
  Unit{}

def fin_ne(+h: Char, +r: List<&2, String>, +c: Bool, e: {String.split.fin(h, r, c) == Nil{} : List<&2, String>}) -> Empty:
  match r c:
    case Nil{} True{}:
      nil_cons("", Nil{}, e)
    case Nil{} False{}:
      nil_cons(SCon{h, SNil{}}, Nil{}, e)
    case +x <> +y True{}:
      nil_cons("", x <> y, e)
    case +x <> +y False{}:
      nil_cons(SCon{h, x}, y, e)

def split_ne(+s: String, e: {String.split(s, '/') == Nil{} : List<&2, String>}) -> Empty:
  match s:
    case SNil{}:
      nil_cons("", Nil{}, e)
    case SCon{+h, +t}:
      fin_ne(h, String.split(t, '/'), Char.is_eq(h, '/'), e)

def fin_append(+h: Char, +r: List<&2, String>, +ys: List<&2, String>, +c: Bool, ne: {r == Nil{} : List<&2, String>} -> Empty) ->
    {String.split.fin(h, List.append(&2, String, r, ys), c) == List.append(&2, String, String.split.fin(h, r, c), ys) : List<&2, String>}:
  match r c:
    case Nil{} b:
      Core.absurd({String.split.fin(h, List.append(&2, String, Nil{}, ys), b) == List.append(&2, String, String.split.fin(h, Nil{}, b), ys) : List<&2, String>}, ne({==}))
    case x <> y True{}:
      {==}
    case x <> y False{}:
      {==}

# A slash between two texts splits into the segments of each.
def split_append(+p: String, +m: String) ->
    {String.split(p ++ SCon{'/', m}, '/') == List.append(&2, String, String.split(p, '/'), String.split(m, '/')) : List<&2, String>}:
  match p:
    case SNil{}:
      {==}
    case SCon{+h, +t}:
      %Equal.sym(List<&2, String>, String.split(t ++ SCon{'/', m}, '/'), List.append(&2, String, String.split(t, '/'), String.split(m, '/')), split_append(t, m)) : {String.split.fin(h, _, Char.is_eq(h, '/')) == List.append(&2, String, String.split.fin(h, String.split(t, '/'), Char.is_eq(h, '/')), String.split(m, '/')) : List<&2, String>}
      fin_append(h, String.split(t, '/'), String.split(m, '/'), Char.is_eq(h, '/'), e => split_ne(t, e))

def both_list(a: Maybe<&2, List<&2, P.Segment>>, b: Maybe<&2, List<&2, P.Segment>>) -> Maybe<&2, List<&2, P.Segment>>:
  match a b:
    case Some{x} Some{y}:
      Some{List.append(&2, P.Segment, x, y)}
    case _ _:
      None{}

def both_nil(m: Maybe<&2, List<&2, P.Segment>>) -> {both_list(Some{Nil{}}, m) == m : Maybe<&2, List<&2, P.Segment>>}:
  match m:
    case None{}:
      {==}
    case Some{y}:
      {==}

def both_assoc(m: Maybe<&2, P.Segment>, a: Maybe<&2, List<&2, P.Segment>>, b: Maybe<&2, List<&2, P.Segment>>) ->
    {CS.both(m, both_list(a, b)) == both_list(CS.both(m, a), b) : Maybe<&2, List<&2, P.Segment>>}:
  match m a b:
    case None{} x y:
      {==}
    case Some{s} None{} y:
      {==}
    case Some{s} Some{x} None{}:
      {==}
    case Some{s} Some{x} Some{y}:
      {==}

def fin_full(+h: Char, c: Bool, +r: List<&2, String>) -> {List.is_empty(&2, String, String.split.fin(h, r, c)) == False{} : Bool}:
  match c:
    case True{}:
      {==}
    case False{}:
      match r:
        case Nil{}:
          {==}
        case x <> y:
          {==}

# Splitting never gives an empty list.
def split_full(+s: String) -> {List.is_empty(&2, String, String.split(s, '/')) == False{} : Bool}:
  match s:
    case SNil{}:
      {==}
    case SCon{+h, +t}:
      fin_full(h, Char.is_eq(h, '/'), String.split(t, '/'))

def not_last(+rest: List<&2, String>, +ys: List<&2, String>, full: {List.is_empty(&2, String, ys) == False{} : Bool}) ->
    {List.is_empty(&2, String, List.append(&2, String, rest, ys)) == False{} : Bool}:
  match rest:
    case Nil{}:
      full
    case x <> y:
      {==}

# Every prefix piece has segments after it, so none is the last one.
def pieces_append(+xs: List<&2, String>, +ys: List<&2, String>, +full: {List.is_empty(&2, String, ys) == False{} : Bool}) ->
    {CS.pieces(List.append(&2, String, xs, ys)) == both_list(S.prefix_pieces(xs), CS.pieces(ys)) : Maybe<&2, List<&2, P.Segment>>}:
  match xs:
    case Nil{}:
      Equal.sym(Maybe<&2, List<&2, P.Segment>>, both_list(Some{Nil{}}, CS.pieces(ys)), CS.pieces(ys), both_nil(CS.pieces(ys)))
    case +x <> +rest:
      %Equal.sym(Bool, List.is_empty(&2, String, List.append(&2, String, rest, ys)), False{}, not_last(rest, ys, full)) : {CS.both(CS.piece(x, _), CS.pieces(List.append(&2, String, rest, ys))) == both_list(CS.both(CS.piece(x, False{}), S.prefix_pieces(rest)), CS.pieces(ys)) : Maybe<&2, List<&2, P.Segment>>}
      %Equal.sym(Maybe<&2, List<&2, P.Segment>>, CS.pieces(List.append(&2, String, rest, ys)), both_list(S.prefix_pieces(rest), CS.pieces(ys)), pieces_append(rest, ys, full)) : {CS.both(CS.piece(x, False{}), _) == both_list(CS.both(CS.piece(x, False{}), S.prefix_pieces(rest)), CS.pieces(ys)) : Maybe<&2, List<&2, P.Segment>>}
      both_assoc(CS.piece(x, False{}), S.prefix_pieces(rest), CS.pieces(ys))

def checked_both(a: Maybe<&2, List<&2, P.Segment>>, b: Maybe<&2, List<&2, P.Segment>>) -> {CS.checked(both_list(a, b)) == S.joined(a, b) : Maybe<&2, P.Pattern>}:
  match a b:
    case None{} y:
      {==}
    case Some{x} None{}:
      {==}
    case Some{x} Some{y}:
      {==}

# `/p/m` compiles to p's prefix pieces followed by m's pieces.
def join_compile(+p: String, +m: String) ->
    {CS.compile(SCon{'/', p ++ SCon{'/', m}}) == S.joined(S.prefix_pieces(String.split(p, '/')), CS.pieces(String.split(m, '/'))) : Maybe<&2, P.Pattern>}:
  %Equal.sym(List<&2, String>, String.split(p ++ SCon{'/', m}, '/'), List.append(&2, String, String.split(p, '/'), String.split(m, '/')), split_append(p, m)) : {CS.checked(CS.pieces(_)) == S.joined(S.prefix_pieces(String.split(p, '/')), CS.pieces(String.split(m, '/'))) : Maybe<&2, P.Pattern>}
  %Equal.sym(Maybe<&2, List<&2, P.Segment>>, CS.pieces(List.append(&2, String, String.split(p, '/'), String.split(m, '/'))), both_list(S.prefix_pieces(String.split(p, '/')), CS.pieces(String.split(m, '/'))), pieces_append(String.split(p, '/'), String.split(m, '/'), split_full(m))) : {CS.checked(_) == S.joined(S.prefix_pieces(String.split(p, '/')), CS.pieces(String.split(m, '/'))) : Maybe<&2, P.Pattern>}
  checked_both(S.prefix_pieces(String.split(p, '/')), CS.pieces(String.split(m, '/')))

# ---- Removing one terminal slash ----

def trimmed(+z: String) -> String:
  AssemblySpec.trim_terminal(z, String.ends_with(z, "/"))

def go_if_same(b: Bool, +a1: String, +a2: String) ->
    {String.starts_with.go.if(SNil{}, a1, b) == String.starts_with.go.if(SNil{}, a2, b) : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

# Whether a reversed nonempty text starts with `/` ignores what follows it.
def rev_slash(+t: String, +h: Char, +a1: String, +a2: String) ->
    {String.starts_with.go("/", String.reverse.go(t, SCon{h, a1})) == String.starts_with.go("/", String.reverse.go(t, SCon{h, a2})) : Bool}:
  match t:
    case SNil{}:
      go_if_same(Char.is_eq(h, '/'), a1, a2)
    case SCon{+y, +u}:
      rev_slash(u, y, SCon{h, a1}, SCon{h, a2})

def sub_zero(+n: Nat) -> {Nat.sub(n, 0n) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+k:
      {==}

def trim_pick(+x: Char, +h: Char, +t: String, v: Bool) ->
    {AssemblySpec.trim_terminal(SCon{x, SCon{h, t}}, v) == SCon{x, AssemblySpec.trim_terminal(SCon{h, t}, v)} : String}:
  match v:
    case True{}:
      %Equal.sym(Nat, Nat.sub(String.length(t), 0n), String.length(t), sub_zero(String.length(t))) : {SCon{x, String.take(SCon{h, t}, String.length(t))} == SCon{x, String.take(SCon{h, t}, _)} : String}
      {==}
    case False{}:
      {==}

def trim_more(+x: Char, +h: Char, +t: String) -> {trimmed(SCon{x, SCon{h, t}}) == SCon{x, trimmed(SCon{h, t})} : String}:
  %rev_slash(t, h, SNil{}, SCon{x, SNil{}}) : {AssemblySpec.trim_terminal(SCon{x, SCon{h, t}}, _) == SCon{x, trimmed(SCon{h, t})} : String}
  trim_pick(x, h, t, String.ends_with(SCon{h, t}, "/"))

def strip_last(+x: Char, +h: Char, b: Bool, e: {Char.is_eq(h, '/') == b : Bool}) ->
    {trimmed(SCon{x, SCon{h, SNil{}}}) == SCon{x, S.strip_one(SCon{h, SNil{}})} : String}:
  match b:
    case True{}:
      %Equal.sym(Bool, Char.is_eq(h, '/'), True{}, e) : {AssemblySpec.trim_terminal(SCon{x, SCon{h, SNil{}}}, String.starts_with.go.if(SNil{}, SCon{x, SNil{}}, _)) == SCon{x, S.strip_pick(h, _ && True{}, SNil{})} : String}
      {==}
    case False{}:
      %Equal.sym(Bool, Char.is_eq(h, '/'), False{}, e) : {AssemblySpec.trim_terminal(SCon{x, SCon{h, SNil{}}}, String.starts_with.go.if(SNil{}, SCon{x, SNil{}}, _)) == SCon{x, S.strip_pick(h, _ && True{}, SNil{})} : String}
      {==}

# Removing one terminal slash keeps every earlier character.
def trim_any(+rest: String, +h: Char, +x: Char) ->
    {trimmed(SCon{x, SCon{h, rest}}) == SCon{x, S.strip_one(SCon{h, rest})} : String}:
  match rest:
    case SNil{}:
      strip_last(x, h, Char.is_eq(h, '/'), {==})
    case SCon{+a, +b}:
      %Equal.sym(String, trimmed(SCon{x, SCon{h, SCon{a, b}}}), SCon{x, trimmed(SCon{h, SCon{a, b}})}, trim_more(x, h, SCon{a, b})) : {_ == SCon{x, S.strip_one(SCon{h, SCon{a, b}})} : String}
      %Equal.sym(String, trimmed(SCon{h, SCon{a, b}}), SCon{h, S.strip_one(SCon{a, b})}, trim_any(b, a, h)) : {SCon{x, _} == SCon{x, S.strip_one(SCon{h, SCon{a, b}})} : String}
      %Equal.sym(Bool, Char.is_eq(h, '/') && False{}, False{}, CSP.and_false(Char.is_eq(h, '/'))) : {SCon{x, SCon{h, S.strip_one(SCon{a, b})}} == SCon{x, S.strip_pick(h, _, S.strip_one(SCon{a, b}))} : String}
      {==}


