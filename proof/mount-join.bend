def get_text(m: Maybe<&2, String>, d: String) -> String:
  match m:
    case Some{x}:
      x
    case None{}:
      d

def none_text(m: Maybe<&2, String>) -> Type:
  match m:
    case None{}:
      Unit
    case Some{x}:
      Empty

def none_some_text(+t: String, e: {None{} == Some{t} : Maybe<&2, String>}) -> Empty:
  %e : none_text(_)
  Unit{}

def TGoal(+path: String, +t: String) -> Type:
  {path == SCon{'/', t} : String}

# A request path with a text after its leading slash is that slash and text.
def tail_inv(+path: String, +t: String, e: {S.slash_tail(path) == Some{t} : Maybe<&2, String>}) -> TGoal(path, t):
  match path:
    case SNil{}:
      Core.absurd(TGoal(SNil{}, t), none_some_text(t, e))
    case SCon{Chr{U32{WCon{False{}, remaining}}}, tail}:
      Core.absurd(TGoal(SCon{Chr{U32{WCon{False{}, remaining}}}, tail}, t), none_some_text(t, e))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, remaining}}}}, tail}:
      Core.absurd(TGoal(SCon{Chr{U32{WCon{True{}, WCon{False{}, remaining}}}}, tail}, t), none_some_text(t, e))
