def MGoal(+z: String, +member: String) -> Type:
  {CS.compile(SCon{'/', z} ++ ComposeSpec.canonical(member)) == S.joined(S.prefix_pieces(String.split(z, '/')), S.member_pieces(S.member_text(member))) : Maybe<&2, P.Pattern>}

# A member under a nonroot prefix starts with `/` or is `*`.
def member_view(+z: String, +member: String, led: {S.compiles_text(S.member_text(member)) == True{} : Bool}) -> MGoal(z, member):
