def AGoal(+prefix: String, +member: String) -> Type:
  {CS.compile(AssemblySpec.path(prefix, ComposeSpec.canonical(member))) == S.assembled(prefix, member) : Maybe<&2, P.Pattern>}

# The mount's source compiles exactly as the specification's join, for a
# placed prefix and member.
def assembled_view(+prefix: String, +member: String, placed: {S.placed(prefix, member) == True{} : Bool}) -> AGoal(prefix, member):
  match prefix:
    case SNil{}:
      canon_compile(member)
    case SCon{Chr{U32{WCon{False{}, remaining}}}, tail}:
      Core.absurd(AGoal(SCon{Chr{U32{WCon{False{}, remaining}}}, tail}, member), Core.false_true(placed))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, remaining}}}}, tail}:
      Core.absurd(AGoal(SCon{Chr{U32{WCon{True{}, WCon{False{}, remaining}}}}, tail}, member), Core.false_true(placed))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{False{}, remaining}}}}}, tail}:
      Core.absurd(AGoal(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{False{}, remaining}}}}}, tail}, member), Core.false_true(placed))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, remaining}}}}}}, tail}:
      Core.absurd(AGoal(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, remaining}}}}}}, tail}, member), Core.false_true(placed))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, remaining}}}}}}}}, tail}:
      Core.absurd(AGoal(SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, remaining}}}}}}}}, tail}, member), Core.false_true(placed))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{True{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, tail}:
      match tail:
        case SNil{}:
          canon_compile(member)
        case SCon{+a, +b}:
          %Equal.sym(String, trimmed(SCon{'/', SCon{a, b}}), SCon{'/', S.strip_one(SCon{a, b})}, trim_any(b, a, '/')) : {CS.compile(_ ++ ComposeSpec.canonical(member)) == S.assembled(SCon{'/', SCon{a, b}}, member) : Maybe<&2, P.Pattern>}
          member_view(S.strip_one(SCon{a, b}), member, placed)
