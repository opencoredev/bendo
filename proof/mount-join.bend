def CMGoal(+member: String) -> Type:
  {CS.compile(member) == CS.checked(S.member_pieces(S.member_text(member))) : Maybe<&2, P.Pattern>}

# A member that starts with `/` or is `*` compiles as its own pieces.
def compile_member(+member: String, led: {S.compiles_text(S.member_text(member)) == True{} : Bool}) -> CMGoal(member):
  match member:
    case SNil{}:
      Core.absurd(CMGoal(SNil{}), Core.false_true(led))
    case SCon{Chr{U32{WCon{False{}, WCon{False{}, remaining}}}}, tail}:
      Core.absurd(CMGoal(SCon{Chr{U32{WCon{False{}, WCon{False{}, remaining}}}}, tail}), Core.false_true(led))
    case SCon{Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, remaining}}}}}}, tail}:
      Core.absurd(CMGoal(SCon{Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, remaining}}}}}}, tail}), Core.false_true(led))
    case SCon{Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, remaining}}}}}}}}, tail}:
      Core.absurd(CMGoal(SCon{Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, remaining}}}}}}}}, tail}), Core.false_true(led))
    case SCon{Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, tail}:
      match tail:
        case SNil{}:
          {==}
        case SCon{c, d}:
          Core.absurd(CMGoal(SCon{Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, SCon{c, d}}), Core.false_true(led))
