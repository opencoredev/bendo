def nondigit(+p: J.Phase, +c: U32, minus: {U32.is_eq(c, 45) == False{} : Bool}, dot: {U32.is_eq(c, 46) == False{} : Bool}, e: {U32.is_eq(c, 101) == False{} : Bool}, big_e: {U32.is_eq(c, 69) == False{} : Bool}, plus: {U32.is_eq(c, 43) == False{} : Bool}, zero: {U32.is_eq(c, 48) == False{} : Bool}) -> {J.number_digit(p, c, False{}) == J.PInvalid{} : J.Phase}:
  match p:
    case J.PStart{}: nondigit_pstart(c, minus, dot, e, big_e, plus, zero)
    case J.PMinus{}: nondigit_pminus(c, minus, dot, e, big_e, plus, zero)
    case J.PZero{}: nondigit_pzero(c, minus, dot, e, big_e, plus, zero)
    case J.PInteger{}: nondigit_pinteger(c, minus, dot, e, big_e, plus, zero)
    case J.PDot{}: nondigit_pdot(c, minus, dot, e, big_e, plus, zero)
    case J.PFraction{}: nondigit_pfraction(c, minus, dot, e, big_e, plus, zero)
    case J.PExponent{}: nondigit_pexponent(c, minus, dot, e, big_e, plus, zero)
    case J.PSign{}: nondigit_psign(c, minus, dot, e, big_e, plus, zero)
    case J.PDigits{}: nondigit_pdigits(c, minus, dot, e, big_e, plus, zero)
    case J.PInvalid{}: nondigit_pinvalid(c, minus, dot, e, big_e, plus, zero)

