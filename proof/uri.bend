# URI delimiters cannot occur inside validated target components.
import Base
import ../LAWS.bend as Laws
import ./support.bend as Support
import ./equality.bend as E
import ../src/http/bytes.bend as B
import ../src/http/request.bend as R

# A character predicate that rejects a delimiter excludes that delimiter.
def excludes(+c: U32, +d: U32, -pred: U32 -> Bool, ok: {pred(c) == True{} : Bool}, no: {pred(d) == False{} : Bool}, same: Bool, eq: {U32.is_eq(c, d) == same : Bool}) -> {same == False{} : Bool}:
  match same:
    case False{}:
      {==}
    case True{}:
      cd = Laws.u32_eq_sound(c, d, eq)
      bad = Equal.trans(Bool, False{}, pred(d), True{}, Equal.sym(Bool, pred(d), False{}, no), Equal.trans(Bool, pred(d), pred(c), True{}, Equal.cong(U32, Bool, pred, d, c, Equal.sym(U32, c, d, cd)), ok))
      E.absurd({True{} == False{} : Bool}, E.false_true(bad))

def Laws.uri_char_not_space(c, q, ok):
  match q:
    case False{}:
      excludes(c, 32, x => B.uri_char(x, False{}), ok, {==}, U32.is_eq(c, 32), {==})
    case True{}:
      excludes(c, 32, x => B.uri_char(x, True{}), ok, {==}, U32.is_eq(c, 32), {==})

# Every character in a space-freeproof string differs from the separator.
def not_false(b: Bool, e: {b == False{} : Bool}) -> {Bool.not(b) == True{} : Bool}:
  %Equal.sym(Bool, b, False{}, e) : {Bool.not(_) == True{} : Bool}
  {==}

def and_true(+a: Bool, +b: Bool, x: {a == True{} : Bool}, y: {b == True{} : Bool}) -> {a && b == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, x) : {_ && b == True{} : Bool}
  y

# Hexadecimal digits cannot be spaces.
def hex_free(+c: U32, ok: {B.hex(c) == True{} : Bool}) -> {Bool.not(U32.is_eq(c, 32)) == True{} : Bool}:
  not_false(U32.is_eq(c, 32), excludes(c, 32, x => B.hex(x), ok, {==}, U32.is_eq(c, 32), {==}))

def uri_free_step(+c: U32, +t: String, +q: Bool, ok: {B.uri_char(c, q) && B.uri(t, q) == True{} : Bool}, tail: {Support.free(t) == True{} : Bool}) -> {Support.free(SCon{Chr{c}, t}) == True{} : Bool}:
  hc = Laws.and_left(B.uri_char(c, q), B.uri(t, q), ok)
  and_true(Bool.not(U32.is_eq(c, 32)), Support.free(t), not_false(U32.is_eq(c, 32), Laws.uri_char_not_space(c, q, hc)), tail)

# URI validation guarantees that serialization contains no spaces.
def Laws.uri_free(s, q, ok):
  match s:
    case SNil{}:
      {==}
    case SCon{Chr{37}, SCon{Chr{a}, SCon{Chr{b}, t}}}:
      +ab = Laws.and_left(B.hex(a) && B.hex(b), B.uri(t, q), ok)
      at = hex_free(a, Laws.and_left(B.hex(a), B.hex(b), ab))
      bt = hex_free(b, Laws.and_right(B.hex(a), B.hex(b), ab))
      tt = Laws.uri_free(t, q, Laws.and_right(B.hex(a) && B.hex(b), B.uri(t, q), ok))
      and_true(Bool.not(U32.is_eq(a, 32)), Bool.not(U32.is_eq(b, 32)) && Support.free(t), at, and_true(Bool.not(U32.is_eq(b, 32)), Support.free(t), bt, tt))
    case SCon{Chr{37}, SNil{}}:
      match q:
        case False{}:
          E.absurd({Support.free(SCon{Chr{37}, SNil{}}) == True{} : Bool}, E.false_true(ok))
        case True{}:
          E.absurd({Support.free(SCon{Chr{37}, SNil{}}) == True{} : Bool}, E.false_true(ok))
    case SCon{Chr{37}, SCon{h, SNil{}}}:
      match q:
        case False{}:
          E.absurd({Support.free(SCon{Chr{37}, SCon{h, SNil{}}}) == True{} : Bool}, E.false_true(ok))
        case True{}:
          E.absurd({Support.free(SCon{Chr{37}, SCon{h, SNil{}}}) == True{} : Bool}, E.false_true(ok))
    case SCon{Chr{U32{WCon{False{}, bits}}}, t}:
      uri_free_step(U32{WCon{False{}, bits}}, t, q, ok, Laws.uri_free(t, q, Laws.and_right(B.uri_char(U32{WCon{False{}, bits}}, q), B.uri(t, q), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, bits}}}}, t}:
      uri_free_step(U32{WCon{True{}, WCon{True{}, bits}}}, t, q, ok, Laws.uri_free(t, q, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{True{}, bits}}}, q), B.uri(t, q), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, WCon{False{}, bits}}}}}, t}:
      uri_free_step(U32{WCon{True{}, WCon{False{}, WCon{False{}, bits}}}}, t, q, ok, Laws.uri_free(t, q, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{False{}, WCon{False{}, bits}}}}, q), B.uri(t, q), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}}, t}:
      uri_free_step(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}, t, q, ok, Laws.uri_free(t, q, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}, q), B.uri(t, q), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}}, t}:
      uri_free_step(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}, t, q, ok, Laws.uri_free(t, q, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}, q), B.uri(t, q), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, bits}}}}}}}}, t}:
      uri_free_step(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, bits}}}}}}}, t, q, ok, Laws.uri_free(t, q, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, bits}}}}}}}, q), B.uri(t, q), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}}}}}, t}:
      uri_free_step(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}}}}, t, q, ok, Laws.uri_free(t, q, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}}}}, q), B.uri(t, q), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}, t}:
