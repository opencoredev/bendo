def not_true_false(b: Bool, e: {Bool.not(b) == True{} : Bool}) -> {b == False{} : Bool}:
  match b:
    case False{}:
      {==}
    case True{}:
      E.absurd({True{} == False{} : Bool}, E.false_true(e))

# Splitting after a space-freeproof prefix preserves that whole prefix.
def Laws.split_free(s, rest, ok):
  match s:
    case SNil{}:
      {==}
    case SCon{Chr{c}, t}:
      no = Laws.and_left(Bool.not(U32.is_eq(c, 32)), Support.free(t), ok)
      tail = Laws.split_free(t, rest, Laws.and_right(Bool.not(U32.is_eq(c, 32)), Support.free(t), ok))
      e1 = not_true_false(U32.is_eq(c, 32), no)
      Equal.trans(List<&2, String>, String.split.fin(Chr{c}, String.split(t ++ " " ++ rest, ' '), Char.is_eq(Chr{c}, ' ')), String.split.fin(Chr{c}, String.split(t ++ " " ++ rest, ' '), False{}), SCon{Chr{c}, t} <> String.split(rest, ' '), Equal.cong(Bool, List<&2, String>, same => String.split.fin(Chr{c}, String.split(t ++ " " ++ rest, ' '), same), Char.is_eq(Chr{c}, ' '), False{}, e1), Equal.cong(List<&2, String>, List<&2, String>, parts => String.split.push(Chr{c}, parts), String.split(t ++ " " ++ rest, ' '), t <> String.split(rest, ' '), tail))

# Paths contain no query delimiter; queries may contain it freely.
def path_char_clear(+c: U32, ok: {B.uri_char(c, False{}) == True{} : Bool}) -> {Bool.not(U32.is_eq(c, 63)) == True{} : Bool}:
  not_false(U32.is_eq(c, 63), excludes(c, 63, x => B.uri_char(x, False{}), ok, {==}, U32.is_eq(c, 63), {==}))

def hex_path_clear(+c: U32, ok: {B.hex(c) == True{} : Bool}) -> {Bool.not(U32.is_eq(c, 63)) == True{} : Bool}:
  not_false(U32.is_eq(c, 63), excludes(c, 63, x => B.hex(x), ok, {==}, U32.is_eq(c, 63), {==}))

def path_clear_step(+c: U32, +t: String, ok: {B.uri_char(c, False{}) && B.uri(t, False{}) == True{} : Bool}, tail: {Support.path_clear(t) == True{} : Bool}) -> {Support.path_clear(SCon{Chr{c}, t}) == True{} : Bool}:
  and_true(Bool.not(U32.is_eq(c, 63)), Support.path_clear(t), path_char_clear(c, Laws.and_left(B.uri_char(c, False{}), B.uri(t, False{}), ok)), tail)

# Valid raw path text cannot contain a query separator.
def Laws.uri_path_clear(s, ok):
  match s:
    case SNil{}:
      {==}
    case SCon{Chr{37}, SCon{Chr{a}, SCon{Chr{b}, t}}}:
      +ab = Laws.and_left(B.hex(a) && B.hex(b), B.uri(t, False{}), ok)
      at = hex_path_clear(a, Laws.and_left(B.hex(a), B.hex(b), ab))
      bt = hex_path_clear(b, Laws.and_right(B.hex(a), B.hex(b), ab))
      tt = Laws.uri_path_clear(t, Laws.and_right(B.hex(a) && B.hex(b), B.uri(t, False{}), ok))
      and_true(Bool.not(U32.is_eq(a, 63)), Bool.not(U32.is_eq(b, 63)) && Support.path_clear(t), at, and_true(Bool.not(U32.is_eq(b, 63)), Support.path_clear(t), bt, tt))
    case SCon{Chr{37}, SNil{}}:
      {==}
    case SCon{Chr{37}, SCon{h, SNil{}}}:
      E.absurd({Support.path_clear(SCon{Chr{37}, SCon{h, SNil{}}}) == True{} : Bool}, E.false_true(ok))
    case SCon{Chr{U32{WCon{False{}, bits}}}, t}:
      path_clear_step(U32{WCon{False{}, bits}}, t, ok, Laws.uri_path_clear(t, Laws.and_right(B.uri_char(U32{WCon{False{}, bits}}, False{}), B.uri(t, False{}), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, bits}}}}, t}:
      path_clear_step(U32{WCon{True{}, WCon{True{}, bits}}}, t, ok, Laws.uri_path_clear(t, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{True{}, bits}}}, False{}), B.uri(t, False{}), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, WCon{False{}, bits}}}}}, t}:
      path_clear_step(U32{WCon{True{}, WCon{False{}, WCon{False{}, bits}}}}, t, ok, Laws.uri_path_clear(t, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{False{}, WCon{False{}, bits}}}}, False{}), B.uri(t, False{}), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}}, t}:
      path_clear_step(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}, t, ok, Laws.uri_path_clear(t, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}, False{}), B.uri(t, False{}), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}}, t}:
      path_clear_step(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}, t, ok, Laws.uri_path_clear(t, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}, False{}), B.uri(t, False{}), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, bits}}}}}}}}, t}:
      path_clear_step(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, bits}}}}}}}, t, ok, Laws.uri_path_clear(t, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, bits}}}}}}}, False{}), B.uri(t, False{}), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}}}}}, t}:
      path_clear_step(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}}}}, t, ok, Laws.uri_path_clear(t, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{True{}, bits}}}}}}}}, False{}), B.uri(t, False{}), ok)))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}}, t}:
      path_clear_step(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}, t, ok, Laws.uri_path_clear(t, Laws.and_right(B.uri_char(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, bits}}}}}}}}}, False{}), B.uri(t, False{}), ok)))
