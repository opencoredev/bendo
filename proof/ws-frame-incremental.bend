# Proof of ws_decode_incremental and ws_decode_chunks (BND-95). Does not
# import LAWS.bend. Generated by scripts/ws-frame-proofs/gen-incremental.py.
#
# Every decoder stage gets an append lemma: on xs ++ ys it returns `cont` of
# what it returns on xs. A shortfall decodes again on the longer buffer,
# progress resumes on ys, a frame keeps ys after its rest, a rejection stays.
# The read loop then follows by induction over the chunks.
import Base
import ../src/data/utf8.bend as Utf8
import ../src/ws/frame.bend as F
import ./ws-frame-laws.bend as WL

def cont(d: F.Decoded, again: F.Decoded, ys: List<&2, U32>) -> F.Decoded:
  match d:
    case F.NeedMore{_}:
      again
    case F.Partial{b}:
      F.resume(b, ys)
    case F.Got{f, k, rest}:
      F.Got{f, k, List.append(&2, U32, rest, ys)}
    case F.Reject{c}:
      F.Reject{c}

def tcont(+key: Maybe<&2, F.Key>, t: F.Taken, ys: List<&2, U32>) -> F.Taken:
  match t:
    case F.Took{ok, acc, rest}:
      F.Took{ok, acc, List.append(&2, U32, rest, ys)}
    case F.Short{ok, rot, left, acc}:
      F.take_rot(key, rot, left, ys, acc, ok)

def append_nil(+xs: List<&2, U32>) -> {List.append(&2, U32, xs, []) == xs : List<&2, U32>}:
  match xs:
    case Nil{}:
      {==}
    case +h <> t:
      %append_nil(t) : {h <> List.append(&2, U32, t, []) == h <> _ : List<&2, U32>}
      {==}

def append_assoc(+xs: List<&2, U32>, +ys: List<&2, U32>, +zs: List<&2, U32>) -> {List.append(&2, U32, List.append(&2, U32, xs, ys), zs) == List.append(&2, U32, xs, List.append(&2, U32, ys, zs)) : List<&2, U32>}:
  match xs:
    case Nil{}:
      {==}
    case +h <> t:
      %append_assoc(t, ys, zs) : {h <> List.append(&2, U32, List.append(&2, U32, t, ys), zs) == h <> _ : List<&2, U32>}
      {==}

# Payload bytes.

def plain_app(n: Nat, +xs: List<&2, U32>, +ys: List<&2, U32>, +acc: List<&2, U32>, +ok: Bool) -> {F.take_plain(n, List.append(&2, U32, xs, ys), acc, ok) == tcont(None{}, F.take_plain(n, xs, acc, ok), ys) : F.Taken}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match xs:
        case Nil{}:
          {==}
        case +x <> t:
          plain_app(p, t, ys, x <> acc, ok && F.is_octet(x))

def mask_app(n: Nat, +xs: List<&2, U32>, +ys: List<&2, U32>, +a: U32, +b: U32, +c: U32, +d: U32, +acc: List<&2, U32>, +ok: Bool, +k: F.Key) -> {F.take_mask(n, List.append(&2, U32, xs, ys), a, b, c, d, acc, ok) == tcont(Some{k}, F.take_mask(n, xs, a, b, c, d, acc, ok), ys) : F.Taken}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match xs:
        case Nil{}:
          {==}
        case +x <> t:
          mask_app(p, t, ys, b, c, d, a, U32.xor(x, a) <> acc, ok && F.is_octet(x), k)

def take_with_app(+key: Maybe<&2, F.Key>, +n: Nat, +xs: List<&2, U32>, +ys: List<&2, U32>, +acc: List<&2, U32>, +ok: Bool) -> {F.take_with(key, n, List.append(&2, U32, xs, ys), acc, ok) == tcont(key, F.take_with(key, n, xs, acc, ok), ys) : F.Taken}:
  match key:
    case None{}:
      plain_app(n, xs, ys, acc, ok)
    case Some{F.MaskKey{+a, +b, +c, +d}}:
      mask_app(n, xs, ys, a, b, c, d, acc, ok, F.MaskKey{a, b, c, d})

def take_rot_app(+key: Maybe<&2, F.Key>, +rot: F.Key, +n: Nat, +xs: List<&2, U32>, +ys: List<&2, U32>, +acc: List<&2, U32>, +ok: Bool) -> {F.take_rot(key, rot, n, List.append(&2, U32, xs, ys), acc, ok) == tcont(key, F.take_rot(key, rot, n, xs, acc, ok), ys) : F.Taken}:
  match key:
    case None{}:
      plain_app(n, xs, ys, acc, ok)
    case Some{+k}:
      match rot:
        case F.MaskKey{+a, +b, +c, +d}:
          mask_app(n, xs, ys, a, b, c, d, acc, ok, k)

# `finish` never asks for a restart, so the restart argument is free.
def finish_app(+fin: Bool, +op: F.Opcode, +key: Maybe<&2, F.Key>, t: F.Taken, +ys: List<&2, U32>, again: F.Decoded) -> {F.finish(fin, op, key, tcont(key, t, ys)) == cont(F.finish(fin, op, key, t), again, ys) : F.Decoded}:
  match t:
    case F.Took{ok, acc, rest}:
      match ok:
        case True{}:
          {==}
        case False{}:
          {==}
    case F.Short{ok, rot, left, acc}:
      {==}

def resume_app(b: F.Body, +xs: List<&2, U32>, +ys: List<&2, U32>, again: F.Decoded) -> {F.resume(b, List.append(&2, U32, xs, ys)) == cont(F.resume(b, xs), again, ys) : F.Decoded}:
  match b:
    case F.Body{+fin, +op, +key, +rot, +left, +acc, +ok}:
      %Equal.sym(F.Taken, F.take_rot(key, rot, left, List.append(&2, U32, xs, ys), acc, ok), tcont(key, F.take_rot(key, rot, left, xs, acc, ok), ys), take_rot_app(key, rot, left, xs, ys, acc, ok)) : {F.finish(fin, op, key, _) == cont(F.resume(F.Body{fin, op, key, rot, left, acc, ok}, xs), again, ys) : F.Decoded}
      finish_app(fin, op, key, F.take_rot(key, rot, left, xs, acc, ok), ys, again)

def body_app(+fin: Bool, +op: F.Opcode, +key: Maybe<&2, F.Key>, +n: U32, +xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.body(fin, op, key, n, List.append(&2, U32, xs, ys)) == cont(F.body(fin, op, key, n, xs), F.body(fin, op, key, n, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  %Equal.sym(F.Taken, F.take_with(key, U32.to_nat(n), List.append(&2, U32, xs, ys), [], True{}), tcont(key, F.take_with(key, U32.to_nat(n), xs, [], True{}), ys), take_with_app(key, U32.to_nat(n), xs, ys, [], True{})) : {F.finish(fin, op, key, _) == cont(F.body(fin, op, key, n, xs), F.body(fin, op, key, n, List.append(&2, U32, xs, ys)), ys) : F.Decoded}
  finish_app(fin, op, key, F.take_with(key, U32.to_nat(n), xs, [], True{}), ys, F.body(fin, op, key, n, List.append(&2, U32, xs, ys)))

# Header stages, last to first.

def with_key_app(+a: U32, +b: U32, +c: U32, +d: U32, +fin: Bool, +op: F.Opcode, +n: U32, +xs: List<&2, U32>, ok: Bool, +ys: List<&2, U32>) -> {F.with_key(a, b, c, d, fin, op, n, List.append(&2, U32, xs, ys), ok) == cont(F.with_key(a, b, c, d, fin, op, n, xs, ok), F.with_key(a, b, c, d, fin, op, n, List.append(&2, U32, xs, ys), ok), ys) : F.Decoded}:
  match ok:
    case True{}:
      body_app(fin, op, Some{F.MaskKey{a, b, c, d}}, n, xs, ys)
    case False{}:
      {==}

def read_key_app(masked: Bool, +fin: Bool, +op: F.Opcode, +n: U32, xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.read_key(masked, fin, op, n, List.append(&2, U32, xs, ys)) == cont(F.read_key(masked, fin, op, n, xs), F.read_key(masked, fin, op, n, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  match masked:
    case False{}:
      body_app(fin, op, None{}, n, xs, ys)
    case True{}:
      match xs:
        case Nil{}:
          {==}
        case _ <> Nil{}:
          {==}
        case _ <> _ <> Nil{}:
          {==}
        case _ <> _ <> _ <> Nil{}:
          {==}
        case +a <> +b <> +c <> +d <> t:
          with_key_app(a, b, c, d, fin, op, n, t, F.key_octet(d, F.key_octet(c, F.key_octet(b, F.key_octet(a, True{})))), ys)

def sized_app(fits: Bool, +masked: Bool, +fin: Bool, +op: F.Opcode, +n: U32, +xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.sized(fits, masked, fin, op, n, List.append(&2, U32, xs, ys)) == cont(F.sized(fits, masked, fin, op, n, xs), F.sized(fits, masked, fin, op, n, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  match fits:
    case True{}:
      read_key_app(masked, fin, op, n, xs, ys)
    case False{}:
      {==}

def length_known_app(+max: U32, +masked: Bool, +fin: Bool, +op: F.Opcode, +n: U32, +xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.length_known(max, masked, fin, op, n, List.append(&2, U32, xs, ys)) == cont(F.length_known(max, masked, fin, op, n, xs), F.length_known(max, masked, fin, op, n, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  sized_app(U32.is_le(n, max), masked, fin, op, n, xs, ys)

def minimal_app(ok: Bool, +max: U32, +masked: Bool, +fin: Bool, +op: F.Opcode, +n: U32, +xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.minimal(ok, max, masked, fin, op, n, List.append(&2, U32, xs, ys)) == cont(F.minimal(ok, max, masked, fin, op, n, xs), F.minimal(ok, max, masked, fin, op, n, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  match ok:
    case True{}:
      length_known_app(max, masked, fin, op, n, xs, ys)
    case False{}:
      {==}

def octets_then_app(octs: Bool, +ok: Bool, +max: U32, +masked: Bool, +fin: Bool, +op: F.Opcode, +n: U32, +xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.octets_then(octs, ok, max, masked, fin, op, n, List.append(&2, U32, xs, ys)) == cont(F.octets_then(octs, ok, max, masked, fin, op, n, xs), F.octets_then(octs, ok, max, masked, fin, op, n, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  match octs:
    case True{}:
      minimal_app(ok, max, masked, fin, op, n, xs, ys)
    case False{}:
      {==}

def upper_app(top: Bool, zeros: Bool, +max: U32, +masked: Bool, +fin: Bool, +op: F.Opcode, +b3: U32, +b2: U32, +b1: U32, +b0: U32, +xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.upper(top, zeros, max, masked, fin, op, b3, b2, b1, b0, List.append(&2, U32, xs, ys)) == cont(F.upper(top, zeros, max, masked, fin, op, b3, b2, b1, b0, xs), F.upper(top, zeros, max, masked, fin, op, b3, b2, b1, b0, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  match top:
    case True{}:
      {==}
    case False{}:
      match zeros:
        case False{}:
          {==}
        case True{}:
          octets_then_app(F.byte_ok(b0, F.byte_ok(b1, F.byte_ok(b2, F.byte_ok(b3, True{})))), Bool.not(U32.is_le(F.join32(b3, b2, b1, b0), 65535)), max, masked, fin, op, F.join32(b3, b2, b1, b0), xs, ys)

def ext64_app(+max: U32, +masked: Bool, +fin: Bool, +op: F.Opcode, xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.ext64(max, masked, fin, op, List.append(&2, U32, xs, ys)) == cont(F.ext64(max, masked, fin, op, xs), F.ext64(max, masked, fin, op, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  match xs:
    case +u3 <> +u2 <> +u1 <> +u0 <> +b3 <> +b2 <> +b1 <> +b0 <> t:
      upper_app((u3 >= 128 : U32), F.is_zero_byte(u0, F.is_zero_byte(u1, F.is_zero_byte(u2, F.is_zero_byte(u3, True{})))), max, masked, fin, op, b3, b2, b1, b0, t, ys)
    case Nil{}:
      {==}
    case _ <> Nil{}:
      {==}
    case _ <> _ <> Nil{}:
      {==}
    case _ <> _ <> _ <> Nil{}:
      {==}
    case _ <> _ <> _ <> _ <> Nil{}:
      {==}
    case _ <> _ <> _ <> _ <> _ <> Nil{}:
      {==}
    case _ <> _ <> _ <> _ <> _ <> _ <> Nil{}:
      {==}
    case _ <> _ <> _ <> _ <> _ <> _ <> _ <> Nil{}:
      {==}

def ext16_app(+max: U32, +masked: Bool, +fin: Bool, +op: F.Opcode, xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.ext16(max, masked, fin, op, List.append(&2, U32, xs, ys)) == cont(F.ext16(max, masked, fin, op, xs), F.ext16(max, masked, fin, op, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  match xs:
    case Nil{}:
      {==}
    case _ <> Nil{}:
      {==}
    case +hi <> +lo <> t:
      octets_then_app(F.byte_ok(lo, F.byte_ok(hi, True{})), Bool.not(U32.is_le(F.join16(hi, lo), 125)), max, masked, fin, op, F.join16(hi, lo), t, ys)

def extended_app(control: Bool, wide: Bool, +max: U32, +masked: Bool, +fin: Bool, +op: F.Opcode, +xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.extended(control, wide, max, masked, fin, op, List.append(&2, U32, xs, ys)) == cont(F.extended(control, wide, max, masked, fin, op, xs), F.extended(control, wide, max, masked, fin, op, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  match control:
    case True{}:
      {==}
    case False{}:
      match wide:
        case False{}:
          ext16_app(max, masked, fin, op, xs, ys)
        case True{}:
          ext64_app(max, masked, fin, op, xs, ys)

def length7_app(short: Bool, +len7: Word(7n), +max: U32, +masked: Bool, +fin: Bool, +op: F.Opcode, +xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.length7(short, len7, max, masked, fin, op, List.append(&2, U32, xs, ys)) == cont(F.length7(short, len7, max, masked, fin, op, xs), F.length7(short, len7, max, masked, fin, op, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  match short:
    case True{}:
      length_known_app(max, masked, fin, op, U32{Utf8.join(7n, 25n, len7, Word.zero(25n))}, xs, ys)
    case False{}:
      match len7:
        case WCon{+wide, +w}:
          extended_app(F.is_control(op), wide, max, masked, fin, op, xs, ys)

def masked_ok_app(ok: Bool, +short: Bool, +len7: Word(7n), +max: U32, +masked: Bool, +fin: Bool, +op: F.Opcode, +xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.masked_ok(ok, short, len7, max, masked, fin, op, List.append(&2, U32, xs, ys)) == cont(F.masked_ok(ok, short, len7, max, masked, fin, op, xs), F.masked_ok(ok, short, len7, max, masked, fin, op, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  match ok:
    case False{}:
      {==}
    case True{}:
      length7_app(short, len7, max, masked, fin, op, xs, ys)

def second_app(ok: Bool, w: Word(8n), +role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, +xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.second(ok, w, role, max, fin, op, List.append(&2, U32, xs, ys)) == cont(F.second(ok, w, role, max, fin, op, xs), F.second(ok, w, role, max, fin, op, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  match ok:
    case False{}:
      {==}
    case True{}:
      match w:
        case WCon{+l0, WCon{+l1, WCon{+l2, WCon{+l3, WCon{+l4, WCon{+l5, WCon{+l6, WCon{+m, WNil{}}}}}}}}}:
          masked_ok_app(F.role_mask(role, m), F.short7(WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}), WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}, max, m, fin, op, xs, ys)

def read_second_app(+role: F.Role, +max: U32, +fin: Bool, +op: F.Opcode, xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.read_second(role, max, fin, op, List.append(&2, U32, xs, ys)) == cont(F.read_second(role, max, fin, op, xs), F.read_second(role, max, fin, op, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  match xs:
    case Nil{}:
      {==}
    case +b <> t:
      second_app(F.byte_ok(b, True{}), F.bits(b), role, max, fin, op, t, ys)

def control_fin_app(bad: Bool, +op: F.Opcode, +fin: Bool, +role: F.Role, +max: U32, +xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.control_fin(bad, op, fin, role, max, List.append(&2, U32, xs, ys)) == cont(F.control_fin(bad, op, fin, role, max, xs), F.control_fin(bad, op, fin, role, max, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  match bad:
    case True{}:
      {==}
    case False{}:
      read_second_app(role, max, fin, op, xs, ys)

def with_opcode_app(op: Maybe<&2, F.Opcode>, +fin: Bool, +role: F.Role, +max: U32, +xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.with_opcode(op, fin, role, max, List.append(&2, U32, xs, ys)) == cont(F.with_opcode(op, fin, role, max, xs), F.with_opcode(op, fin, role, max, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  match op:
    case None{}:
      {==}
    case Some{+o}:
      control_fin_app(F.fragmented_control(F.is_control(o), fin), o, fin, role, max, xs, ys)

def reserved_app(clear: Bool, +op: Maybe<&2, F.Opcode>, +fin: Bool, +role: F.Role, +max: U32, +xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.reserved(clear, op, fin, role, max, List.append(&2, U32, xs, ys)) == cont(F.reserved(clear, op, fin, role, max, xs), F.reserved(clear, op, fin, role, max, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  match clear:
    case False{}:
      {==}
    case True{}:
      with_opcode_app(op, fin, role, max, xs, ys)

def first_app(ok: Bool, w: Word(8n), +role: F.Role, +max: U32, +xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.first(ok, w, role, max, List.append(&2, U32, xs, ys)) == cont(F.first(ok, w, role, max, xs), F.first(ok, w, role, max, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  match ok:
    case False{}:
      {==}
    case True{}:
      match w:
        case WCon{+o0, WCon{+o1, WCon{+o2, WCon{+o3, WCon{+r1, WCon{+r2, WCon{+r3, WCon{+fin, WNil{}}}}}}}}}:
          reserved_app(F.rsv_clear(r1, r2, r3), F.opcode_of(o0, o1, o2, o3), fin, role, max, xs, ys)

def start_app(cfg: F.Config, xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.start(cfg, List.append(&2, U32, xs, ys)) == cont(F.start(cfg, xs), F.start(cfg, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  match cfg:
    case F.Config{+role, +max}:
      match xs:
        case Nil{}:
          {==}
        case +b <> t:
          first_app(F.byte_ok(b, True{}), F.bits(b), role, max, t, ys)


# The connection's decode on a longer buffer, from either state.
def next_app(+cfg: F.Config, body: Maybe<&2, F.Body>, +xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.next(cfg, body, List.append(&2, U32, xs, ys)) == cont(F.next(cfg, body, xs), F.start(cfg, List.append(&2, U32, xs, ys)), ys) : F.Decoded}:
  match body:
    case None{}:
      start_app(cfg, xs, ys)
    case Some{b}:
      resume_app(b, xs, ys, F.start(cfg, List.append(&2, U32, xs, ys)))

# One read: whatever `d` is, the loop on chunk c then the rest t ends where
# `cont` puts d on all of them, given the loop's law for t from every state.
def feed_step(+cfg: F.Config, +t: List<&2, List<&2, U32>>, +c: List<&2, U32>, d: F.Decoded, +pending: List<&2, U32>, ih: @b: Maybe<&2, F.Body> -> @p: List<&2, U32> -> {F.feed_go(cfg, t, F.next(cfg, b, p), p) == F.next(cfg, b, List.append(&2, U32, p, List.concat(&2, U32, t))) : F.Decoded}) -> {F.feed_go(cfg, c <> t, d, pending) == cont(d, F.start(cfg, List.append(&2, U32, pending, List.append(&2, U32, c, List.concat(&2, U32, t)))), List.append(&2, U32, c, List.concat(&2, U32, t))) : F.Decoded}:
  match d:
    case F.NeedMore{_}:
      %append_assoc(pending, c, List.concat(&2, U32, t)) : {F.feed_go(cfg, t, F.next(cfg, None{}, List.append(&2, U32, pending, c)), List.append(&2, U32, pending, c)) == F.start(cfg, _) : F.Decoded}
      ih(None{}, List.append(&2, U32, pending, c))
    case F.Partial{b}:
      ih(Some{b}, c)
    case F.Got{f, k, rest}:
      {==}
    case F.Reject{code}:
      {==}

def feed_all(+cfg: F.Config, chunks: List<&2, List<&2, U32>>, +body: Maybe<&2, F.Body>, +pending: List<&2, U32>) -> {F.feed_go(cfg, chunks, F.next(cfg, body, pending), pending) == F.next(cfg, body, List.append(&2, U32, pending, List.concat(&2, U32, chunks))) : F.Decoded}:
  match chunks:
    case Nil{}:
      %Equal.sym(List<&2, U32>, List.append(&2, U32, pending, []), pending, append_nil(pending)) : {F.next(cfg, body, pending) == F.next(cfg, body, _) : F.Decoded}
      {==}
    case +c <> +t:
      %Equal.sym(F.Decoded, F.next(cfg, body, List.append(&2, U32, pending, List.append(&2, U32, c, List.concat(&2, U32, t)))), cont(F.next(cfg, body, pending), F.start(cfg, List.append(&2, U32, pending, List.append(&2, U32, c, List.concat(&2, U32, t)))), List.append(&2, U32, c, List.concat(&2, U32, t))), next_app(cfg, body, pending, List.append(&2, U32, c, List.concat(&2, U32, t)))) : {F.feed_go(cfg, c <> t, F.next(cfg, body, pending), pending) == _ : F.Decoded}
      feed_step(cfg, t, c, F.next(cfg, body, pending), pending, b => p => feed_all(cfg, t, b, p))

def WL.ws_decode_incremental(cfg, body, pending, chunks):
  feed_all(cfg, chunks, body, pending)

def WL.ws_decode_chunks(cfg, chunks):
  %Equal.sym(F.Decoded, F.feed_go(cfg, chunks, F.next(cfg, None{}, []), []), F.next(cfg, None{}, List.append(&2, U32, [], List.concat(&2, U32, chunks))), feed_all(cfg, chunks, None{}, [])) : {F.settle(_) == F.decode(cfg, List.concat(&2, U32, chunks)) : F.Decoded}
  {==}
