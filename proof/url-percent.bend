                                                                    lit_step(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, w31}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, t, rev, equiv(t, U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, w31}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}} <> rev))
                                                                   case WCon{False{}, +w31}:
                                                                    match w31:
                                                                     case WCon{True{}, +w32}:
                                                                      lit_step(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, w32}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, t, rev, equiv(t, U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, w32}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}} <> rev))
                                                                     case WCon{False{}, +w32}:
                                                                      match w32:
                                                                       case WNil{}:
                                                                        match t:
                                                                         case Nil{}: {==}
                                                                         case +a <> Nil{}: {==}
                                                                         case +a <> +b <> +u: esc(a, b, u, rev, r => equiv(u, r))
                 case WCon{False{}, +w6}:
                  lit_step(U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, w6}}}}}}}, t, rev, equiv(t, U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, w6}}}}}}} <> rev))
           case WCon{False{}, +w3}:
            lit_step(U32{WCon{True{}, WCon{False{}, WCon{False{}, w3}}}}, t, rev, equiv(t, U32{WCon{True{}, WCon{False{}, WCon{False{}, w3}}}} <> rev))
       case WCon{False{}, +w1}:
        lit_step(U32{WCon{False{}, w1}}, t, rev, equiv(t, U32{WCon{False{}, w1}} <> rev))

def percent(+xs: List<&2, U32>) -> {Url.percent_decode(xs, False{}) == Spec.unpercent(xs) : Result<&2, &2, Url.Error, List<&2, U32>>}:
  Equal.trans(Result<&2, &2, Url.Error, List<&2, U32>>, Url.percent_decode(xs, False{}), prepend([], Spec.unpercent(xs)), Spec.unpercent(xs), equiv(xs, []), prepend_nil(Spec.unpercent(xs)))
