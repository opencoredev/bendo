# Proofs of the BND-51 roundtrip laws. Does not import LAWS.bend.
import Base
import ./ws-frame-spec.bend as S
import ./ws-frame.bend as P
import ./ws-frame-laws.bend as WL
import ./utf8.bend as UP
import ./chunked-arith.bend as A
import ./crypto-octets.bend as OP
import ../src/data/utf8.bend as Utf8
import ../src/ws/frame.bend as F

# Payload stage, unmasked: reading exactly the payload's length leaves the
# trailing bytes and the payload, reversed onto the accumulator.
def take_plain_append(+p: List<&2, U32>, +rest: List<&2, U32>, +acc: List<&2, U32>, +ok: Bool) -> {F.take_plain(List.length(&2, U32, p), List.append(&2, U32, p, rest), acc, ok) == F.Took{F.octets(p, ok), List.reverse.go(&2, U32, p, acc), rest} : F.Taken}:
  match p:
    case Nil{}:
      {==}
    case x <> t:
      take_plain_append(t, rest, x <> acc, ok && F.is_octet(x))

# Payload stage, masked: unmasking the masked payload restores it.
def take_mask_append(+p: List<&2, U32>, +rest: List<&2, U32>, +a: U32, +b: U32, +c: U32, +d: U32, +acc: List<&2, U32>, +ok: Bool) -> {F.take_mask(List.length(&2, U32, p), List.append(&2, U32, S.mask(p, F.MaskKey{a, b, c, d}), rest), a, b, c, d, acc, ok) == F.Took{F.octets(S.mask(p, F.MaskKey{a, b, c, d}), ok), List.reverse.go(&2, U32, S.mask(S.mask(p, F.MaskKey{a, b, c, d}), F.MaskKey{a, b, c, d}), acc), rest} : F.Taken}:
  match p:
    case Nil{}:
      {==}
    case x <> t:
      take_mask_append(t, rest, b, c, d, a, U32.xor(U32.xor(x, a), a) <> acc, ok && F.is_octet(U32.xor(x, a)))

def octets_true(+p: List<&2, U32>, ok: {S.octets(p) == True{} : Bool}) -> {F.octets(p, True{}) == True{} : Bool}:
  Equal.trans(Bool, F.octets(p, True{}), True{} && S.octets(p), True{}, P.octets_acc(p, True{}), ok)

# After the header: an unmasked payload of exactly `u` octets decodes to the
# frame and leaves the trailing bytes.
def body_plain(+fin: Bool, +op: F.Opcode, +u: U32, +p: List<&2, U32>, +rest: List<&2, U32>, len: {U32.to_nat(u) == List.length(&2, U32, p) : Nat}, oct: {S.octets(p) == True{} : Bool}) -> {F.body(fin, op, None{}, u, List.append(&2, U32, p, rest)) == F.Got{F.Frame{fin, op, p}, None{}, rest} : F.Decoded}:
  %Equal.sym(Nat, U32.to_nat(u), List.length(&2, U32, p), len) : {F.finish(fin, op, None{}, F.take_plain(_, List.append(&2, U32, p, rest), [], True{})) == F.Got{F.Frame{fin, op, p}, None{}, rest} : F.Decoded}
  %Equal.sym(F.Taken, F.take_plain(List.length(&2, U32, p), List.append(&2, U32, p, rest), [], True{}), F.Took{F.octets(p, True{}), List.reverse.go(&2, U32, p, []), rest}, take_plain_append(p, rest, [], True{})) : {F.finish(fin, op, None{}, _) == F.Got{F.Frame{fin, op, p}, None{}, rest} : F.Decoded}
  %Equal.sym(Bool, F.octets(p, True{}), True{}, octets_true(p, oct)) : {F.finish(fin, op, None{}, F.Took{_, List.reverse.go(&2, U32, p, []), rest}) == F.Got{F.Frame{fin, op, p}, None{}, rest} : F.Decoded}
  %Equal.sym(List<&2, U32>, List.reverse(&2, U32, List.reverse(&2, U32, p)), p, P.reverse_reverse(p)) : {F.Got{F.Frame{fin, op, _}, None{}, rest} == F.Got{F.Frame{fin, op, p}, None{}, rest} : F.Decoded}
  {==}

# Header stage, 7-bit length, unmasked: the second byte leads to the payload.
def short_plain(+fin: Bool, +op: F.Opcode, +l0: Bool, +l1: Bool, +l2: Bool, +l3: Bool, +l4: Bool, +l5: Bool, +l6: Bool, +max: U32, +p: List<&2, U32>, +rest: List<&2, U32>, sh: {F.short7(WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}) == True{} : Bool}, fits: {U32.is_le(U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}}, max) == True{} : Bool}, len: {U32.to_nat(U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}}) == List.length(&2, U32, p) : Nat}, oct: {S.octets(p) == True{} : Bool}) -> {F.read_second(F.Client{}, max, fin, op, F.second_byte(WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}, False{}) <> List.append(&2, U32, p, rest)) == F.Got{F.Frame{fin, op, p}, None{}, rest} : F.Decoded}:
  %Equal.sym(Bool, F.short7(WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}), True{}, sh) : {F.length7(_, WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}, max, False{}, fin, op, List.append(&2, U32, p, rest)) == F.Got{F.Frame{fin, op, p}, None{}, rest} : F.Decoded}
  %Equal.sym(Bool, U32.is_le(U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}}, max), True{}, fits) : {F.sized(_, False{}, fin, op, U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}}, List.append(&2, U32, p, rest)) == F.Got{F.Frame{fin, op, p}, None{}, rest} : F.Decoded}
  body_plain(fin, op, U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}}, p, rest, len, oct)

# First byte: an encoded opcode and FIN, with clear RSV bits, lead to the
# second byte whenever a control frame is final.
def start_first(+fin: Bool, +op: F.Opcode, +role: F.Role, +max: U32, +t: List<&2, U32>, ctl: {F.fragmented_control(F.is_control(op), fin) == False{} : Bool}) -> {F.start(F.Config{role, max}, F.first_byte(fin, op) <> t) == F.read_second(role, max, fin, op, t) : F.Decoded}:
  match op:
    case F.OpContinue{}:
      {==}
    case F.OpText{}:
      {==}
    case F.OpBinary{}:
      {==}
    case F.OpClose{}:
      %Equal.sym(Bool, Bool.not(fin), False{}, ctl) : {F.control_fin(_, F.OpClose{}, fin, role, max, t) == F.read_second(role, max, fin, F.OpClose{}, t) : F.Decoded}
      {==}
    case F.OpPing{}:
      %Equal.sym(Bool, Bool.not(fin), False{}, ctl) : {F.control_fin(_, F.OpPing{}, fin, role, max, t) == F.read_second(role, max, fin, F.OpPing{}, t) : F.Decoded}
      {==}
    case F.OpPong{}:
      %Equal.sym(Bool, Bool.not(fin), False{}, ctl) : {F.control_fin(_, F.OpPong{}, fin, role, max, t) == F.read_second(role, max, fin, F.OpPong{}, t) : F.Decoded}
      {==}

# Header stage, 16-bit length, unmasked.
def medium_plain(+fin: Bool, +op: F.Opcode, +b0: Bool, +b1: Bool, +b2: Bool, +b3: Bool, +b4: Bool, +b5: Bool, +b6: Bool, +b7: Bool, +b8: Bool, +b9: Bool, +b10: Bool, +b11: Bool, +b12: Bool, +b13: Bool, +b14: Bool, +b15: Bool, +max: U32, +p: List<&2, U32>, +rest: List<&2, U32>, dat: {F.is_control(op) == False{} : Bool}, long: {U32.is_le(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WCon{b8, WCon{b9, WCon{b10, WCon{b11, WCon{b12, WCon{b13, WCon{b14, WCon{b15, Word.zero(16n)}}}}}}}}}}}}}}}}}, 125) == False{} : Bool}, fits: {U32.is_le(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WCon{b8, WCon{b9, WCon{b10, WCon{b11, WCon{b12, WCon{b13, WCon{b14, WCon{b15, Word.zero(16n)}}}}}}}}}}}}}}}}}, max) == True{} : Bool}, len: {U32.to_nat(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WCon{b8, WCon{b9, WCon{b10, WCon{b11, WCon{b12, WCon{b13, WCon{b14, WCon{b15, Word.zero(16n)}}}}}}}}}}}}}}}}}) == List.length(&2, U32, p) : Nat}, oct: {S.octets(p) == True{} : Bool}) -> {F.read_second(F.Client{}, max, fin, op, F.second_byte(F.c126(), False{}) <> F.byte1(WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WCon{b8, WCon{b9, WCon{b10, WCon{b11, WCon{b12, WCon{b13, WCon{b14, WCon{b15, Word.zero(16n)}}}}}}}}}}}}}}}}) <> F.byte0(WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WCon{b8, WCon{b9, WCon{b10, WCon{b11, WCon{b12, WCon{b13, WCon{b14, WCon{b15, Word.zero(16n)}}}}}}}}}}}}}}}}) <> List.append(&2, U32, p, rest)) == F.Got{F.Frame{fin, op, p}, None{}, rest} : F.Decoded}:
  %Equal.sym(Bool, F.is_control(op), False{}, dat) : {F.extended(_, False{}, max, False{}, fin, op, F.byte1(WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WCon{b8, WCon{b9, WCon{b10, WCon{b11, WCon{b12, WCon{b13, WCon{b14, WCon{b15, Word.zero(16n)}}}}}}}}}}}}}}}}) <> F.byte0(WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WCon{b8, WCon{b9, WCon{b10, WCon{b11, WCon{b12, WCon{b13, WCon{b14, WCon{b15, Word.zero(16n)}}}}}}}}}}}}}}}}) <> List.append(&2, U32, p, rest)) == F.Got{F.Frame{fin, op, p}, None{}, rest} : F.Decoded}
  %Equal.sym(Bool, U32.is_le(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WCon{b8, WCon{b9, WCon{b10, WCon{b11, WCon{b12, WCon{b13, WCon{b14, WCon{b15, Word.zero(16n)}}}}}}}}}}}}}}}}}, 125), False{}, long) : {F.minimal(Bool.not(_), max, False{}, fin, op, U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WCon{b8, WCon{b9, WCon{b10, WCon{b11, WCon{b12, WCon{b13, WCon{b14, WCon{b15, Word.zero(16n)}}}}}}}}}}}}}}}}}, List.append(&2, U32, p, rest)) == F.Got{F.Frame{fin, op, p}, None{}, rest} : F.Decoded}
  %Equal.sym(Bool, U32.is_le(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WCon{b8, WCon{b9, WCon{b10, WCon{b11, WCon{b12, WCon{b13, WCon{b14, WCon{b15, Word.zero(16n)}}}}}}}}}}}}}}}}}, max), True{}, fits) : {F.sized(_, False{}, fin, op, U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WCon{b8, WCon{b9, WCon{b10, WCon{b11, WCon{b12, WCon{b13, WCon{b14, WCon{b15, Word.zero(16n)}}}}}}}}}}}}}}}}}, List.append(&2, U32, p, rest)) == F.Got{F.Frame{fin, op, p}, None{}, rest} : F.Decoded}
  body_plain(fin, op, U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WCon{b8, WCon{b9, WCon{b10, WCon{b11, WCon{b12, WCon{b13, WCon{b14, WCon{b15, Word.zero(16n)}}}}}}}}}}}}}}}}}, p, rest, len, oct)

