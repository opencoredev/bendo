# A control frame the RFC allows is final.
def ctl_final(+op: F.Opcode, +fin: Bool, +n: Nat, cv: {S.control_valid(op, fin, n) == True{} : Bool}) -> {F.fragmented_control(F.is_control(op), fin) == False{} : Bool}:
  match op fin:
    case F.OpContinue{} _:
      {==}
    case F.OpText{} _:
      {==}
    case F.OpBinary{} _:
      {==}
    case F.OpClose{} True{}:
      {==}
    case F.OpClose{} False{}:
      UP.absurd({F.fragmented_control(F.is_control(F.OpClose{}), False{}) == False{} : Bool}, UP.false_true(cv))
    case F.OpPing{} True{}:
      {==}
    case F.OpPing{} False{}:
      UP.absurd({F.fragmented_control(F.is_control(F.OpPing{}), False{}) == False{} : Bool}, UP.false_true(cv))
    case F.OpPong{} True{}:
      {==}
    case F.OpPong{} False{}:
      UP.absurd({F.fragmented_control(F.is_control(F.OpPong{}), False{}) == False{} : Bool}, UP.false_true(cv))

# A frame longer than 125 bytes that the RFC allows is a data frame.
def data_only(+op: F.Opcode, +fin: Bool, +n: Nat, cv: {S.control_valid(op, fin, n) == True{} : Bool}, +big: {Nat.is_le(n, 125n) == False{} : Bool}) -> {F.is_control(op) == False{} : Bool}:
  match op:
    case F.OpContinue{}:
      {==}
    case F.OpText{}:
      {==}
    case F.OpBinary{}:
      {==}
    case F.OpClose{}:
      UP.absurd({F.is_control(F.OpClose{}) == False{} : Bool}, UP.false_true(Equal.trans(Bool, False{}, Nat.is_le(n, 125n), True{}, Equal.sym(Bool, Nat.is_le(n, 125n), False{}, big), UP.and_right(fin, Nat.is_le(n, 125n), cv))))
    case F.OpPing{}:
      UP.absurd({F.is_control(F.OpPing{}) == False{} : Bool}, UP.false_true(Equal.trans(Bool, False{}, Nat.is_le(n, 125n), True{}, Equal.sym(Bool, Nat.is_le(n, 125n), False{}, big), UP.and_right(fin, Nat.is_le(n, 125n), cv))))
    case F.OpPong{}:
      UP.absurd({F.is_control(F.OpPong{}) == False{} : Bool}, UP.false_true(Equal.trans(Bool, False{}, Nat.is_le(n, 125n), True{}, Equal.sym(Bool, Nat.is_le(n, 125n), False{}, big), UP.and_right(fin, Nat.is_le(n, 125n), cv))))

def short_nat(+w: Word(32n), +n: Nat, len: {U32.to_nat(U32{w}) == n : Nat}) -> {U32.is_le(U32{w}, 125) == Nat.is_le(n, 125n) : Bool}:
  Equal.trans(Bool, U32.is_le(U32{w}, 125), Nat.is_le(U32.to_nat(U32{w}), U32.to_nat(125)), Nat.is_le(n, 125n), A.u32_nat_le(U32{w}, 125), Equal.cong(Nat, Bool, x => Nat.is_le(x, U32.to_nat(125)), U32.to_nat(U32{w}), n, len))

