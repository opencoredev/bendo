def header_go(+fin: Bool, +op: F.Opcode, +max: U32, +p: List<&2, U32>, +rest: List<&2, U32>, +w: Word(32n), +s: Bool, +md: Bool, es: {U32.is_le(U32{w}, 125) == s : Bool}, em: {U32.is_le(U32{w}, 65535) == md : Bool}, fits: {U32.is_le(U32{w}, max) == True{} : Bool}, len: {U32.to_nat(U32{w}) == List.length(&2, U32, p) : Nat}, oct: {S.octets(p) == True{} : Bool}, cv: {S.control_valid(op, fin, List.length(&2, U32, p)) == True{} : Bool}) -> {F.read_second(F.Client{}, max, fin, op, List.append(&2, U32, List.append(&2, U32, F.length_bytes(False{}, w, s, md), p), rest)) == F.Got{F.Frame{fin, op, p}, None{}, rest} : F.Decoded}:
  match s md:
    case True{} _:
      short_case(fin, op, max, p, rest, w, es, fits, len, oct, cv)
    case False{} True{}:
      medium_case(fin, op, max, p, rest, w, es, em, fits, len, oct, cv)
    case False{} False{}:
      long_case(fin, op, max, p, rest, w, es, em, fits, len, oct, cv)

def header_u(+fin: Bool, +op: F.Opcode, +max: U32, +p: List<&2, U32>, +rest: List<&2, U32>, +u: U32, fits: {U32.is_le(u, max) == True{} : Bool}, len: {U32.to_nat(u) == List.length(&2, U32, p) : Nat}, oct: {S.octets(p) == True{} : Bool}, cv: {S.control_valid(op, fin, List.length(&2, U32, p)) == True{} : Bool}) -> {F.read_second(F.Client{}, max, fin, op, List.append(&2, U32, List.append(&2, U32, F.header_with(None{}, u), p), rest)) == F.Got{F.Frame{fin, op, p}, None{}, rest} : F.Decoded}:
  match u:
    case U32{w}:
      header_go(fin, op, max, p, rest, w, U32.is_le(U32{w}, 125), U32.is_le(U32{w}, 65535), {==}, {==}, fits, len, oct, cv)

