  +nb = UP.and_right(S.control_valid(op, fin, List.length(&2, U32, payload)), Nat.is_le(List.length(&2, U32, payload), U32.to_nat(max)), l2)
  +len = Equal.trans(Nat, U32.to_nat(U32.from_nat(F.length(payload))), U32.to_nat(U32.from_nat(List.length(&2, U32, payload))), List.length(&2, U32, payload), Equal.cong(Nat, Nat, x => U32.to_nat(U32.from_nat(x)), F.length(payload), List.length(&2, U32, payload), P.length_eq(payload)), A.from_nat_exact(List.length(&2, U32, payload), max, nb))
  fits = Equal.trans(Bool, U32.is_le(U32.from_nat(F.length(payload)), max), Nat.is_le(U32.to_nat(U32.from_nat(F.length(payload))), U32.to_nat(max)), True{}, A.u32_nat_le(U32.from_nat(F.length(payload)), max), Equal.trans(Bool, Nat.is_le(U32.to_nat(U32.from_nat(F.length(payload))), U32.to_nat(max)), Nat.is_le(List.length(&2, U32, payload), U32.to_nat(max)), True{}, Equal.cong(Nat, Bool, x => Nat.is_le(x, U32.to_nat(max)), U32.to_nat(U32.from_nat(F.length(payload))), List.length(&2, U32, payload), len), nb))
  +cv = UP.and_left(S.control_valid(op, fin, List.length(&2, U32, payload)), Nat.is_le(List.length(&2, U32, payload), U32.to_nat(max)), l2)
  Equal.trans(F.Decoded, F.settle(F.start(F.Config{F.Client{}, max}, F.first_byte(fin, op) <> List.append(&2, U32, List.append(&2, U32, F.header_with(None{}, U32.from_nat(F.length(payload))), payload), rest))), F.settle(F.read_second(F.Client{}, max, fin, op, List.append(&2, U32, List.append(&2, U32, F.header_with(None{}, U32.from_nat(F.length(payload))), payload), rest))), F.Got{F.Frame{fin, op, payload}, None{}, rest},
    Equal.cong(F.Decoded, F.Decoded, d => F.settle(d), F.start(F.Config{F.Client{}, max}, F.first_byte(fin, op) <> List.append(&2, U32, List.append(&2, U32, F.header_with(None{}, U32.from_nat(F.length(payload))), payload), rest)), F.read_second(F.Client{}, max, fin, op, List.append(&2, U32, List.append(&2, U32, F.header_with(None{}, U32.from_nat(F.length(payload))), payload), rest)), start_first(fin, op, F.Client{}, max, List.append(&2, U32, List.append(&2, U32, F.header_with(None{}, U32.from_nat(F.length(payload))), payload), rest), ctl_final(op, fin, List.length(&2, U32, payload), cv))),
    Equal.cong(F.Decoded, F.Decoded, d => F.settle(d), F.read_second(F.Client{}, max, fin, op, List.append(&2, U32, List.append(&2, U32, F.header_with(None{}, U32.from_nat(F.length(payload))), payload), rest)), F.Got{F.Frame{fin, op, payload}, None{}, rest}, header_u(fin, op, max, payload, rest, U32.from_nat(F.length(payload)), fits, len, UP.and_right((S.control_valid(op, fin, List.length(&2, U32, payload)) && Nat.is_le(List.length(&2, U32, payload), U32.to_nat(max))) && True{}, S.octets(payload), ok), cv)))

# Masking keeps octets octets.

def ones(n: Nat) -> Word(n):
  match n:
    case 0n:
      WNil{}
    case 1n+p:
      WCon{True{}, ones(p)}

def fin_le_true(+c: Cmp, +a: Bool, e: {Cmp.is_le(c) == True{} : Bool}) -> {Cmp.is_le(Word.cmp.fin(a, True{}, c)) == True{} : Bool}:
  match c a:
    case LT{} _:
      {==}
    case EQ{} False{}:
      {==}
    case EQ{} True{}:
      {==}
    case GT{} _:
      e

def cmp_le_ones(+n: Nat, +w: Word(n)) -> {Cmp.is_le(Word.cmp(n, w, ones(n))) == True{} : Bool}:
  match n:
    case 0n:
      match w:
        case WNil{}:
          {==}
    case 1n+p:
      match w:
        case WCon{a, t}:
          fin_le_true(Word.cmp(p, t, ones(p)), a, cmp_le_ones(p, t))

def low_octet(+w: Word(32n), e: {U32.is_le(U32{w}, 255) == True{} : Bool}) -> {Utf8.high(8n, 24n, w) == Word.zero(24n) : Word(24n)}:
  UP.cmp_le_zero(24n, Utf8.high(8n, 24n, w), UP.high_le(8n, 24n, w, UP.bits(255), e))

def xor_octet_bits(+x0: Bool, +x1: Bool, +x2: Bool, +x3: Bool, +x4: Bool, +x5: Bool, +x6: Bool, +x7: Bool, +k0: Bool, +k1: Bool, +k2: Bool, +k3: Bool, +k4: Bool, +k5: Bool, +k6: Bool, +k7: Bool, +hx: Word(24n), +hk: Word(24n), ex: {hx == Word.zero(24n) : Word(24n)}, ek: {hk == Word.zero(24n) : Word(24n)}) -> {U32.is_le(U32.xor(U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, hx}}}}}}}}}, U32{WCon{k0, WCon{k1, WCon{k2, WCon{k3, WCon{k4, WCon{k5, WCon{k6, WCon{k7, hk}}}}}}}}}), 255) == True{} : Bool}:
  %Equal.sym(Word(24n), hx, Word.zero(24n), ex) : {U32.is_le(U32.xor(U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, _}}}}}}}}}, U32{WCon{k0, WCon{k1, WCon{k2, WCon{k3, WCon{k4, WCon{k5, WCon{k6, WCon{k7, hk}}}}}}}}}), 255) == True{} : Bool}
  %Equal.sym(Word(24n), hk, Word.zero(24n), ek) : {U32.is_le(U32.xor(U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, Word.zero(24n)}}}}}}}}}, U32{WCon{k0, WCon{k1, WCon{k2, WCon{k3, WCon{k4, WCon{k5, WCon{k6, WCon{k7, _}}}}}}}}}), 255) == True{} : Bool}
  cmp_le_ones(8n, WCon{Bool.xor(x0, k0), WCon{Bool.xor(x1, k1), WCon{Bool.xor(x2, k2), WCon{Bool.xor(x3, k3), WCon{Bool.xor(x4, k4), WCon{Bool.xor(x5, k5), WCon{Bool.xor(x6, k6), WCon{Bool.xor(x7, k7), WNil{}}}}}}}}})

def xor_octet(+x: U32, +k: U32, ox: {(x <= 255 : U32) == True{} : Bool}, ok: {(k <= 255 : U32) == True{} : Bool}) -> {(U32.xor(x, k) <= 255 : U32) == True{} : Bool}:
  match x k:
    case U32{WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, hx}}}}}}}}} U32{WCon{k0, WCon{k1, WCon{k2, WCon{k3, WCon{k4, WCon{k5, WCon{k6, WCon{k7, hk}}}}}}}}}:
      xor_octet_bits(x0, x1, x2, x3, x4, x5, x6, x7, k0, k1, k2, k3, k4, k5, k6, k7, hx, hk, low_octet(WCon{x0, WCon{x1, WCon{x2, WCon{x3, WCon{x4, WCon{x5, WCon{x6, WCon{x7, hx}}}}}}}}, ox), low_octet(WCon{k0, WCon{k1, WCon{k2, WCon{k3, WCon{k4, WCon{k5, WCon{k6, WCon{k7, hk}}}}}}}}, ok))

def octets_mask(+p: List<&2, U32>, +a: U32, +b: U32, +c: U32, +d: U32, +ok: Bool, +op: {S.octets(p) == True{} : Bool}, +oa: {(a <= 255 : U32) == True{} : Bool}, +ob: {(b <= 255 : U32) == True{} : Bool}, +oc: {(c <= 255 : U32) == True{} : Bool}, +od: {(d <= 255 : U32) == True{} : Bool}) -> {F.octets(S.mask(p, F.MaskKey{a, b, c, d}), ok) == ok : Bool}:
  match p:
    case Nil{}:
      {==}
    case x <> t:
      +ox = UP.and_left((x <= 255 : U32), S.octets(t), op)
      %Equal.sym(Bool, F.is_octet(U32.xor(x, a)), True{}, xor_octet(x, a, ox, oa)) : {F.octets(S.mask(t, F.MaskKey{b, c, d, a}), ok && _) == ok : Bool}
      %Equal.sym(Bool, ok && True{}, ok, OP.and_true(ok)) : {F.octets(S.mask(t, F.MaskKey{b, c, d, a}), _) == ok : Bool}
      octets_mask(t, b, c, d, a, ok, UP.and_right((x <= 255 : U32), S.octets(t), op), ob, oc, od, oa)

# The key bytes, then a masked payload of exactly `u` octets.
def key_body(+fin: Bool, +op: F.Opcode, +u: U32, +p: List<&2, U32>, +rest: List<&2, U32>, +a: U32, +b: U32, +c: U32, +d: U32, len: {U32.to_nat(u) == List.length(&2, U32, p) : Nat}, +oct: {S.octets(p) == True{} : Bool}, +oa: {(a <= 255 : U32) == True{} : Bool}, +ob: {(b <= 255 : U32) == True{} : Bool}, +oc: {(c <= 255 : U32) == True{} : Bool}, +od: {(d <= 255 : U32) == True{} : Bool}) -> {F.read_key(True{}, fin, op, u, a <> b <> c <> d <> List.append(&2, U32, S.mask(p, F.MaskKey{a, b, c, d}), rest)) == F.Got{F.Frame{fin, op, p}, Some{F.MaskKey{a, b, c, d}}, rest} : F.Decoded}:
  %Equal.sym(Bool, F.is_octet(a), True{}, oa) : {F.with_key(a, b, c, d, fin, op, u, List.append(&2, U32, S.mask(p, F.MaskKey{a, b, c, d}), rest), ((_ && F.is_octet(b)) && F.is_octet(c)) && F.is_octet(d)) == F.Got{F.Frame{fin, op, p}, Some{F.MaskKey{a, b, c, d}}, rest} : F.Decoded}
  %Equal.sym(Bool, F.is_octet(b), True{}, ob) : {F.with_key(a, b, c, d, fin, op, u, List.append(&2, U32, S.mask(p, F.MaskKey{a, b, c, d}), rest), (_ && F.is_octet(c)) && F.is_octet(d)) == F.Got{F.Frame{fin, op, p}, Some{F.MaskKey{a, b, c, d}}, rest} : F.Decoded}
  %Equal.sym(Bool, F.is_octet(c), True{}, oc) : {F.with_key(a, b, c, d, fin, op, u, List.append(&2, U32, S.mask(p, F.MaskKey{a, b, c, d}), rest), _ && F.is_octet(d)) == F.Got{F.Frame{fin, op, p}, Some{F.MaskKey{a, b, c, d}}, rest} : F.Decoded}
  %Equal.sym(Bool, F.is_octet(d), True{}, od) : {F.with_key(a, b, c, d, fin, op, u, List.append(&2, U32, S.mask(p, F.MaskKey{a, b, c, d}), rest), _) == F.Got{F.Frame{fin, op, p}, Some{F.MaskKey{a, b, c, d}}, rest} : F.Decoded}
  %Equal.sym(Nat, U32.to_nat(u), List.length(&2, U32, p), len) : {F.finish(fin, op, Some{F.MaskKey{a, b, c, d}}, F.take_mask(_, List.append(&2, U32, S.mask(p, F.MaskKey{a, b, c, d}), rest), a, b, c, d, [], True{})) == F.Got{F.Frame{fin, op, p}, Some{F.MaskKey{a, b, c, d}}, rest} : F.Decoded}
  %Equal.sym(F.Taken, F.take_mask(List.length(&2, U32, p), List.append(&2, U32, S.mask(p, F.MaskKey{a, b, c, d}), rest), a, b, c, d, [], True{}), F.Took{F.octets(S.mask(p, F.MaskKey{a, b, c, d}), True{}), List.reverse.go(&2, U32, S.mask(S.mask(p, F.MaskKey{a, b, c, d}), F.MaskKey{a, b, c, d}), []), rest}, take_mask_append(p, rest, a, b, c, d, [], True{})) : {F.finish(fin, op, Some{F.MaskKey{a, b, c, d}}, _) == F.Got{F.Frame{fin, op, p}, Some{F.MaskKey{a, b, c, d}}, rest} : F.Decoded}
  %Equal.sym(Bool, F.octets(S.mask(p, F.MaskKey{a, b, c, d}), True{}), True{}, octets_mask(p, a, b, c, d, True{}, oct, oa, ob, oc, od)) : {F.finish(fin, op, Some{F.MaskKey{a, b, c, d}}, F.Took{_, List.reverse.go(&2, U32, S.mask(S.mask(p, F.MaskKey{a, b, c, d}), F.MaskKey{a, b, c, d}), []), rest}) == F.Got{F.Frame{fin, op, p}, Some{F.MaskKey{a, b, c, d}}, rest} : F.Decoded}
  %Equal.sym(List<&2, U32>, S.mask(S.mask(p, F.MaskKey{a, b, c, d}), F.MaskKey{a, b, c, d}), p, P.spec_twice(p, F.MaskKey{a, b, c, d})) : {F.Got{F.Frame{fin, op, List.reverse(&2, U32, List.reverse(&2, U32, _))}, Some{F.MaskKey{a, b, c, d}}, rest} == F.Got{F.Frame{fin, op, p}, Some{F.MaskKey{a, b, c, d}}, rest} : F.Decoded}
  %Equal.sym(List<&2, U32>, List.reverse(&2, U32, List.reverse(&2, U32, p)), p, P.reverse_reverse(p)) : {F.Got{F.Frame{fin, op, _}, Some{F.MaskKey{a, b, c, d}}, rest} == F.Got{F.Frame{fin, op, p}, Some{F.MaskKey{a, b, c, d}}, rest} : F.Decoded}
  {==}


# Masked header stages.

def short_masked(+fin: Bool, +op: F.Opcode, +l0: Bool, +l1: Bool, +l2: Bool, +l3: Bool, +l4: Bool, +l5: Bool, +l6: Bool, +max: U32, +p: List<&2, U32>, +rest: List<&2, U32>, +a: U32, +b: U32, +c: U32, +d: U32, sh: {F.short7(WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}) == True{} : Bool}, fits: {U32.is_le(U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}}, max) == True{} : Bool}, len: {U32.to_nat(U32{WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, Word.zero(25n)}}}}}}}}) == List.length(&2, U32, p) : Nat}, +oct: {S.octets(p) == True{} : Bool}, +oa: {(a <= 255 : U32) == True{} : Bool}, +ob: {(b <= 255 : U32) == True{} : Bool}, +oc: {(c <= 255 : U32) == True{} : Bool}, +od: {(d <= 255 : U32) == True{} : Bool}) -> {F.read_second(F.Server{}, max, fin, op, F.second_byte(WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}, True{}) <> a <> b <> c <> d <> List.append(&2, U32, S.mask(p, F.MaskKey{a, b, c, d}), rest)) == F.Got{F.Frame{fin, op, p}, Some{F.MaskKey{a, b, c, d}}, rest} : F.Decoded}:
  %Equal.sym(Bool, F.short7(WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}), True{}, sh) : {F.length7(_, WCon{l0, WCon{l1, WCon{l2, WCon{l3, WCon{l4, WCon{l5, WCon{l6, WNil{}}}}}}}}, max, True{}, fin, op, a <> b <> c <> d <> List.append(&2, U32, S.mask(p, F.MaskKey{a, b, c, d}), rest)) == F.Got{F.Frame{fin, op, p}, Some{F.MaskKey{a, b, c, d}}, rest} : F.Decoded}
