# A forward specification of the writer's output. render_acc builds the
# same text reversed onto its accumulator; here it is written in reading
# order, so parser continuations can follow it left to right.
import Base
import ../src/data/json.bend as J
import ../src/data/utf8.bend as U
import ./utf8.bend as P
import ./json-tree.bend as T
import ./json-writer.bend as W
import ./json-escape.bend as E
import ./json-valid.bend as V
import ./json.bend as JP
import ./json-number-parse.bend as N
import ./json-quote-valid.bend as QV

def open_text(include: Bool, c: Char) -> String:
  match include:
    case True{}: SCon{c, ""}
    case False{}: ""

def text(capacity: Nat, value: J.Json, +include: Bool, +pretty: Bool, +ascii: Bool, depth: Nat, first: Bool) -> String:
  match capacity value:
    case _ J.JNull{}: "null"
    case _ J.JBool{True{}}: "true"
    case _ J.JBool{False{}}: "false"
    case _ J.JNumber{s}: s
    case _ J.JString{s}: J.quote(s, ascii)
    case 0n _: ""
    case 1n++r J.JArray{Nil{}}: open_text(include, '[') ++ J.close(W.initial(include, first), pretty, W.level(include, depth), ']')
    case 1n++r J.JArray{h <> t}:
      +d = W.level(include, depth)
      open_text(include, '[') ++ (J.prefix(W.initial(include, first), pretty, d) ++ (text(r, h, True{}, pretty, ascii, d, True{}) ++ text(1n+r, J.JArray{t}, False{}, pretty, ascii, d, False{})))
    case 1n++r J.JObject{Nil{}}: open_text(include, '{') ++ J.close(W.initial(include, first), pretty, W.level(include, depth), '}')
    case 1n++r J.JObject{J.Field{k, h} <> t}:
      +d = W.level(include, depth)
      open_text(include, '{') ++ (J.prefix(W.initial(include, first), pretty, d) ++ (J.quote(k, ascii) ++ (J.colon(pretty) ++ (text(r, h, True{}, pretty, ascii, d, True{}) ++ text(1n+r, J.JObject{t}, False{}, pretty, ascii, d, False{})))))

def rev_app(+x: String, +y: String, +rev: String) -> {String.reverse.go(x ++ y, rev) == String.reverse.go(y, String.reverse.go(x, rev)) : String}:
  match x:
    case SNil{}: {==}
    case SCon{c, t}: rev_app(t, y, SCon{c, rev})

def open_eq(+include: Bool, +c: Char, +rev: String) -> {W.open_rev(include, c, rev) == String.reverse.go(open_text(include, c), rev) : String}:
  match include:
    case True{}: {==}
    case False{}: {==}

