# Every character of the rendered text is a Unicode scalar.
def indent_valid(+n: Nat, +acc: String, ok: {U.valid(acc) == True{} : Bool}) -> {U.valid(J.indent(n, acc)) == True{} : Bool}:
  match n:
    case 0n: ok
    case 1n+p: indent_valid(p, SCon{' ', SCon{' ', acc}}, E.valid_cons(' ', SCon{' ', acc}, {==}, E.valid_cons(' ', acc, {==}, ok)))

def line_valid(+pretty: Bool, +depth: Nat) -> {U.valid(J.line(pretty, depth)) == True{} : Bool}:
  match pretty:
    case False{}: {==}
    case True{}: E.valid_cons('\n', J.indent(depth, ""), {==}, indent_valid(depth, "", {==}))

def prefix_valid(+first: Bool, +pretty: Bool, +depth: Nat) -> {U.valid(J.prefix(first, pretty, depth)) == True{} : Bool}:
  match first:
    case True{}: line_valid(pretty, depth)
    case False{}: E.valid_cons(',', J.line(pretty, depth), {==}, line_valid(pretty, depth))

def close_valid(+first: Bool, +pretty: Bool, +depth: Nat, +c: Char, +sc: {U.scalar(E.code(c)) == True{} : Bool}) -> {U.valid(J.close(first, pretty, depth, c)) == True{} : Bool}:
  match first depth:
    case True{} _: E.valid_cons(c, "", sc, {==})
    case False{} 0n: E.valid_cons(c, "", sc, {==})
    case False{} 1n+d: V.valid_cat(J.line(pretty, d), Char.show(c), line_valid(pretty, d), E.valid_cons(c, "", sc, {==}))

def open_valid(+include: Bool, +c: Char, +sc: {U.scalar(E.code(c)) == True{} : Bool}) -> {U.valid(open_text(include, c)) == True{} : Bool}:
  match include:
    case True{}: E.valid_cons(c, "", sc, {==})
    case False{}: {==}

def colon_valid(+pretty: Bool) -> {U.valid(J.colon(pretty)) == True{} : Bool}:
  match pretty:
    case True{}: {==}
    case False{}: {==}

def string_valid(+s: String, +ascii: Bool, +good: {J.scalars(s) == True{} : Bool}) -> {U.valid(J.quote(s, ascii)) == True{} : Bool}:
  QV.quote_valid(s, ascii, Equal.trans(Bool, U.valid(s), J.scalars(s), True{}, Equal.sym(Bool, J.scalars(s), U.valid(s), JP.scalars_equiv(s)), good))

