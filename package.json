{
  "name": "bendo-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/chat",
    "examples/todo"
  ],
  "scripts": {
    "test:shards": "bun scripts/test-shards.ts",
    "check:bend": "sh scripts/check-bend-version.sh",
    "prove": "bend PROOF.bend --verdict",
    "test": "timeout 10m sh -c 'bun scripts/compile-fixtures.ts && bun scripts/run-tests.ts'",
    "test:ci": "timeout 20m sh -c 'bun scripts/compile-fixtures.ts && bun scripts/run-tests.ts'",
    "check:static": "bun run check:bend && bun run prove && bun run lint && bun run format:check && bun run typecheck && bun run typecheck:bench",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:bench": "bun install --cwd bench/servers --frozen-lockfile && tsc -p bench/tsconfig.json",
    "check": "bun run check:static && bun run check:docs && bun run test",
    "check:docs": "bun install --cwd docs --frozen-lockfile && tsc -p docs/tsconfig.json && bun run docs:build",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build",
    "docs:preview": "bun run --cwd docs preview",
    "lint": "oxlint --threads=4 --deny-warnings .",
    "format": "oxfmt --threads=4 .",
    "format:check": "oxfmt --threads=4 --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@types/bun": "latest",
    "ajv": "^8.17.1",
    "jose": "^6.2.13",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "^5.9.0"
  }
}
