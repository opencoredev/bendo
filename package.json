{
  "name": "bendo-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:shards": "bun scripts/test-shards.ts",
    "check:bend": "sh scripts/check-bend-version.sh",
    "prove": "bend PROOF.bend --verdict",
    "test": "timeout 10m sh -c 'bun scripts/compile-fixtures.ts && bun scripts/run-tests.ts'",
    "test:ci": "timeout 20m sh -c 'bun scripts/compile-fixtures.ts && bun scripts/run-tests.ts'",
    "check:static": "bun run check:bend && bun run prove && bun run lint && bun run format:check && bun run typecheck && bun run typecheck:bench",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:bench": "bun install --cwd bench/servers --frozen-lockfile && tsc -p bench/tsconfig.json",
    "check": "bun run check:static && bun run test",
    "lint": "oxlint --threads=4 --deny-warnings .",
    "format": "oxfmt --threads=4 .",
    "format:check": "oxfmt --threads=4 --check ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "ajv": "^8.17.1",
    "jose": "^6.2.13",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "^5.9.0"
  }
}
