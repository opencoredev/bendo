# The tail check on a located segment is misplaced.
def tail_inv(p: P.Segment, +rest: List<&2, String>) ->
    {P.invalid_tail(P.located(p, rest), rest) == misplaced(P.located(p, rest), rest) : Bool}:
  match p:
    case P.Wildcard{m}:
      wild_inv(m, rest)
    case P.Static{raw}:
      {==}
    case P.Capture{name, c, True{}}:
      {==}
    case P.Capture{name, c, False{}}:
      {==}
    case P.InteriorWildcard{}:
      {==}
    case P.PrefixWildcard{x}:
      {==}
    case P.Span{name}:
      {==}

def top_step(+h: Char, +t: String, b: Bool,
    bodies: @u: String -> {S.accepted(P.compile_body(u)) == S.body(u) : Maybe<&2, P.Pattern>}) ->
    {S.accepted(E.choose(Result<&2, &2, P.PatternError, P.Pattern>, b, u => P.compile_body(t), u => Fail{P.PatternError{P.MissingSlash{}, SCon{h, t}}})) == S.slash(b, t) : Maybe<&2, P.Pattern>}:
  match b:
    case True{}:
      bodies(t)
    case False{}:
      {==}

# Given the body law, the whole compiler is the spec, bare `*` included.
def top(src: String, bodies: @u: String -> {S.accepted(P.compile_body(u)) == S.body(u) : Maybe<&2, P.Pattern>}) ->
    {S.accepted(P.compile(src)) == S.compile(src) : Maybe<&2, P.Pattern>}:
  match src:
    case SNil{}:
      {==}
    case "*":
      bodies("*")
    case SCon{'*', SCon{+h, +t}}:
      {==}
    case SCon{Chr{U32{WCon{False{}, WCon{False{}, +w}}}}, +t}:
      top_step(Chr{U32{WCon{False{}, WCon{False{}, w}}}}, t, Char.is_eq(Chr{U32{WCon{False{}, WCon{False{}, w}}}}, '/'), bodies)
    case SCon{Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, +w}}}}}}, +t}:
      top_step(Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, w}}}}}}, t, Char.is_eq(Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, w}}}}}}, '/'), bodies)
    case SCon{Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, +w}}}}}}}}, +t}:
      top_step(Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, w}}}}}}}}, t, Char.is_eq(Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, w}}}}}}}}, '/'), bodies)
    case SCon{Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, +w}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, +t}:
      top_step(Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, w}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, t, Char.is_eq(Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, w}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, '/'), bodies)
    case SCon{Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, +w}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, +t}:
      top_step(Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, w}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, t, Char.is_eq(Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, w}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, '/'), bodies)
    case SCon{Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, +w}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, +t}:
