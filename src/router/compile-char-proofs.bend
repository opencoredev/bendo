    case "*" Nil{}:
      {==}
    case "*" h <> t:
      {==}
    case SCon{'*', SCon{h, u}} r:
      {==}
    case SCon{Chr{U32{WCon{False{}, WCon{False{}, +w}}}}, u} r:
      {==}
    case SCon{Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, +w}}}}}}, u} r:
