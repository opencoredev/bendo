# A valid name is never the bare `*`, so locating it keeps the wildcard.
def located_named(t: String, +rest: List<&2, String>, ok: {P.name_ok(t) == True{} : Bool}) ->
    {P.located(P.Wildcard{t}, rest) == P.Wildcard{t} : P.Segment}:
  match t:
    case SNil{}:
      Bits.absurd({P.located(P.Wildcard{""}, rest) == P.Wildcard{""} : P.Segment}, Bits.false_true(ok))
    case "*":
      Bits.absurd({P.located(P.Wildcard{"*"}, rest) == P.Wildcard{"*"} : P.Segment}, Bits.false_true(ok))
    case SCon{'*', SCon{+h, +u}}:
      Bits.absurd({P.located(P.Wildcard{SCon{'*', SCon{h, u}}}, rest) == P.Wildcard{SCon{'*', SCon{h, u}}} : P.Segment}, Bits.false_true(ok))
    case SCon{Chr{U32{WCon{False{}, WCon{False{}, +w}}}}, u}:
      {==}
    case SCon{Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, +w}}}}}}, u}:
      {==}
    case SCon{Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, +w}}}}}}}}, u}:
      {==}
    case SCon{Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, +w}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, u}:
      {==}
    case SCon{Chr{U32{WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, +w}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, u}:
