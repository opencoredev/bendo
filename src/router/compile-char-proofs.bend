# The cut loses nothing: name ++ suffix is the source.
def cut_whole(s: String) -> {whole(S.cut(s)) == s : String}:
  match s:
    case SNil{}:
      {==}
    case SCon{'{', t}:
      {==}
    case SCon{'?', t}:
      {==}
    case SCon{Chr{U32{WCon{False{}, +w}}}, +t}:
      whole_step(Chr{U32{WCon{False{}, w}}}, t, cut_whole(t))
    case SCon{Chr{U32{WCon{True{}, WCon{False{}, +w}}}}, +t}:
      whole_step(Chr{U32{WCon{True{}, WCon{False{}, w}}}}, t, cut_whole(t))
    case SCon{Chr{U32{WCon{True{}, WCon{True{}, WCon{False{}, WCon{False{}, +w}}}}}}, +t}:
